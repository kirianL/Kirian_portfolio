---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import PostHog from '../components/PostHog.astro';
import {
  absoluteUrl,
  defaultBreadcrumbs,
  organizationSchema,
  personSchema,
  resolveAlternates,
  websiteSchema,
  PERSON_ID,
  WEBSITE_ID,
  withTrailingSlash,
  type BreadcrumbItem,
} from '../lib/seo';

type PageType =
  | 'WebPage'
  | 'ProfilePage'
  | 'AboutPage'
  | 'CollectionPage'
  | 'ContactPage';

interface Props {
  title: string;
  description: string;
  lang?: string;
  image?: string;
  loadSerifFonts?: boolean;
  /** Explicit hreflang pair for pages whose slugs differ per language. */
  alternates?: { en?: string; es?: string };
  /** Primary schema.org type for this page. */
  pageType?: PageType;
  /** Extra JSON-LD nodes (BlogPosting, ItemList, Service…). */
  schema?: Record<string, any> | Array<Record<string, any>>;
  /** @id of the node this page is about. Defaults to the Person node. */
  mainEntityId?: string;
  breadcrumbs?: BreadcrumbItem[];
  ogType?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  modifiedTime?: string;
  articleSection?: string;
  noindex?: boolean;
  /** Link to the Markdown version of this page, when one exists. */
  markdownAlternate?: string;
}

const {
  title,
  description,
  lang = 'es',
  image = '/OG/KirianLunaOG.png',
  loadSerifFonts = false,
  alternates,
  pageType = 'WebPage',
  schema,
  mainEntityId = PERSON_ID,
  breadcrumbs,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  articleSection,
  noindex = false,
  markdownAlternate,
} = Astro.props;

let requestHost = '';
if (!Astro.isPrerendered) {
  try {
    requestHost =
      Astro.request.headers.get('x-forwarded-host') ||
      Astro.request.headers.get('host') ||
      '';
  } catch {}
}
const cleanHost = requestHost.split(',')[0].trim().split(':')[0];
const isKnownHost = cleanHost === 'kirian.dev' || cleanHost === 'www.kirian.dev';
const siteURL = isKnownHost
  ? new URL(`https://${cleanHost}`)
  : (Astro.site || new URL(Astro.url.origin));
const canonicalPath = withTrailingSlash(Astro.url.pathname || '/');
const canonicalURL = new URL(canonicalPath, siteURL);
const resolvedImageURL = new URL(image, siteURL);
const imageType = image.endsWith('.jpg') || image.endsWith('.jpeg') ? 'image/jpeg' : image.endsWith('.webp') ? 'image/webp' : 'image/png';

// Dynamic i18n hreflang URLs. Blog posts use translated slugs, so resolve
// the known pairs first; a post that only exists in one language must not
// advertise a counterpart URL that would 404.
const autoAlternates = resolveAlternates(Astro.url.pathname);

const englishPath = alternates?.en ?? autoAlternates.en;
const spanishPath = alternates?.es ?? autoAlternates.es;

const englishURL = englishPath ? new URL(withTrailingSlash(englishPath), siteURL) : undefined;
const spanishURL = spanishPath ? new URL(withTrailingSlash(spanishPath), siteURL) : undefined;
const defaultURL = englishURL ?? spanishURL;

const resolvedBreadcrumbs =
  breadcrumbs ?? defaultBreadcrumbs(Astro.url.pathname, lang === 'es' ? 'es' : 'en');

const breadcrumbSchema =
  resolvedBreadcrumbs.length > 0
    ? {
        '@type': 'BreadcrumbList',
        '@id': `${canonicalURL.href}#breadcrumb`,
        itemListElement: resolvedBreadcrumbs.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.name,
          item: absoluteUrl(item.path),
        })),
      }
    : null;

const pageSchema = {
  '@type': pageType,
  '@id': `${canonicalURL.href}#webpage`,
  url: canonicalURL.href,
  name: title,
  description,
  isPartOf: { '@id': WEBSITE_ID },
  mainEntity: { '@id': mainEntityId },
  inLanguage: lang === 'es' ? 'es' : 'en',
  ...(breadcrumbSchema ? { breadcrumb: { '@id': breadcrumbSchema['@id'] } } : {}),
};

const extraSchemas = Array.isArray(schema) ? schema : schema ? [schema] : [];

const structuredData = [
  personSchema,
  websiteSchema,
  pageSchema,
  organizationSchema,
  ...extraSchemas,
  ...(breadcrumbSchema ? [breadcrumbSchema] : []),
];

const fontsHref = loadSerifFonts
  ? "https://fonts.googleapis.com/css2?family=Inter:wght@400..600&family=IBM+Plex+Mono:wght@400;500;600&family=Caveat:wght@500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400;1,6..72,500&family=Instrument+Serif:ital@0;1&display=swap"
  : "https://fonts.googleapis.com/css2?family=Inter:wght@400..600&family=IBM+Plex+Mono:wght@400;500;600&family=Caveat:wght@500;600&display=swap";
---

<!doctype html>
<html lang={lang} data-grayscale="slate" data-accent="blue">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#ffffff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#111113"
    />
    <!-- Immediate Zero-FOUC Theme Initializer (Runs before render) -->
    <script is:inline>
      (function () {
        function applyTheme(doc) {
          if (!doc || !doc.documentElement) return;
          var saved = localStorage.getItem("theme");
          var prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          var isDark = saved ? saved === "dark" : prefersDark;

          doc.documentElement.classList.toggle("dark", isDark);
          doc.documentElement.style.colorScheme = isDark ? "dark" : "light";
          doc.documentElement.style.backgroundColor = isDark ? "#111113" : "#ffffff";
        }

        // Apply immediately
        applyTheme(document);

        // Apply on incoming document before swap
        document.addEventListener("astro:before-swap", function (e) {
          if (e.newDocument) {
            applyTheme(e.newDocument);
          }
        });

        // Sync again after swap
        document.addEventListener("astro:after-swap", function () {
          applyTheme(document);
        });
      })();
    </script>

    <!-- Favicons & Manifest -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180x180.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <ClientRouter />

    <script is:inline>
      (function () {
        if (window.__blogVtInit) return;
        window.__blogVtInit = true;

        let activeSlug = null;

        function clearVtNames(doc) {
          doc.querySelectorAll("[data-blog-cover], [data-blog-hero-cover]").forEach(function (el) {
            el.style.viewTransitionName = "";
          });
        }

        function getBlogSlug(pathname) {
          const match = pathname.match(/^\/(?:es\/)?blog\/([^/]+)\/?$/);
          return match ? match[1] : null;
        }

        function isBlogIndex(pathname) {
          return /^\/(?:es\/)?blog\/?$/.test(pathname);
        }

        document.addEventListener("astro:before-preparation", function (e) {
          var bar = document.getElementById("nav-progress");
          if (bar) {
            bar.removeAttribute("data-state");
            void bar.offsetWidth;
            bar.setAttribute("data-state", "loading");
          }

          // Pause Lenis during transition so momentum doesn't fight snapshot capture
          if (window.__lenis && typeof window.__lenis.stop === "function") {
            window.__lenis.stop();
          }

          activeSlug = null;
          clearVtNames(document);

          const fromPath = window.location.pathname;
          const toPath = e.to && e.to.pathname ? e.to.pathname : "";

          // Save /blog scroll position when opening an article so returning feels native
          if (isBlogIndex(fromPath) && getBlogSlug(toPath)) {
            try {
              sessionStorage.setItem("portfolio_blog_scroll", String(window.scrollY || 0));
            } catch {}
          }

          // Shared-element cover morph on desktop (>= 640px) only;
          // mobile uses a clean cross-fade to avoid off-screen clipping/white gaps.
          if (window.innerWidth < 640) return;

          // Index -> Article
          if (isBlogIndex(fromPath)) {
            const targetSlug = getBlogSlug(toPath);
            if (targetSlug) {
              const cardCover = document.querySelector('[data-blog-cover="' + targetSlug + '"]');
              if (cardCover) {
                cardCover.style.viewTransitionName = "blog-cover-active";
                activeSlug = targetSlug;
              }
            }
            return;
          }

          // Article -> Index
          if (isBlogIndex(toPath)) {
            const heroCover = document.querySelector("[data-blog-hero-cover]");
            if (heroCover) {
              const currentSlug = heroCover.getAttribute("data-blog-hero-cover");
              if (currentSlug) {
                heroCover.style.viewTransitionName = "blog-cover-active";
                activeSlug = currentSlug;
              }
            }
          }
        });

        document.addEventListener("astro:before-swap", function (e) {
          if (!activeSlug || !e.newDocument) return;
          clearVtNames(e.newDocument);

          const target =
            e.newDocument.querySelector('[data-blog-hero-cover="' + activeSlug + '"]') ||
            e.newDocument.querySelector('[data-blog-cover="' + activeSlug + '"]');

          if (target) {
            target.style.viewTransitionName = "blog-cover-active";
          }
        });

        document.addEventListener("astro:page-load", function () {
          var bar = document.getElementById("nav-progress");
          if (bar && bar.getAttribute("data-state") === "loading") {
            bar.setAttribute("data-state", "done");
          }
          if (window.__lenis && typeof window.__lenis.start === "function") {
            window.__lenis.start();
          }
          activeSlug = null;
          clearVtNames(document);
        });
      })();
    </script>

    <!-- Performance & Preconnect (Zero-CLS Font Loading) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="https://fonts.gstatic.com/s/inter/v20/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7W0Q5nw.woff2"
      crossorigin
    />
    <link rel="stylesheet" href={fontsHref} />
    <link rel="dns-prefetch" href="https://api.lanyard.rest" />
    <link rel="dns-prefetch" href="https://i.scdn.co" />

    <!-- Core SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Kirian Luna" />
    <meta name="publisher" content="Kirian Luna" />
    <meta name="keywords" content="Kirian Luna, Ingeniero de Software, Software Engineer, Full-Stack Developer, Web Developer Costa Rica, Next.js, React, Astro, TypeScript, PostgreSQL, Prisma, Sorin Labs" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />

    <!-- Canonical & i18n Hreflang & RSS Feed -->
    <link rel="canonical" href={canonicalURL} />
    {englishURL && <link rel="alternate" hreflang="en" href={englishURL} />}
    {spanishURL && <link rel="alternate" hreflang="es" href={spanishURL} />}
    {defaultURL && <link rel="alternate" hreflang="x-default" href={defaultURL} />}
    <link rel="alternate" type="application/rss+xml" title="Kirian Luna Blog RSS" href={new URL(lang === 'es' ? '/es/rss.xml' : '/rss.xml', siteURL)} />
    {markdownAlternate && (
      <link rel="alternate" type="text/markdown" title={`${title} (Markdown)`} href={new URL(markdownAlternate, siteURL)} />
    )}
    <!-- LLM / agent entry points -->
    <link rel="alternate" type="text/markdown" title="Kirian Luna — LLM profile (llms.txt)" href={new URL('/llms.txt', siteURL)} />
    <link rel="alternate" type="text/markdown" title="Kirian Luna — Full LLM profile (llms-full.txt)" href={new URL('/llms-full.txt', siteURL)} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href={new URL('/sitemap-index.xml', siteURL)} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Kirian Luna" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImageURL} />
    <meta property="og:image:secure_url" content={resolvedImageURL} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {articleSection && <meta property="article:section" content={articleSection} />}
    <meta property="article:author" content="Kirian Luna" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImageURL} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="twitter:site" content="@kiriandev" />
    <meta name="twitter:creator" content="@kiriandev" />

    <!-- Structured Data JSON-LD: Person + WebSite + Page + Organization + extras -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(
        structuredData.map((node) => ({ "@context": "https://schema.org", ...node }))
      )}
    />
    
    <PostHog />
  </head>
  <body class="antialiased selection:bg-accent-4/20 selection:text-accent-12 bg-grayscale-1 text-grayscale-12">
    <!-- Accessibility: Skip to Main Content Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-grayscale-12 focus:text-grayscale-1 focus:rounded-lg focus:shadow-md focus:text-xs focus:font-mono focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-9 focus-visible:ring-offset-2"
    >
      {lang === 'es' ? 'Saltar al contenido principal' : 'Skip to main content'}
    </a>

    <div id="nav-progress" aria-hidden="true" transition:persist="nav-progress"></div>
    <slot />

    <!-- cuelume interaction sounds & audio engine -->
    <script>
      import { bind, setVolume } from "cuelume";

      // Boost volume so subtle ticks, clicks, and page transitions are clearly audible
      try {
        setVolume(1.6);
      } catch {}

      // Bind all declarative data-cuelume-* attributes across the entire document
      const initCuelume = () => {
        try {
          bind(document);
        } catch {}
      };

      initCuelume();
      document.addEventListener("astro:page-load", initCuelume);

      const initCrLocationHover = () => {
        if (window.matchMedia?.("(prefers-reduced-motion: reduce)").matches) return;
        document.querySelectorAll<HTMLElement>(".cr-location-badge").forEach((el) => {
          if ((el as any).__crBound) return;
          (el as any).__crBound = true;
          el.addEventListener("pointermove", (e) => {
            if (e.pointerType !== "mouse" && e.pointerType !== "pen") return;
            const rect = el.getBoundingClientRect();
            if (!rect.width) return;
            const pct = Math.max(0, Math.min(100, ((e.clientX - rect.left) / rect.width) * 100));
            el.style.setProperty("--cr-x", `${pct.toFixed(1)}%`);
          });
        });
      };

      initCrLocationHover();
      document.addEventListener("astro:page-load", initCrLocationHover);

      if (!(window as any).__expMetaScrollBound) {
        (window as any).__expMetaScrollBound = true;
        document.addEventListener("click", (e) => {
          const target = e.target;
          if (!(target instanceof Element)) return;
          const expBtn = target.closest("[data-exp-meta-btn]");
          if (expBtn) {
            const section = document.getElementById("experiencia");
            if (section) {
              section.scrollIntoView({ behavior: "smooth", block: "start" });
              const firstFolder = section.querySelector('.minimal-folder-item[data-open="false"] .folder-trigger-btn');
              if (firstFolder instanceof HTMLElement) {
                firstFolder.click();
              }
            }
          }
        });
      }
    </script>

    <!-- Lenis Smooth Scroll Engine -->
    <script>
      import Lenis from "lenis";

      // Manual scroll restoration: we manage scroll ourselves via Lenis on
      // every navigation. The browser's default history scroll restoration
      // fights with the view-transition snapshot capture and causes visible
      // image flicker/jumps when navigating back to a page (e.g. /blog).
      if ("scrollRestoration" in window.history) {
        window.history.scrollRestoration = "manual";
      }

      let lenis: Lenis | null = null;
      let rafId: number | null = null;

      const initLenis = () => {
        if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          if (rafId !== null) {
            cancelAnimationFrame(rafId);
            rafId = null;
          }
          if (lenis) {
            lenis.destroy();
            lenis = null;
            (window as any).__lenis = null;
          }
          return;
        }

        if (lenis) {
          lenis.resize();
          return;
        }

        lenis = new Lenis({
          duration: 1.0,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: "vertical",
          gestureOrientation: "vertical",
          smoothWheel: true,
          syncTouch: false,
        });

        (window as any).__lenis = lenis;

        function raf(time: number) {
          lenis?.raf(time);
          rafId = requestAnimationFrame(raf);
        }

        rafId = requestAnimationFrame(raf);
      };

      initLenis();
      document.addEventListener("astro:page-load", initLenis);

      // Instant scroll reset on page transition without jarring smooth lerp
      document.addEventListener("astro:after-swap", () => {
        const savedScroll = sessionStorage.getItem("portfolio_lang_scroll");
        if (savedScroll !== null) {
          const targetY = parseInt(savedScroll, 10);
          if (lenis) {
            lenis.scrollTo(targetY, { immediate: true });
          }
          window.scrollTo({ top: targetY, left: 0, behavior: "instant" });
          return;
        }

        const isBlogIndexPath = /^\/(?:es\/)?blog\/?$/.test(window.location.pathname);
        const savedBlogScroll = isBlogIndexPath ? sessionStorage.getItem("portfolio_blog_scroll") : null;
        if (savedBlogScroll !== null) {
          sessionStorage.removeItem("portfolio_blog_scroll");
          const targetY = parseInt(savedBlogScroll, 10) || 0;
          if (lenis) {
            lenis.scrollTo(targetY, { immediate: true });
          }
          window.scrollTo({ top: targetY, left: 0, behavior: "instant" });
          return;
        }

        if (lenis) {
          lenis.scrollTo(0, { immediate: true });
        }
        window.scrollTo({ top: 0, left: 0, behavior: "instant" });
      });
    </script>
  </body>
</html>
