---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  lang?: string;
  image?: string;
}

const { title, description, lang = 'es', image = '/OG/KirianLunaOG.png' } = Astro.props;

const siteURL = Astro.site || new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const resolvedImageURL = new URL(image, siteURL);
const imageType = image.endsWith('.jpg') || image.endsWith('.jpeg') ? 'image/jpeg' : image.endsWith('.webp') ? 'image/webp' : 'image/png';

// Dynamic i18n hreflang URLs
const currentPath = Astro.url.pathname;
const cleanPath = currentPath.replace(/^\/es(\/|$)/, '/');
const englishPath = cleanPath;
const spanishPath = cleanPath === '/' ? '/es/' : `/es${cleanPath.endsWith('/') ? cleanPath.slice(0, -1) : cleanPath}`;

const englishURL = new URL(englishPath, siteURL);
const spanishURL = new URL(spanishPath, siteURL);
---

<!doctype html>
<html lang={lang} data-grayscale="slate" data-accent="violet">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Favicons & Manifest -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180x180.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#18181b" />
    <meta name="generator" content={Astro.generator} />

    <!-- Immediate Zero-FOUC Dark Mode Initializer -->
    <script is:inline>
      (function () {
        const theme = localStorage.getItem("theme");
        if (
          theme === "dark" ||
          (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)
        ) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
    <script>
      const syncTheme = () => {
        const theme = localStorage.getItem("theme");
        if (
          theme === "dark" ||
          (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)
        ) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      };

      document.addEventListener("astro:after-swap", syncTheme);
    </script>

    <!-- Performance & Preconnect (SXO) -->
    <link rel="dns-prefetch" href="https://cloud.umami.is" />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Core SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Kirian Luna Quirós" />
    <meta name="publisher" content="Kirian Luna Quirós" />
    <meta name="keywords" content="Kirian Luna Quirós, Kirian Luna, Full Stack Engineer, Software Engineer, Web Developer Costa Rica, Next.js, React, Astro, TypeScript, Product Designer, SorinLabs" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Canonical & i18n Hreflang & RSS Feed (SEO / AEO) -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={englishURL} />
    <link rel="alternate" hreflang="es" href={spanishURL} />
    <link rel="alternate" hreflang="x-default" href={englishURL} />
    <link rel="alternate" type="application/rss+xml" title="Kirian Luna Quirós Blog RSS" href={new URL(lang === 'es' ? '/es/rss.xml' : '/rss.xml', siteURL)} />

    <!-- Open Graph / Facebook (SEO / SXO) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kirian Luna Quirós" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImageURL} />
    <meta property="og:image:secure_url" content={resolvedImageURL} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />

    <!-- Twitter / X Cards (SEO / GEO) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImageURL} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="twitter:creator" content="@kirianluna" />

    <!-- Structured Data JSON-LD Schemas (AEO / GEO / AIO / Entity Graph) -->
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "@id": "https://kirian.dev/#person",
        "name": "Kirian Luna Quirós",
        "givenName": "Kirian",
        "familyName": "Luna Quirós",
        "url": "https://kirian.dev",
        "image": new URL('/ProfileKirian.jpg', siteURL).href,
        "jobTitle": "Full Stack Software Engineer & Product Designer",
        "worksFor": {
          "@type": "Organization",
          "name": "SorinLabs"
        },
        "sameAs": [
          "https://github.com/kirianL",
          "https://linkedin.com/in/kirianluna"
        ],
        "knowsAbout": [
          "Full Stack Software Engineering",
          "TypeScript",
          "React",
          "Next.js",
          "Astro",
          "PostgreSQL",
          "Prisma ORM",
          "Node.js",
          "TailwindCSS",
          "UI/UX Design",
          "Search Engine Optimization (SEO)",
          "Search eXperience Optimization (SXO)"
        ],
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "Costa Rica"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://kirian.dev/#website",
        "url": "https://kirian.dev",
        "name": "Kirian Luna Quirós Portfolio",
        "description": "Official portfolio of Kirian Luna Quirós, Full Stack Software Engineer & Product Designer based in Costa Rica.",
        "publisher": {
          "@id": "https://kirian.dev/#person"
        },
        "inLanguage": ["en", "es"]
      },
      {
        "@context": "https://schema.org",
        "@type": "ProfilePage",
        "@id": `${canonicalURL.href}#webpage`,
        "url": canonicalURL.href,
        "name": title,
        "description": description,
        "isPartOf": {
          "@id": "https://kirian.dev/#website"
        },
        "mainEntity": {
          "@id": "https://kirian.dev/#person"
        }
      }
    ])} />
    
    <!-- View Transitions Router -->
    <ClientRouter />

    <!-- Umami Analytics -->
    <script defer src="https://cloud.umami.is/script.js" data-website-id="427114d6-abc8-410e-adb2-98cc7571b5d3"></script>
  </head>
  <body class="antialiased selection:bg-accent-4/20 selection:text-accent-12 min-h-screen bg-grayscale-1 text-grayscale-12">
    <slot />

    <!-- cuelume interaction sounds & audio unlocker -->
    <script>
      import { bind } from "cuelume";

      let isUnlocked = false;

      const setupAudioUnlock = () => {
        bind();
        if (isUnlocked) return;

        const unlockEvents = ["pointerdown", "touchstart", "keydown", "pointermove", "scroll"];
        
        const unlock = () => {
          isUnlocked = true;
          unlockEvents.forEach((evt) => window.removeEventListener(evt, unlock, true));

          if (typeof window !== "undefined") {
            const global = window as any;
            const AudioCtx = global.AudioContext || global.webkitAudioContext;
            if (AudioCtx) {
              try {
                const ctx = new AudioCtx();
                if (ctx.state === "suspended") {
                  ctx.resume();
                }
              } catch {}
            }
          }
        };

        unlockEvents.forEach((evt) => {
          window.addEventListener(evt, unlock, { capture: true, once: true, passive: true });
        });
      };

      setupAudioUnlock();
      document.addEventListener("astro:after-swap", () => {
        isUnlocked = false;
        setupAudioUnlock();
      });
    </script>
  </body>
</html>
