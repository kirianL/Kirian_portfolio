---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  lang?: string;
  image?: string;
}

const { title, description, lang = 'es', image = '/OG/KirianLunaOG.png' } = Astro.props;

const siteURL = Astro.site || new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const resolvedImageURL = new URL(image, siteURL);
const imageType = image.endsWith('.jpg') || image.endsWith('.jpeg') ? 'image/jpeg' : image.endsWith('.webp') ? 'image/webp' : 'image/png';

// Dynamic i18n hreflang URLs
const currentPath = Astro.url.pathname;
const cleanPath = currentPath.replace(/^\/es(\/|$)/, '/');
const englishPath = cleanPath;
const spanishPath = cleanPath === '/' ? '/es/' : `/es${cleanPath.endsWith('/') ? cleanPath.slice(0, -1) : cleanPath}`;

const englishURL = new URL(englishPath, siteURL);
const spanishURL = new URL(spanishPath, siteURL);
---

<!doctype html>
<html lang={lang} data-grayscale="slate" data-accent="violet">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Favicons & Manifest -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180x180.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#18181b" />
    <meta name="generator" content={Astro.generator} />

    <ClientRouter />

    <!-- Immediate Zero-FOUC Dark Mode Initializer -->
    <script is:inline>
      (function () {
        const theme = localStorage.getItem("theme");
        if (
          theme === "dark" ||
          (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)
        ) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
    <script>
      const syncTheme = () => {
        const theme = localStorage.getItem("theme");
        if (
          theme === "dark" ||
          (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)
        ) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      };

      document.addEventListener("astro:after-swap", syncTheme);
    </script>

    <!-- Performance & Preconnect (SXO) -->
    <link rel="dns-prefetch" href="https://cloud.umami.is" />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://api.lanyard.rest" crossorigin />
    <link rel="preconnect" href="https://i.scdn.co" crossorigin />

    <!-- Core SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Kirian Luna" />
    <meta name="publisher" content="Kirian Luna" />
    <meta name="keywords" content="Kirian Luna, Kirian Luna, Ingeniero en Sistemas, Systems Engineer, Software Engineer, Web Developer Costa Rica, Next.js, React, Astro, TypeScript, Product Designer, SorinLabs" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Canonical & i18n Hreflang & RSS Feed (SEO / AEO) -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={englishURL} />
    <link rel="alternate" hreflang="es" href={spanishURL} />
    <link rel="alternate" hreflang="x-default" href={englishURL} />
    <link rel="alternate" type="application/rss+xml" title="Kirian Luna Blog RSS" href={new URL(lang === 'es' ? '/es/rss.xml' : '/rss.xml', siteURL)} />

    <!-- Open Graph / Facebook (SEO / SXO) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kirian Luna" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImageURL} />
    <meta property="og:image:secure_url" content={resolvedImageURL} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />

    <!-- Twitter / X Cards (SEO / GEO) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImageURL} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="twitter:creator" content="@kirianluna" />

    <!-- Structured Data JSON-LD Schemas (AEO / GEO / AIO / Entity Graph) -->
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "@id": "https://kirian.dev/#person",
        "name": "Kirian Luna",
        "givenName": "Kirian",
        "familyName": "Luna",
        "url": "https://kirian.dev",
        "image": new URL('/OG/KirianLunaOG.png', siteURL).href,
        "jobTitle": "Ingeniero en Sistemas & Systems Engineer",
        "worksFor": {
          "@type": "Organization",
          "name": "SorinLabs"
        },
        "sameAs": [
          "https://github.com/kirianL",
          "https://linkedin.com/in/kirianluna"
        ],
        "knowsAbout": [
          "Systems Engineering",
          "Software Engineering",
          "TypeScript",
          "React",
          "Next.js",
          "Astro",
          "PostgreSQL",
          "Prisma ORM",
          "Node.js",
          "TailwindCSS",
          "UI/UX Design",
          "Search Engine Optimization (SEO)",
          "Search eXperience Optimization (SXO)"
        ],
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "Costa Rica"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://kirian.dev/#website",
        "url": "https://kirian.dev",
        "name": "Kirian Luna Portfolio",
        "description": "Official portfolio of Kirian Luna, Ingeniero en Sistemas / Systems Engineer based in Costa Rica.",
        "publisher": {
          "@id": "https://kirian.dev/#person"
        },
        "inLanguage": ["en", "es"]
      },
      {
        "@context": "https://schema.org",
        "@type": "ProfilePage",
        "@id": `${canonicalURL.href}#webpage`,
        "url": canonicalURL.href,
        "name": title,
        "description": description,
        "isPartOf": {
          "@id": "https://kirian.dev/#website"
        },
        "mainEntity": {
          "@id": "https://kirian.dev/#person"
        }
      }
    ])} />
    
    <!-- View Transitions Router -->
    <ClientRouter />

    <!-- Umami Analytics -->
    <script defer src="https://cloud.umami.is/script.js" data-website-id="427114d6-abc8-410e-adb2-98cc7571b5d3"></script>
  </head>
  <body class="antialiased selection:bg-accent-4/20 selection:text-accent-12 min-h-screen bg-grayscale-1 text-grayscale-12">
    <slot />

    <!-- cuelume interaction sounds & audio engine -->
    <script>
      import { bind, play, setVolume } from "cuelume";

      // Boost volume so subtle ticks and clicks are clearly audible
      try {
        setVolume(1.8);
      } catch {}

      const unlockAudio = () => {
        if (typeof window !== "undefined") {
          const global = window as any;
          const AudioCtx = global.AudioContext || global.webkitAudioContext;
          if (AudioCtx) {
            if (!global.__portfolioAudioCtx) {
              global.__portfolioAudioCtx = new AudioCtx();
            }
            if (global.__portfolioAudioCtx.state === "suspended") {
              global.__portfolioAudioCtx.resume();
            }
          }
        }
      };

      let lastHover = 0;
      const handlePointerEnter = (e: PointerEvent) => {
        const target = (e.target as Element)?.closest?.("[data-cuelume-hover]");
        if (!target) return;
        const now = Date.now();
        if (now - lastHover < 100) return;
        lastHover = now;
        unlockAudio();
        const sound = target.getAttribute("data-cuelume-hover") || "tick";
        try {
          play(sound as any);
        } catch {}
      };

      const handlePointerDown = (e: PointerEvent) => {
        unlockAudio();
        const target = (e.target as Element)?.closest?.("[data-cuelume-press], [data-cuelume-toggle]");
        if (!target) return;
        const sound = target.getAttribute("data-cuelume-press") || target.getAttribute("data-cuelume-toggle") || "pop";
        try {
          play((sound === "" || sound === "true" ? "pop" : sound) as any);
        } catch {}
      };

      const initAudio = () => {
        try {
          bind();
        } catch {}

        document.removeEventListener("pointerenter", handlePointerEnter, true);
        document.addEventListener("pointerenter", handlePointerEnter, true);

        document.removeEventListener("pointerdown", handlePointerDown, true);
        document.addEventListener("pointerdown", handlePointerDown, true);
      };

      initAudio();
      document.addEventListener("astro:page-load", initAudio);
    </script>
  </body>
</html>
