---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import PostHog from '../components/PostHog.astro';

interface Props {
  title: string;
  description: string;
  lang?: string;
  image?: string;
}

const { title, description, lang = 'es', image = '/OG/KirianLunaOG.png' } = Astro.props;

const siteURL = Astro.site || new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const resolvedImageURL = new URL(image, siteURL);
const imageType = image.endsWith('.jpg') || image.endsWith('.jpeg') ? 'image/jpeg' : image.endsWith('.webp') ? 'image/webp' : 'image/png';

// Dynamic i18n hreflang URLs
const currentPath = Astro.url.pathname;
const cleanPath = currentPath.replace(/^\/es(\/|$)/, '/');
const englishPath = cleanPath;
const spanishPath = cleanPath === '/' ? '/es/' : `/es${cleanPath.endsWith('/') ? cleanPath.slice(0, -1) : cleanPath}`;

const englishURL = new URL(englishPath, siteURL);
const spanishURL = new URL(spanishPath, siteURL);
---

<!doctype html>
<html lang={lang} data-grayscale="slate" data-accent="blue">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Immediate Zero-FOUC Theme Initializer (Runs before render) -->
    <script is:inline>
      (function () {
        function applyTheme(doc) {
          if (!doc || !doc.documentElement) return;
          var saved = localStorage.getItem("theme");
          var prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          var isDark = saved ? saved === "dark" : prefersDark;

          doc.documentElement.classList.toggle("dark", isDark);
          doc.documentElement.style.colorScheme = isDark ? "dark" : "light";
          doc.documentElement.style.backgroundColor = isDark ? "#111113" : "#ffffff";
        }

        // Apply immediately
        applyTheme(document);

        // Apply on incoming document before swap
        document.addEventListener("astro:before-swap", function (e) {
          if (e.newDocument) {
            applyTheme(e.newDocument);
          }
          try {
            if (e.viewTransition && e.viewTransition.skipTransition) {
              e.viewTransition.skipTransition();
            }
          } catch (_) {}
        });

        // Sync again after swap
        document.addEventListener("astro:after-swap", function () {
          applyTheme(document);
        });
      })();
    </script>

    <!-- Favicons & Manifest -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180x180.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <ClientRouter />

    <!-- Performance & Preconnect (SXO) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Geist+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400;1,6..72,500&family=Instrument+Serif:ital@0;1&display=swap" />
    <link rel="preconnect" href="https://api.lanyard.rest" crossorigin />
    <link rel="preconnect" href="https://i.scdn.co" crossorigin />

    <!-- Core SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Kirian Luna" />
    <meta name="publisher" content="Kirian Luna" />
    <meta name="keywords" content="Kirian Luna, Ingeniero de Software, Software Engineer, Web Developer Costa Rica, Next.js, React, Astro, TypeScript, Product Designer, SorinLabs" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Canonical & i18n Hreflang & RSS Feed -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={englishURL} />
    <link rel="alternate" hreflang="es" href={spanishURL} />
    <link rel="alternate" hreflang="x-default" href={englishURL} />
    <link rel="alternate" type="application/rss+xml" title="Kirian Luna Blog RSS" href={new URL(lang === 'es' ? '/es/rss.xml' : '/rss.xml', siteURL)} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kirian Luna" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImageURL} />
    <meta property="og:image:secure_url" content={resolvedImageURL} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImageURL} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="twitter:creator" content="@kirianluna" />

    <!-- Structured Data JSON-LD Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "@id": "https://kirian.dev/#person",
        "name": "Kirian Luna",
        "givenName": "Kirian",
        "familyName": "Luna",
        "url": "https://kirian.dev",
        "image": new URL('/OG/KirianLunaOG.png', siteURL).href,
        "jobTitle": "Ingeniero de Software & Software Engineer",
        "worksFor": {
          "@type": "Organization",
          "name": "SorinLabs"
        },
        "sameAs": [
          "https://github.com/kirianL",
          "https://linkedin.com/in/kirianluna"
        ],
        "knowsAbout": [
          "Systems Engineering",
          "Software Engineering",
          "TypeScript",
          "React",
          "Next.js",
          "Astro",
          "PostgreSQL",
          "Prisma ORM",
          "Node.js",
          "TailwindCSS",
          "UI/UX Design",
          "Search Engine Optimization (SEO)",
          "Search eXperience Optimization (SXO)"
        ],
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "Costa Rica"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://kirian.dev/#website",
        "url": "https://kirian.dev",
        "name": "Kirian Luna Portfolio",
        "description": "Official portfolio of Kirian Luna, Ingeniero de Software / Software Engineer based in Costa Rica.",
        "publisher": {
          "@id": "https://kirian.dev/#person"
        },
        "inLanguage": ["en", "es"]
      },
      {
        "@context": "https://schema.org",
        "@type": "ProfilePage",
        "@id": `${canonicalURL.href}#webpage`,
        "url": canonicalURL.href,
        "name": title,
        "description": description,
        "isPartOf": {
          "@id": "https://kirian.dev/#website"
        },
        "mainEntity": {
          "@id": "https://kirian.dev/#person"
        }
      }
    ])} />
    
    <PostHog />
  </head>
  <body class="antialiased selection:bg-accent-4/20 selection:text-accent-12 min-h-screen bg-grayscale-1 text-grayscale-12">
    <slot />

    <!-- cuelume interaction sounds & audio engine -->
    <script>
      import { bind, setVolume } from "cuelume";

      // Boost volume so subtle ticks, clicks, and page transitions are clearly audible
      try {
        setVolume(1.6);
      } catch {}

      // Bind all declarative data-cuelume-* attributes across the entire document
      try {
        bind(document);
      } catch {}
    </script>

    <!-- Lenis Smooth Scroll Engine -->
    <script>
      import Lenis from "lenis";

      let lenis: Lenis | null = null;
      let rafId: number | null = null;

      const initLenis = () => {
        if (lenis) {
          lenis.destroy();
          if (rafId !== null) cancelAnimationFrame(rafId);
        }

        lenis = new Lenis({
          duration: 1.0,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: "vertical",
          gestureOrientation: "vertical",
          smoothWheel: true,
          syncTouch: false,
        });

        (window as any).__lenis = lenis;

        function raf(time: number) {
          lenis?.raf(time);
          rafId = requestAnimationFrame(raf);
        }

        rafId = requestAnimationFrame(raf);
      };

      initLenis();
      document.addEventListener("astro:page-load", initLenis);

      // Instant scroll reset on page transition without jarring smooth lerp
      document.addEventListener("astro:after-swap", () => {
        const savedScroll = sessionStorage.getItem("portfolio_lang_scroll");
        if (savedScroll !== null) {
          const targetY = parseInt(savedScroll, 10);
          if (lenis) {
            lenis.scrollTo(targetY, { immediate: true });
          }
          window.scrollTo({ top: targetY, left: 0, behavior: "instant" });
          return;
        }
        if (lenis) {
          lenis.scrollTo(0, { immediate: true });
        }
        window.scrollTo({ top: 0, left: 0, behavior: "instant" });
      });
    </script>
  </body>
</html>
