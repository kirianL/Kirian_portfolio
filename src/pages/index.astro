---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import DitheredAvatar from "../components/DitheredAvatar.astro";
import Projects from "../components/Projects.astro";
import WorkExperience from "../components/WorkExperience.astro";
import TechStack from "../components/TechStack.astro";
import { dictionaries } from "../data/data";

const data = dictionaries.EN;
---

<Layout
  title="Kirian Luna Quirós | Systems Engineer"
  description="Professional portfolio of Kirian Luna Quirós, Systems Engineer based in Costa Rica."
  lang="en"
>
  <Navbar />

  <main class="min-h-screen bg-grayscale-1 px-4 sm:px-0">
    <div class="max-w-xl mx-auto md:px-0 px-4 pt-28 pb-16 flex flex-col gap-14">
      <!-- Header / Identity -->
      <header class="flex flex-col gap-y-6">
        <div class="flex items-center gap-4">
          <DitheredAvatar src="/profile.webp" alt={data.name} />
          <div>
            <h1 class="text-grayscale-12 font-semibold tracking-tight text-sm">
              {data.name}
            </h1>
            <p class="text-grayscale-11 tracking-tight text-sm mt-0.5">
              {data.title}
            </p>
            <p
              class="text-grayscale-11 tracking-tight text-xs mt-1 flex items-center gap-1"
            >
              <span>{data.hero.based.split("Costa Rica")[0]}</span>
              <span
                class="text-accent-9 hover:text-accent-10 transition-colors font-medium cursor-pointer"
                >Costa Rica</span
              >
              <span>{data.locationIcon}</span>
            </p>
          </div>
        </div>

        <section
          class="flex flex-col gap-3.5 tracking-tight text-grayscale-11 text-[13.5px] leading-relaxed"
        >
          <p>
            {data.hero.desc}
          </p>
          <p>
            {data.about.bio[0]}
          </p>
        </section>
      </header>

      <!-- Work Experience Section -->
      <WorkExperience />

      <!-- Projects Section -->
      <Projects />

      <!-- Skills Section (Interactive Tech Stack) -->
      <TechStack />

      <!-- Blog Section (Minimalist with horizontal cover) -->
      <section id="blog" class="flex flex-col gap-5">
        <h2 class="font-figgle text-3xl text-grayscale-12 tracking-tight select-none px-1">writing.</h2>
        <a
          href="/blog/digitalizing-a-cultural-identity/"
          class="group flex flex-col gap-3.5 p-3 rounded-xl bg-white dark:bg-grayscale-2 border border-grayscale-3 dark:border-grayscale-3/40 hover:border-grayscale-4 dark:hover:border-grayscale-4/60 transition-all duration-200 shadow-xs"
        >
          <div
            class="w-full aspect-[16/9] overflow-hidden rounded-lg bg-grayscale-2 border border-grayscale-3 dark:border-grayscale-3/50"
          >
            <img
              src="/blog-limon-identity.jpg"
              alt="Digitalizing a Cultural Identity: The Challenge of Doing Justice to Limón on a Website"
              class="w-full h-full object-cover group-hover:scale-[1.01] transition-transform duration-500 ease-out"
              loading="lazy"
            />
          </div>
          <div class="flex flex-col gap-1 px-1 py-0.5">
            <div
              class="flex items-center justify-between text-[10px] font-mono text-grayscale-10"
            >
              <span>June 13, 2026</span>
              <span
                class="px-2.5 py-0.5 bg-grayscale-3 text-grayscale-11 rounded-full font-medium text-[9px] shadow-3xs"
                >Culture / Design</span
              >
            </div>
            <h3
              class="text-grayscale-12 font-semibold text-[13.5px] leading-tight group-hover:text-accent-9 transition-colors mt-2"
            >
              Digitalizing a Cultural Identity: The Challenge of Doing Justice to Limón on a Website
            </h3>
            <p class="text-grayscale-11 text-[12.5px] leading-relaxed mt-1">
              How to represent the cultural richness of Limón on an interactive web platform without simplifying its history and social context.
            </p>
          </div>
        </a>
      </section>

      <!-- Contact Section -->
      <section id="contacto" class="flex flex-col gap-5">
        <h2 class="font-figgle text-3xl text-grayscale-12 tracking-tight select-none px-1">
          connect.
        </h2>
        <div class="flex flex-col gap-0.5 px-1">
          <div class="flex justify-between py-2.5 border-b border-grayscale-3/40 dark:border-grayscale-3/20">
            <span class="text-grayscale-12 text-sm font-medium">Email</span>
            <a
              href={`mailto:${data.contact.email}`}
              class="contact-link text-grayscale-11 hover:text-accent-9 text-sm font-mono transition-colors"
              >{data.contact.email}</a
            >
          </div>
          <div class="flex justify-between py-2.5 border-b border-grayscale-3/40 dark:border-grayscale-3/20">
            <span class="text-grayscale-12 text-sm font-medium">LinkedIn</span>
            <a
              href={data.contact.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link text-grayscale-11 hover:text-accent-9 text-sm font-mono transition-colors"
              >linkedin.com/in/kirianluna</a
            >
          </div>
          <div class="flex justify-between py-2.5 border-b border-grayscale-3/40 dark:border-grayscale-3/20">
            <span class="text-grayscale-12 text-sm font-medium">GitHub</span>
            <a
              href={data.contact.github}
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link text-grayscale-11 hover:text-accent-9 text-sm font-mono transition-colors"
              >github.com/kirianL</a
            >
          </div>
          <div class="flex justify-between py-2.5">
            <span class="text-grayscale-12 text-sm font-medium"
              >Curriculum Vitae</span
            >
            <a
              href="/CVs/CV_KirianLuna_EN.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link text-grayscale-11 hover:text-accent-9 text-sm font-mono transition-colors"
              >CV_KirianLuna_EN.pdf</a
            >
          </div>
        </div>
      </section>

      <!-- Footer -->
      <footer
        class="mt-6 text-center text-xs text-grayscale-10 font-mono border-t border-grayscale-3/40 dark:border-grayscale-3/20 pt-8"
      >
        Made with &lt;3
      </footer>
    </div>
  </main>
</Layout>
