---
import Layout from "../layouts/Layout.astro";
import RedDitherBanner from "../components/hero/RedDitherBanner.astro";
import CentralHero from "../components/hero/CentralHero.astro";
import { dictionaries } from "../data/data";
import { professionalServiceSchema } from "../lib/seo";

const data = dictionaries.EN;
---

<Layout
  title="Kirian Luna | Software Engineer"
  description="Professional portfolio of Kirian Luna, Software Engineer based in Costa Rica. Full-stack web engineering with TypeScript, React, Next.js and Astro."
  lang="en"
  loadSerifFonts={true}
  pageType="ProfilePage"
  schema={professionalServiceSchema}
>
  <main id="main-content" class="relative min-h-[100dvh] w-full bg-[#0a0a0a] text-[#f5f5f5] flex flex-col justify-center items-center pt-[22dvh] pb-10 overflow-hidden">
    <RedDitherBanner />
    <CentralHero
      lang="EN"
      name={data.name}
      pronunciation="/ˈkiː.ɹi.ɑːn ˈluː.nɑː/"
      roles={["Software Engineer", "Design Engineer"]}
      basedInLine="Based in 🇨🇷 Limón, Costa Rica"
      socialLabel="twitter"
      socialUrl={data.contact.twitter}
      rolePrefix="Currently working as a software engineer"
      companyName="UltimateMediaProductions"
      companyUrl="https://ultimatemediaproductions.com"
      lines={[
        "Graduated in Systems Engineering from Universidad Latina de Costa Rica.",
        "From Limón, Costa Rica with 2+ years of experience building digital products and web platforms.",
        "Over the last few years, I've built SaaS platforms, REST APIs with RBAC, and accessible interfaces using TypeScript, React 19, Next.js, Astro, and PostgreSQL.",
      ]}
      reachOutPrefix="Reach out to me at"
      email={data.contact.email}
      ctaPrimaryLabel="book a call"
      ctaPrimaryHref="/contact"
      ctaSecondaryLabel="view my work"
      ctaSecondaryHref="/projects"
    />

    <!-- Floating Toast Notification -->
    <div
      id="copy-toast"
      role="status"
      aria-live="polite"
      class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 pointer-events-none opacity-0 translate-y-3 transition-[opacity,transform] duration-300 ease-out flex items-center gap-2 px-3.5 py-2 rounded-full bg-zinc-100 text-zinc-900 text-xs font-medium shadow-lg border border-black/10 select-none"
    >
      <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
      <span id="copy-toast-text">Email copied to clipboard!</span>
    </div>
  </main>

  {/*
    ARCHIVED SECTIONS FOR SECTION-BY-SECTION REBUILD:
    All original portfolio data remains intact in src/data/data.ts and components:
    - Navbar (src/components/Navbar.astro)
    - Metadata row (Location, EmailMeta, ExperienceMeta, Live Clock)
    - About / Narrative (#about-intro with bio-notes)
    - WorkExperience (src/components/WorkExperience.astro)
    - Projects (src/components/Projects.astro)
    - TechStack (src/components/TechStack.astro)
    - Blog (#blog)
    - Contact (#contacto)
    - Footer (src/components/Footer.astro)
  */}
</Layout>

<script>
  import { play } from "cuelume";

  const setupHeroCopy = () => {
    const toast = document.getElementById("copy-toast");
    const toastText = document.getElementById("copy-toast-text");
    const copyBtns = document.querySelectorAll<HTMLElement>("[data-copy-email]");
    let toastTimeout: ReturnType<typeof setTimeout> | undefined;

    copyBtns.forEach((btn) => {
      if (btn.dataset.copyBound === "1") return;
      btn.dataset.copyBound = "1";

      btn.addEventListener("click", (e) => {
        e.preventDefault();
        const email = btn.getAttribute("data-copy-email");
        if (!email || !navigator.clipboard?.writeText) return;

        navigator.clipboard
          .writeText(email)
          .then(() => {
            play("success");
            if (toast && toastText) {
              toastText.textContent = "Email copied to clipboard!";
              toast.classList.remove("opacity-0", "translate-y-3");
              toast.classList.add("opacity-100", "translate-y-0");

              if (toastTimeout) clearTimeout(toastTimeout);
              toastTimeout = setTimeout(() => {
                toast.classList.remove("opacity-100", "translate-y-0");
                toast.classList.add("opacity-0", "translate-y-3");
                toastText.textContent = "";
              }, 2500);
            }
          })
          .catch(() => {});
      });
    });
  };

  document.addEventListener("astro:page-load", setupHeroCopy);
</script>
