---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import DitheredAvatar from "../components/DitheredAvatar.astro";
import Projects from "../components/Projects.astro";
import WorkExperience from "../components/WorkExperience.astro";
import TechStack from "../components/TechStack.astro";
import { dictionaries } from "../data/data";

const data = dictionaries.EN;
---

<Layout
  title="Kirian Luna Quirós | Systems Engineer"
  description="Professional portfolio of Kirian Luna Quirós, Systems Engineer based in Costa Rica."
  lang="en"
>
  <Navbar />

  <main class="min-h-screen bg-grayscale-1 px-4 sm:px-0">
    <div class="max-w-2xl mx-auto md:px-0 px-4 pt-28 pb-16 flex flex-col gap-14">
      <!-- Header / Identity -->
      <header class="flex flex-col gap-y-0">
        <!-- Avatar + Name row -->
        <div class="flex items-center gap-4 mb-1">
          <DitheredAvatar src="/ProfileKirian.jpg" alt={data.name} />
          <div>
            <h1 class="text-grayscale-12 font-medium tracking-tight text-xl leading-tight">
              {data.name}
            </h1>
            <p class="text-grayscale-10 tracking-tight text-sm mt-0.5">
              {data.title}
            </p>
          </div>
        </div>

        <!-- Metadata row -->
        <div class="flex items-start gap-8 mt-6 flex-wrap">
          <!-- Location -->
          <div class="flex flex-col gap-1.5">
            <span class="text-[10px] font-medium uppercase tracking-[0.12em] text-grayscale-10">Location</span>
            <span class="text-grayscale-12 text-sm flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-grayscale-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              {data.location} {data.locationIcon}
            </span>
          </div>
          <!-- Email -->
          <div class="flex flex-col gap-1.5">
            <span class="text-[10px] font-medium uppercase tracking-[0.12em] text-grayscale-10">Email</span>
            <a href={`mailto:${data.contact.email}`} class="text-grayscale-12 text-sm flex items-center gap-1.5 hover:text-accent-9 transition-colors">
              <svg class="w-3.5 h-3.5 text-grayscale-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              {data.contact.email}
            </a>
          </div>
          <!-- Experience -->
          <div class="flex flex-col gap-1.5">
            <span class="text-[10px] font-medium uppercase tracking-[0.12em] text-grayscale-10">Experience</span>
            <span class="text-grayscale-12 text-sm flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-grayscale-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              {data.experience}
            </span>
          </div>
        </div>

        <!-- Divider -->
        <div class="border-t border-grayscale-3/50 dark:border-grayscale-3/25 mt-6 mb-5"></div>

        <!-- Bio -->
        <section class="flex flex-col gap-3.5 tracking-tight text-grayscale-11 text-[13.5px] leading-relaxed">
          <p>{data.hero.desc}</p>
          <p>Currently working with <strong class="text-grayscale-12 font-medium">TypeScript</strong>, <strong class="text-grayscale-12 font-medium">React</strong>, <strong class="text-grayscale-12 font-medium">Next.js</strong>, and <strong class="text-grayscale-12 font-medium">Tailwind CSS</strong>.</p>
        </section>

        <!-- Social icons row -->
        <div class="flex items-center gap-3 mt-5">
          <!-- GitHub -->
          <a href={data.contact.github} target="_blank" rel="noopener noreferrer" class="text-grayscale-10 hover:text-grayscale-12 transition-colors" aria-label="GitHub">
            <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
          <!-- LinkedIn -->
          <a href={data.contact.linkedin} target="_blank" rel="noopener noreferrer" class="text-grayscale-10 hover:text-grayscale-12 transition-colors" aria-label="LinkedIn">
            <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <!-- Website / Portfolio -->
          <a href="/" class="text-grayscale-10 hover:text-grayscale-12 transition-colors" aria-label="Website">
            <svg class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/>
            </svg>
          </a>
          <!-- Email -->
          <a href={`mailto:${data.contact.email}`} class="text-grayscale-10 hover:text-grayscale-12 transition-colors" aria-label="Email">
            <svg class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </a>
        </div>
      </header>

      <!-- Work Experience Section -->
      <WorkExperience />

      <!-- Projects Section -->
      <Projects />

      <!-- Skills Section (Interactive Tech Stack) -->
      <TechStack />

      <!-- Blog Section (Minimalist with horizontal cover) -->
      <section id="blog" class="flex flex-col gap-5">
        <h2 class="font-figgle text-3xl text-grayscale-12 tracking-tight select-none px-1">writing.</h2>
        <a
          href="/blog/digitalizing-a-cultural-identity/"
          class="group flex flex-col gap-3.5 p-3 rounded-xl bg-white dark:bg-grayscale-2 border border-grayscale-3 dark:border-grayscale-3/40 hover:border-grayscale-4 dark:hover:border-grayscale-4/60 transition-all duration-200 shadow-xs"
        >
          <div
            class="w-full aspect-[16/9] overflow-hidden rounded-lg bg-grayscale-2 border border-grayscale-3 dark:border-grayscale-3/50"
          >
            <img
              src="/blog-limon-identity.jpg"
              alt="Digitalizing a Cultural Identity: The Challenge of Doing Justice to Limón on a Website"
              class="w-full h-full object-cover group-hover:scale-[1.01] transition-transform duration-500 ease-out"
              loading="lazy"
            />
          </div>
          <div class="flex flex-col gap-1 px-1 py-0.5">
            <div
              class="flex items-center justify-between text-[10px] font-mono text-grayscale-10"
            >
              <span>June 13, 2026</span>
              <span
                class="px-2.5 py-0.5 bg-grayscale-3 text-grayscale-11 rounded-full font-medium text-[9px] shadow-3xs"
                >Culture / Design</span
              >
            </div>
            <h3
              class="text-grayscale-12 font-semibold text-[13.5px] leading-tight group-hover:text-accent-9 transition-colors mt-2"
            >
              Digitalizing a Cultural Identity: The Challenge of Doing Justice to Limón on a Website
            </h3>
            <p class="text-grayscale-11 text-[12.5px] leading-relaxed mt-1">
              How to represent the cultural richness of Limón on an interactive web platform without simplifying its history and social context.
            </p>
          </div>
        </a>
      </section>

      <!-- Contact Section -->
      <section id="contacto" class="flex flex-col gap-5">
        <h2 class="font-figgle text-3xl text-grayscale-12 tracking-tight select-none px-1">
          connect.
        </h2>
        <div class="flex flex-col gap-0.5 px-1">
          <div class="flex justify-between py-2.5 border-b border-grayscale-3/40 dark:border-grayscale-3/20">
            <span class="text-grayscale-12 text-sm font-medium">Email</span>
            <a
              href={`mailto:${data.contact.email}`}
              class="contact-link text-grayscale-11 hover:text-accent-9 text-sm font-mono transition-colors"
              >{data.contact.email}</a
            >
          </div>
          <div class="flex justify-between py-2.5 border-b border-grayscale-3/40 dark:border-grayscale-3/20">
            <span class="text-grayscale-12 text-sm font-medium">LinkedIn</span>
            <a
              href={data.contact.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link text-grayscale-11 hover:text-accent-9 text-sm font-mono transition-colors"
              >linkedin.com/in/kirianluna</a
            >
          </div>
          <div class="flex justify-between py-2.5 border-b border-grayscale-3/40 dark:border-grayscale-3/20">
            <span class="text-grayscale-12 text-sm font-medium">GitHub</span>
            <a
              href={data.contact.github}
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link text-grayscale-11 hover:text-accent-9 text-sm font-mono transition-colors"
              >github.com/kirianL</a
            >
          </div>
          <div class="flex justify-between py-2.5">
            <span class="text-grayscale-12 text-sm font-medium"
              >Curriculum Vitae</span
            >
            <a
              href="/CVs/CV_KirianLuna_EN.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link text-grayscale-11 hover:text-accent-9 text-sm font-mono transition-colors"
              >CV_KirianLuna_EN.pdf</a
            >
          </div>
        </div>
      </section>

      <!-- Footer -->
      <footer
        class="mt-6 text-center text-xs text-grayscale-10 font-mono border-t border-grayscale-3/40 dark:border-grayscale-3/20 pt-8"
      >
        Made with &lt;3
      </footer>
    </div>
  </main>
</Layout>
