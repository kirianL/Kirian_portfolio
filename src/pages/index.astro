---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import BannerHero from "../components/BannerHero.astro";
import EmailMeta from "../components/EmailMeta.astro";
import ExperienceMeta from "../components/ExperienceMeta.astro";
import Projects from "../components/Projects.astro";
import WorkExperience from "../components/WorkExperience.astro";
import TechStack from "../components/TechStack.astro";
import Footer from "../components/Footer.astro";
import { dictionaries } from "../data/data";
import { professionalServiceSchema, projectItemListSchema } from "../lib/seo";

const data = dictionaries.EN;
---

<Layout
  title="Kirian Luna | Software Engineer"
  description="Professional portfolio of Kirian Luna, Software Engineer based in Costa Rica. Full-stack web engineering with TypeScript, React, Next.js and Astro."
  lang="en"
  pageType="ProfilePage"
  schema={professionalServiceSchema}
>
  <Navbar />

  <main id="main-content" class="min-h-screen bg-grayscale-1">
    <div class="max-w-2xl mx-auto px-6 sm:px-0 pt-28 pb-16 flex flex-col gap-14">
      <!-- Header / Identity -->
      <header class="flex flex-col gap-y-0">
        <!-- Banner, Avatar & Identity -->
        <BannerHero name={data.name} title={data.title} />

        <!-- Metadata row -->
        <div class="grid grid-cols-2 sm:flex sm:items-start gap-x-6 gap-y-4 sm:gap-8 mt-6">
          <!-- Location -->
          <div class="flex flex-col gap-1.5">
            <span class="text-[10px] font-medium uppercase tracking-[0.12em] text-grayscale-11">Location</span>
            <span class="cr-location-badge group/cr text-grayscale-12 text-sm flex items-center gap-1.5 cursor-default" data-cuelume-hover="tick">
              <svg class="w-3.5 h-3.5 text-grayscale-11 transition-transform duration-200 group-hover/cr:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span class="cr-location-text font-medium">
                <span>{data.location}</span>
                <span class="cr-location-flag-layer" aria-hidden="true">{data.location}</span>
                <span class="cr-limon-branch" aria-hidden="true">
                  <svg class="cr-branch-svg" viewBox="0 0 16 16" fill="none">
                    <path
                      class="cr-branch-path"
                      d="M1.5 0V8.5C1.5 11.2614 3.73858 13.5 6.5 13.5H15.5"
                      stroke="currentColor"
                      stroke-width="1.2"
                      stroke-linecap="round"
                    />
                  </svg>
                  <span class="cr-limon-label">Puerto Limón</span>
                </span>
              </span>
            </span>
          </div>

          <!-- Email -->
          <EmailMeta label="Email" email={data.contact.email} />

          <!-- Experience -->
          <ExperienceMeta label="Experience" experience={data.experience} />

          <!-- Live Clock: CR -->
          <div class="flex flex-col gap-1.5">
            <span class="text-[10px] font-medium uppercase tracking-[0.12em] text-grayscale-11">Time Zone</span>
            <span class="text-grayscale-12 text-sm flex items-center gap-1.5 select-none">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
              <span id="cr-time">--:--</span>
            </span>
          </div>
        </div>
      </header>

      <!-- Divider -->
      <div class="border-t border-grayscale-3/50 dark:border-grayscale-3/25 -mt-8 -mb-8"></div>

      <!-- About / Narrative Section -->
      <section id="about-intro" class="flex flex-col gap-4">
        <!-- Bio (2 concise paragraphs with pencil focus effect) -->
        <div class="bio-focus-scope relative flex flex-col gap-3.5 tracking-tight text-grayscale-11 text-[13.5px] leading-relaxed">
          <div class="bio-dimmer" aria-hidden="true"></div>
          <p>
            <span class="bio-prose">I'm a Software Engineer from Limón, Costa Rica, focused on building modern digital products that solve real-world </span><span class="bio-pencil-word" data-mark="circle" tabindex="0" role="button" aria-expanded="false">problems<svg class="bio-mark bio-mark--circle" viewBox="0 0 100 40" preserveAspectRatio="none" fill="none" aria-hidden="true"><path pathLength="1" d="M76 5C56 1 22 2 8 12C-3 20 3 30 20 35C39 40 71 37 87 32C101 27 101 17 91 10C83 4 67 1 57 3" /></svg><span class="bio-hand-note" aria-hidden="true">No bloat, just software<br />people actually use.</span></span><span class="bio-prose">. I combine engineering, </span><span class="bio-pencil-word" data-mark="dots" tabindex="0" role="button" aria-expanded="false">design<svg class="bio-mark bio-mark--dots" viewBox="0 0 100 40" preserveAspectRatio="none" fill="none" aria-hidden="true"><circle cx="10" cy="34" r="1.5" /><circle cx="20" cy="35" r="1.5" /><circle cx="30" cy="34" r="1.5" /><circle cx="40" cy="34.5" r="1.5" /><circle cx="50" cy="34" r="1.5" /><circle cx="60" cy="35" r="1.5" /><circle cx="70" cy="34.5" r="1.5" /><circle cx="80" cy="34" r="1.5" /><circle cx="90" cy="35" r="1.5" /></svg><span class="bio-hand-note" aria-hidden="true">Yes, I obsess over 1px<br />and 60fps transitions.</span></span><span class="bio-prose"> and user experience to ship scalable, intuitive systems—graduated in Systems Engineering from </span><a href="https://www.ulatina.ac.cr/" target="_blank" rel="noopener noreferrer" data-cuelume-hover="tick" data-cuelume-press data-cuelume-release class="ulatina-link text-emerald-700 hover:text-emerald-800 dark:text-emerald-400 dark:hover:text-emerald-300 font-medium transition-colors">Universidad Latina de Costa Rica<span class="ulatina-preview" aria-hidden="true"><img src="/images/ulatina-campus.webp" alt="" width="480" height="320" loading="lazy" decoding="async" /></span></a><span class="bio-prose">.</span>
          </p>

          <p>
            <span class="bio-prose">I specialize in full-stack </span><span class="bio-pencil-word" data-mark="double" tabindex="0" role="button" aria-expanded="false">TypeScript<svg class="bio-mark bio-mark--double" viewBox="0 0 100 40" preserveAspectRatio="none" fill="none" aria-hidden="true"><path pathLength="1" d="M5 32Q45 28 95 32" /><path pathLength="1" d="M12 38Q47 34 86 37" /></svg><span class="bio-hand-note" aria-hidden="true">I can code too!<br />(even without AI, just slower)</span></span><span class="bio-prose">, React 19, Next.js, Astro, Node.js, PostgreSQL, and Prisma—building SaaS platforms, REST APIs with RBAC, and </span><span class="bio-pencil-word" data-mark="underline" tabindex="0" role="button" aria-expanded="false">accessible<svg class="bio-mark bio-mark--underline" viewBox="0 0 132 10" preserveAspectRatio="none" fill="none" aria-hidden="true"><path pathLength="1" d="M2 6C29 2 46 8 69 5S110 3 130 5" /></svg><span class="bio-hand-note" aria-hidden="true">Keyboard, screen readers,<br />everyone gets in.</span></span><span class="bio-prose">, fast interfaces. Available for fixed-scope projects, consulting, and remote roles in English and Spanish.</span>
          </p>
        </div>

        <!-- Social icons row with Open to work -->
        <div class="flex items-center justify-between gap-4 mt-2">
          <div class="flex items-center gap-3.5">
            <!-- X (Twitter) -->
            <a href={data.contact.twitter} target="_blank" rel="noopener noreferrer" data-cuelume-hover="tick" class="p-1.5 -m-1.5 rounded-md text-grayscale-11 hover:text-black dark:hover:text-white hover:-translate-y-0.5 active:scale-[0.96] transition-[color,transform] duration-200" aria-label="X (Twitter)">
              <svg class="w-[17px] h-[17px]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
            <!-- GitHub -->
            <a href={data.contact.github} target="_blank" rel="noopener noreferrer" data-cuelume-hover="tick" class="p-1.5 -m-1.5 rounded-md text-grayscale-11 hover:text-[#24292e] dark:hover:text-white hover:-translate-y-0.5 active:scale-[0.96] transition-[color,transform] duration-200" aria-label="Kirian Luna GitHub profile">
              <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
            </a>
            <!-- LinkedIn -->
            <a href={data.contact.linkedin} target="_blank" rel="noopener noreferrer" data-cuelume-hover="tick" class="p-1.5 -m-1.5 rounded-md text-grayscale-11 hover:text-[#0A66C2] hover:-translate-y-0.5 active:scale-[0.96] transition-[color,transform] duration-200" aria-label="LinkedIn">
              <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
            <!-- Discord -->
            <a href={data.contact.discord} target="_blank" rel="noopener noreferrer" data-cuelume-hover="tick" class="p-1.5 -m-1.5 rounded-md text-grayscale-11 hover:text-[#5865F2] hover:-translate-y-0.5 active:scale-[0.96] transition-[color,transform] duration-200" aria-label="Discord">
              <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
              </svg>
            </a>
            <!-- Email with Copy Toast -->
            <button 
              type="button" 
              data-copy-email={data.contact.email}
              class="p-1.5 -m-1.5 rounded-md text-grayscale-11 hover:text-[#EA4335] hover:-translate-y-0.5 active:scale-[0.96] transition-[color,transform] duration-200 cursor-pointer" 
              aria-label="Copy Email"
              title="Copy email to clipboard"
            >
              <svg class="w-[17px] h-[17px]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L5.455 4.64 12 9.548l6.545-4.91 1.528-1.145C21.69 2.28 24 3.434 24 5.457z"/>
              </svg>
            </button>
          </div>

          <!-- Minimal Modern Clean Open to Work (No container, animated modern green) -->
          <a
            href="/contact"
            data-cuelume-hover="tick"
            data-cuelume-press="page"
            title="Available for new projects and roles"
            class="open-to-work-link group inline-flex items-center gap-1 text-[11.5px] font-mono tracking-tight select-none cursor-pointer py-0.5"
          >
            <!-- Animated Text with Liquid Shimmer Mask -->
            <span class="relative inline-flex items-center">
              <span class="text-grayscale-11 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 font-medium transition-colors">Open to work</span>
              <span class="open-to-work-shimmer absolute inset-0 text-emerald-600 dark:text-emerald-400 font-medium pointer-events-none" aria-hidden="true">Open to work</span>
            </span>

            <!-- Subtle Arrow -->
            <span class="text-[10px] text-grayscale-11 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-[color,transform] duration-200">↗</span>
          </a>
        </div>
      </section>

      <!-- Work Experience Section -->
      <WorkExperience />

      <!-- Projects Section -->
      <Projects />

      <!-- Skills Section (Interactive Tech Stack) -->
      <TechStack />

      <!-- Blog Section (Minimalist with horizontal cover) -->
      <section id="blog" class="flex flex-col gap-5">
        <h2 class="font-figgle text-3xl text-grayscale-12 tracking-tight select-none">writing.</h2>
        <a
          href="/blog/digitalizing-a-cultural-identity/"
          class="group flex flex-col gap-3.5 p-2 rounded-2xl bg-white dark:bg-grayscale-2 border border-grayscale-3 dark:border-grayscale-3/40 hover:border-grayscale-4 dark:hover:border-grayscale-4/60 transition-[border-color,box-shadow] duration-200 shadow-xs"
        >
          <div
            class="w-full aspect-[16/9] overflow-hidden rounded-lg bg-grayscale-2 border border-grayscale-3 dark:border-grayscale-3/50"
          >
            <img
              src="/blog-limon-identity.jpg"
              alt="Digitalizing a Cultural Identity: The Challenge of Doing Justice to Limón on a Website"
              width="650"
              height="366"
              class="w-full h-full object-cover group-hover:scale-[1.01] transition-transform duration-500 ease-out"
              loading="lazy"
            />
          </div>
          <div class="flex flex-col gap-1 px-1 py-0.5">
            <div
              class="flex items-center justify-between text-[10px] font-mono text-grayscale-11"
            >
              <span>June 13, 2026</span>
              <span
                class="px-2.5 py-0.5 bg-grayscale-3 text-grayscale-11 rounded-full font-medium text-[9px] shadow-3xs"
                >Culture / Design</span
              >
            </div>
            <h3
              class="text-grayscale-12 font-semibold text-[13.5px] leading-tight group-hover:text-accent-9 transition-colors mt-2"
            >
              Digitalizing a Cultural Identity: The Challenge of Doing Justice to Limón on a Website
            </h3>
            <p class="text-grayscale-11 text-[12.5px] leading-relaxed mt-1">
              How to represent the cultural richness of Limón on an interactive web platform without simplifying its history and social context.
            </p>
          </div>
        </a>
      </section>

      <!-- Contact Section -->
      <section id="contacto" class="flex flex-col gap-5">
        <h2 class="font-figgle text-3xl text-grayscale-12 tracking-tight select-none">
          connect.
        </h2>
        <div class="flex flex-col gap-0.5">
          <div class="flex justify-between py-2.5 border-b border-grayscale-3/40 dark:border-grayscale-3/20">
            <span class="text-grayscale-12 text-sm font-medium">Email</span>
            <button
              type="button"
              data-copy-email={data.contact.email}
              data-cuelume-hover="tick"
              data-cuelume-press
              class="contact-link text-grayscale-11 hover:text-accent-9 text-sm font-mono transition-colors cursor-pointer"
            >
              {data.contact.email}
            </button>
          </div>
          <div class="flex justify-between py-2.5 border-b border-grayscale-3/40 dark:border-grayscale-3/20">
            <span class="text-grayscale-12 text-sm font-medium">LinkedIn</span>
            <a
              href={data.contact.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              data-cuelume-hover="tick"
              class="contact-link text-grayscale-11 hover:text-accent-9 text-sm font-mono transition-colors"
              >linkedin.com/in/kirianluna</a
            >
          </div>
          <div class="flex justify-between py-2.5 border-b border-grayscale-3/40 dark:border-grayscale-3/20">
            <span class="text-grayscale-12 text-sm font-medium">GitHub</span>
            <a
              href={data.contact.github}
              target="_blank"
              rel="noopener noreferrer"
              data-cuelume-hover="tick"
              class="contact-link text-grayscale-11 hover:text-accent-9 text-sm font-mono transition-colors"
              >github.com/kirianL</a
            >
          </div>
          <div class="flex justify-between py-2.5">
            <span class="text-grayscale-12 text-sm font-medium"
              >Curriculum Vitae</span
            >
            <a
              href="/CVs/CV_KirianLuna_EN.pdf"
              target="_blank"
              rel="noopener noreferrer"
              data-cuelume-hover="tick"
              class="contact-link text-grayscale-11 hover:text-accent-9 text-sm font-mono transition-colors"
              >CV_KirianLuna_EN.pdf</a
            >
          </div>
        </div>
      </section>


      <!-- Footer -->
      <Footer />
    </div>

    <!-- Floating Toast Notification -->
    <div
      id="copy-toast"
      role="status"
      aria-live="polite"
      class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 pointer-events-none opacity-0 translate-y-3 transition-[opacity,transform] duration-300 ease-out flex items-center gap-2 px-3.5 py-2 rounded-full bg-zinc-900 text-zinc-100 dark:bg-zinc-100 dark:text-zinc-900 text-xs font-medium shadow-lg border border-white/10 dark:border-black/10 select-none"
    >
      <svg class="w-3.5 h-3.5 text-emerald-400 dark:text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
      <span id="copy-toast-text">Email copied to clipboard!</span>
    </div>
  </main>
</Layout>

<script>
  import { play } from "cuelume";
  import "../lib/bio-notes";

  let clockInterval: any = null;

  const setupInteractiveFeatures = () => {
    // 1. Live Clock (Costa Rica)
    const crEl = document.getElementById('cr-time');
    
    if (crEl) {
      const updateClocks = () => {
        const now = new Date();
        const crTime = now.toLocaleTimeString('en-US', { timeZone: 'America/Costa_Rica', hour: '2-digit', minute: '2-digit', hour12: false });
        crEl.textContent = `${crTime} CST`;
      };
      updateClocks();
      if (clockInterval) clearInterval(clockInterval);
      clockInterval = setInterval(updateClocks, 1000);
    }

    // 2. Email Copy Toast + Cuelume Sound
    const toast = document.getElementById('copy-toast');
    const copyBtns = document.querySelectorAll('[data-copy-email]');
    let toastTimeout: any;

    copyBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const email = btn.getAttribute('data-copy-email') || 'kirianluna.u@gmail.com';
        navigator.clipboard.writeText(email).then(() => {
          play("success");
          if (toast) {
            toast.classList.remove('opacity-0', 'translate-y-3');
            toast.classList.add('opacity-100', 'translate-y-0');
            
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
              toast.classList.remove('opacity-100', 'translate-y-0');
              toast.classList.add('opacity-0', 'translate-y-3');
            }, 2500);
          }
        });
      });
    });
  };

  setupInteractiveFeatures();
  document.addEventListener('astro:page-load', setupInteractiveFeatures);
</script>

<style>
  /* Open to work liquid emerald shimmer */
  @keyframes textShimmerSweep {
    0% {
      -webkit-mask-position: 150% 0;
      mask-position: 150% 0;
    }
    45%, 100% {
      -webkit-mask-position: -50% 0;
      mask-position: -50% 0;
    }
  }

  .open-to-work-shimmer {
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.2) 20%,
      black 50%,
      rgba(0, 0, 0, 0.2) 80%,
      transparent 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.2) 20%,
      black 50%,
      rgba(0, 0, 0, 0.2) 80%,
      transparent 100%
    );
    -webkit-mask-size: 200% 100%;
    mask-size: 200% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    animation: textShimmerSweep 3.6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    will-change: -webkit-mask-position, mask-position;
  }

  .open-to-work-link:hover .open-to-work-shimmer {
    opacity: 0;
  }
</style>
