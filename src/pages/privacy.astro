---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Privacy | Kirian Luna — Software Engineer"
  description="Privacy policy and data handling principles for kirian.dev. No tracking cookies, no advertising scripts, and full transparency."
  lang="en"
>
  <Navbar />

  <main id="main-content" class="min-h-screen bg-grayscale-1">
    <div class="max-w-xl mx-auto px-6 sm:px-0 pt-28 pb-16 flex flex-col gap-10">
      
      <!-- Back Link -->
      <div>
        <a
          href="/"
          data-cuelume-hover="tick"
          class="inline-flex items-center gap-1 text-xs font-mono text-grayscale-10 hover:text-grayscale-12 transition-colors select-none"
        >
          <span>←</span>
          <span>Home</span>
        </a>
      </div>

      <!-- Intro Block -->
      <section class="flex flex-col gap-3.5">
        <h1 class="text-sm font-semibold text-grayscale-12 font-mono tracking-tight select-none">
          Privacy
        </h1>
        <p class="text-xs sm:text-[13px] text-grayscale-11 leading-relaxed">
          This site is a personal portfolio. It sets no tracking cookies, runs no advertising scripts, embeds no third-party behavioral trackers, and collects nothing about you on purpose. This page explains the little that still happens when you visit.
        </p>
      </section>

      <!-- Minimal Two-Column Structured Sections -->
      <div class="flex flex-col gap-10 text-xs sm:text-[13px] leading-relaxed">
        
        <!-- Hosting -->
        <section class="grid grid-cols-1 sm:grid-cols-[130px_1fr] gap-2 sm:gap-6 items-baseline">
          <span class="text-xs font-mono text-grayscale-10 select-none">Hosting</span>
          <div class="flex flex-col gap-3.5 text-grayscale-11">
            <p>
              The site runs on <a href="https://vercel.com" target="_blank" rel="noopener noreferrer" class="text-grayscale-12 underline underline-offset-4 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Vercel</a>, which processes each request—including your IP address and standard browser headers—to serve the page and protect the infrastructure from abuse. Request logs are kept transiently for error diagnostics and are not used to profile visitors.
            </p>
          </div>
        </section>

        <!-- Your browser -->
        <section class="grid grid-cols-1 sm:grid-cols-[130px_1fr] gap-2 sm:gap-6 items-baseline">
          <span class="text-xs font-mono text-grayscale-10 select-none">Your browser</span>
          <div class="flex flex-col gap-3.5 text-grayscale-11">
            <p>
              Theme preference (dark or light mode) is stored locally in your browser's localStorage so the site remembers your setting on return visits. Audio preferences for UI feedback are kept in your current session. This data never leaves your device.
            </p>
          </div>
        </section>

        <!-- Analytics -->
        <section class="grid grid-cols-1 sm:grid-cols-[130px_1fr] gap-2 sm:gap-6 items-baseline">
          <span class="text-xs font-mono text-grayscale-10 select-none">Analytics</span>
          <div class="flex flex-col gap-3.5 text-grayscale-11">
            <p>
              I use a privacy-respecting instance of <a href="https://posthog.com" target="_blank" rel="noopener noreferrer" class="text-grayscale-12 underline underline-offset-4 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">PostHog</a> to count aggregate page visits and understand general traffic patterns. It operates without cross-site tracking cookies, does not collect personal identifiers, and data is never sold or shared with advertisers.
            </p>
          </div>
        </section>

        <!-- Questions -->
        <section class="grid grid-cols-1 sm:grid-cols-[130px_1fr] gap-2 sm:gap-6 items-baseline">
          <span class="text-xs font-mono text-grayscale-10 select-none">Questions</span>
          <div class="flex flex-col gap-3.5 text-grayscale-11">
            <p>
              Links to other sites, such as my projects, <a href="https://github.com/kirianL" target="_blank" rel="noopener noreferrer" class="text-grayscale-12 underline underline-offset-4 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">GitHub</a>, or <a href="https://linkedin.com/in/kirianluna" target="_blank" rel="noopener noreferrer" class="text-grayscale-12 underline underline-offset-4 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">LinkedIn</a>, open those sites under their own privacy policies. For any questions regarding your data or privacy, write to <a href="mailto:kirianluna.u@gmail.com" class="text-grayscale-12 underline underline-offset-4 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">kirianluna.u@gmail.com</a>.
            </p>
          </div>
        </section>

      </div>

      <Footer />
    </div>
  </main>
</Layout>
