---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

import { getCollection } from 'astro:content';

// Localized blog content
const title = "Blog";
const description = "Sharing thoughts on design, engineering, and web performance.";

// Fetch English posts from Content Collection
const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(post => post.id.startsWith('en/'))
  .map(post => ({
    title: post.data.title,
    description: post.data.description,
    date: post.data.date,
    category: post.data.category,
    image: post.data.image,
    link: `/blog/${post.id.replace(/^en\//, '')}/`
  }));
---

<Layout 
  title="Blog | Kirian Luna Quirós" 
  description={description}
  lang="en"
>
  <Navbar />
  
  <main class="max-w-2xl mx-auto px-4 sm:px-0 pt-28 pb-16">
    <div class="flex flex-col gap-10">
      
      <!-- Blog Header -->
      <section class="flex flex-col gap-2 px-1">
        <h1 class="font-figgle text-3xl text-grayscale-12 tracking-tight select-none">
          blog.
        </h1>
        <p class="text-grayscale-11 text-xs leading-normal">
          {description}
        </p>
      </section>

      <!-- Blog Posts List -->
      <section class="flex flex-col gap-6 px-1">
        {posts.map((post) => (
          <a href={post.link} data-cuelume-hover="tick" data-cuelume-press data-cuelume-release class="group flex flex-col gap-3.5 p-3 rounded-xl bg-white dark:bg-grayscale-2 border border-grayscale-3 dark:border-grayscale-3/40 hover:border-grayscale-4 dark:hover:border-grayscale-4/60 transition-all duration-200 shadow-xs">
            <div class="w-full aspect-[16/9] overflow-hidden rounded-lg bg-grayscale-2 border border-grayscale-3 dark:border-grayscale-3/50">
              <img 
                src={post.image} 
                alt={post.title} 
                class="w-full h-full object-cover group-hover:scale-[1.01] transition-transform duration-500 ease-out" 
                loading="lazy"
              />
            </div>
            <div class="flex flex-col gap-1 px-1 py-0.5">
              <div class="flex items-center justify-between text-[10px] font-mono text-grayscale-10">
                <span>{post.date}</span>
                <span class="px-2.5 py-0.5 bg-grayscale-3 text-grayscale-11 rounded-full font-medium text-[9px] shadow-3xs">{post.category}</span>
              </div>
              <h3 class="text-grayscale-12 font-semibold text-[13.5px] leading-tight group-hover:text-accent-9 transition-colors mt-2">
                {post.title}
              </h3>
              <p class="text-grayscale-11 text-[12.5px] leading-relaxed mt-1">
                {post.description}
              </p>
            </div>
          </a>
        ))}
      </section>

      <!-- Newsletter Section -->
      <section class="mt-4 p-5 rounded-xl bg-white dark:bg-grayscale-2 border border-grayscale-3 dark:border-grayscale-3/40 flex flex-col gap-4 shadow-xs">
        <h3 class="text-grayscale-12 font-semibold text-sm">Subscribe to the newsletter</h3>
        <p class="text-grayscale-11 text-xs leading-relaxed">
          Get notified whenever I publish a new article about design, engineering, and web performance. No spam, unsubscribe at any time.
        </p>
        <form id="subscribe-form" class="flex flex-col sm:flex-row gap-2 mt-1">
          <input 
            type="email" 
            required 
            placeholder="your@email.com" 
            class="flex-1 w-full px-3 py-2 text-xs rounded-lg border border-grayscale-3 bg-grayscale-1 text-grayscale-12 focus:outline-none focus:border-accent-9 transition-colors"
          />
          <button 
            type="submit" 
            class="w-full sm:w-auto px-4 py-2 text-xs bg-grayscale-12 text-grayscale-1 font-medium rounded-lg hover:opacity-90 active:scale-95 transition-all cursor-pointer"
          >
            Subscribe
          </button>
        </form>
        <p id="subscribe-message" class="text-xs font-mono hidden"></p>
      </section>

      <script>
        const form = document.getElementById('subscribe-form') as HTMLFormElement;
        const message = document.getElementById('subscribe-message') as HTMLParagraphElement;

        form?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const emailInput = form.querySelector('input[type="email"]') as HTMLInputElement;
          const email = emailInput.value;
          
          const button = form.querySelector('button') as HTMLButtonElement;
          const originalText = button.textContent;
          button.disabled = true;
          button.textContent = 'Subscribing...';
          
          try {
            const res = await fetch('/api/subscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email, lang: 'en' })
            });
            const data = await res.json();
            
            if (res.ok) {
              message.textContent = '✓ Successfully subscribed!';
              message.className = 'text-xs font-mono text-green-600';
              form.reset();
            } else {
              message.textContent = `✗ ${data.error || 'Something went wrong'}`;
              message.className = 'text-xs font-mono text-red-600';
            }
          } catch (err) {
            message.textContent = '✗ Connection error. Please try again.';
            message.className = 'text-xs font-mono text-red-600';
          } finally {
            button.disabled = false;
            button.textContent = originalText;
            message.classList.remove('hidden');
          }
        });
      </script>

      <!-- Footer -->
      <Footer />

    </div>
  </main>
</Layout>
