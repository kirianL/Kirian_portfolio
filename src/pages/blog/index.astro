---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { absoluteUrl, PERSON_ID } from '../../lib/seo';

const title = "Blog | Kirian Luna";
const description = "Notes on building fast interfaces, systems, and software from Limón.";

const categoryColors: Record<string, { text: string; dot: string }> = {
  "UI Engineering": {
    text: "text-violet-600 dark:text-violet-400",
    dot: "bg-violet-500",
  },
  "Architecture": {
    text: "text-sky-600 dark:text-sky-400",
    dot: "bg-sky-500",
  },
  "Performance": {
    text: "text-amber-600 dark:text-amber-400",
    dot: "bg-amber-500",
  },
  "Design Systems": {
    text: "text-orange-600 dark:text-orange-400",
    dot: "bg-orange-500",
  },
  "Culture / Design": {
    text: "text-emerald-600 dark:text-emerald-400",
    dot: "bg-emerald-500",
  },
};

const categories = Array.from(new Set(posts.map((p) => p.category)));
const latestPost = posts[0];
const archivePosts = posts.slice(1);

// Fetch English posts from Content Collection
const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(post => post.id.startsWith('en/'))
  .map(post => {
    const rawBody = post.body || "";
    const wordCount = rawBody.trim().split(/\s+/).filter(Boolean).length;
    const readTime = `${Math.max(1, Math.ceil(wordCount / 200))} min read`;

    const slug = post.id.replace(/^en\//, '');
    return {
      slug,
      title: post.data.title,
      description: post.data.description,
      date: post.data.date,
      category: post.data.category,
      image: post.data.image,
      readTime,
      link: `/blog/${slug}/`
    };
  })
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const blogItemList = {
  '@type': 'ItemList',
  '@id': absoluteUrl('/blog/#itemlist'),
  name: 'Articles by Kirian Luna',
  numberOfItems: posts.length,
  itemListElement: posts.map((post, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'BlogPosting',
      headline: post.title,
      description: post.description,
      url: absoluteUrl(post.link),
      datePublished: new Date(post.date).toISOString(),
      articleSection: post.category,
      author: { '@id': PERSON_ID },
      inLanguage: 'en',
    },
  })),
};
---

<Layout 
  title={title}
  description={description}
  lang="en"
  pageType="CollectionPage"
  schema={blogItemList}
>
  <Navbar />
  
  <main id="main-content" class="bg-grayscale-1">
    <div class="max-w-2xl mx-auto px-4 sm:px-0 pt-24 sm:pt-28 pb-8 flex flex-col gap-8 sm:gap-10">
        
        <!-- Blog Header + Interactive Topic Filter -->
        <header class="flex flex-col gap-5">
          <div class="flex flex-col gap-2">
            <div class="flex items-baseline justify-between gap-4">
              <h1 class="font-figgle text-3xl text-grayscale-12 tracking-tight select-none">
                writing.
              </h1>
              <span class="text-[11px] font-mono tabular-nums text-grayscale-9">
                {posts.length} essays
              </span>
            </div>
            <p class="text-grayscale-11 text-xs leading-normal">
              {description}
            </p>
          </div>

          <!-- Topic Filter Bar -->
          <div class="flex items-center gap-1.5 overflow-x-auto pb-1 -mx-1 px-1 no-scrollbar" role="tablist" aria-label="Filter articles by topic">
            <button
              type="button"
              data-filter="all"
              aria-selected="true"
              class="blog-filter-btn shrink-0 px-2.5 py-1 rounded-full text-[11px] font-mono transition-[background-color,color] duration-150 bg-grayscale-12 text-grayscale-1 cursor-pointer select-none"
            >
              All
            </button>
            {categories.map((cat) => {
              const style = categoryColors[cat] ?? { text: "text-grayscale-11", dot: "bg-grayscale-9" };
              return (
                <button
                  type="button"
                  data-filter={cat}
                  aria-selected="false"
                  class="blog-filter-btn shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-mono text-grayscale-10 hover:text-grayscale-12 hover:bg-grayscale-2/70 dark:hover:bg-grayscale-3/30 transition-[background-color,color] duration-150 cursor-pointer select-none"
                >
                  <span class:list={["w-1.5 h-1.5 rounded-full", style.dot]} aria-hidden="true"></span>
                  {cat}
                </button>
              );
            })}
          </div>
        </header>

        <!-- Lead Essay (Horizontal Editorial Split on Desktop, Stacked on Mobile) -->
        {latestPost && (() => {
          const leadColor = categoryColors[latestPost.category] ?? { text: "text-grayscale-11", dot: "bg-grayscale-9" };
          return (
            <article class="blog-item" data-category={latestPost.category}>
              <a
                href={latestPost.link}
                data-astro-prefetch="viewport"
                data-cuelume-hover="tick"
                data-cuelume-press="page"
                data-cuelume-release="release"
                class="group grid grid-cols-1 sm:grid-cols-12 gap-5 sm:gap-6 items-center active:scale-[0.99] transition-transform duration-200 ease-[cubic-bezier(0.2,0,0,1)]"
              >
                {latestPost.image && (
                  <div
                    data-blog-cover={latestPost.slug}
                    class="sm:col-span-7 w-full aspect-video overflow-hidden rounded-xl bg-grayscale-2 outline-1 -outline-offset-1 outline-black/10 dark:outline-white/10 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.08)] dark:shadow-[0_6px_24px_-4px_rgba(0,0,0,0.4)] group-hover:shadow-[0_12px_32px_-6px_rgba(0,0,0,0.14)] dark:group-hover:shadow-[0_12px_32px_-6px_rgba(0,0,0,0.55)] transition-shadow duration-300 ease-[cubic-bezier(0.2,0,0,1)]"
                  >
                    <img
                      src={latestPost.image}
                      alt={latestPost.title}
                      width="1200"
                      height="675"
                      class="w-full h-full object-cover"
                      loading="eager"
                    />
                  </div>
                )}

                <div class="sm:col-span-5 flex flex-col gap-2.5">
                  <div class="flex items-center justify-between gap-2 text-[11px] font-mono">
                    <span class:list={["inline-flex items-center gap-1.5 font-medium", leadColor.text]}>
                      <span class:list={["w-1.5 h-1.5 rounded-full", leadColor.dot]} aria-hidden="true"></span>
                      {latestPost.category}
                    </span>
                    <span class="text-grayscale-9 tabular-nums">01</span>
                  </div>

                  <h2 class="text-grayscale-12 font-medium text-lg sm:text-[19px] leading-snug tracking-tight text-balance group-hover:text-grayscale-11 transition-colors duration-200">
                    {latestPost.title}
                  </h2>

                  <p class="text-grayscale-11 text-xs leading-relaxed line-clamp-3">
                    {latestPost.description}
                  </p>

                  <div class="flex items-center justify-between pt-1 text-[11px] font-mono text-grayscale-10 tabular-nums">
                    <time>{latestPost.date}</time>
                    <span>{latestPost.readTime}</span>
                  </div>
                </div>
              </a>
            </article>
          );
        })()}

        <!-- Editorial Archive Index (Scannable rows with inline 16:9 artwork) -->
        {archivePosts.length > 0 && (
          <section class="flex flex-col border-t border-grayscale-3/60 dark:border-grayscale-3/30 divide-y divide-grayscale-3/50 dark:divide-grayscale-3/25">
            {archivePosts.map((post, i) => {
              const catStyle = categoryColors[post.category] ?? { text: "text-grayscale-11", dot: "bg-grayscale-9" };
              const issueNum = String(i + 2).padStart(2, '0');
              return (
                <article class="blog-item" data-category={post.category}>
                  <a
                    href={post.link}
                    data-astro-prefetch="viewport"
                    data-cuelume-hover="tick"
                    data-cuelume-press="page"
                    data-cuelume-release="release"
                    class="group flex items-center justify-between gap-4 sm:gap-6 py-5 -mx-2 px-2 rounded-xl hover:bg-grayscale-2/45 dark:hover:bg-grayscale-2/25 active:scale-[0.99] transition-[background-color,transform] duration-200 ease-[cubic-bezier(0.2,0,0,1)]"
                  >
                    <!-- Left: Number, Category, Title, Meta -->
                    <div class="flex flex-col gap-1.5 min-w-0 flex-1">
                      <div class="flex items-center gap-2.5 text-[11px] font-mono">
                        <span class="text-grayscale-9 tabular-nums">{issueNum}</span>
                        <span class:list={["inline-flex items-center gap-1.5 font-medium", catStyle.text]}>
                          <span class:list={["w-1 h-1 rounded-full", catStyle.dot]} aria-hidden="true"></span>
                          {post.category}
                        </span>
                      </div>

                      <h3 class="text-grayscale-12 font-medium text-[14.5px] sm:text-[15.5px] leading-snug tracking-tight text-balance group-hover:text-grayscale-11 transition-colors duration-200">
                        {post.title}
                      </h3>

                      <p class="text-grayscale-11 text-xs leading-relaxed line-clamp-1 sm:line-clamp-2 max-w-md">
                        {post.description}
                      </p>

                      <div class="flex items-center gap-3 pt-0.5 text-[11px] font-mono text-grayscale-9 tabular-nums">
                        <time>{post.date}</time>
                        <span>{post.readTime}</span>
                      </div>
                    </div>

                    <!-- Right: Crisp 16:9 Thumbnail -->
                    {post.image && (
                      <div
                        data-blog-cover={post.slug}
                        class="w-24 sm:w-36 aspect-video overflow-hidden rounded-lg bg-grayscale-2 outline-1 -outline-offset-1 outline-black/10 dark:outline-white/10 shadow-[0_2px_8px_-2px_rgba(0,0,0,0.06)] dark:shadow-[0_2px_10px_-2px_rgba(0,0,0,0.35)] shrink-0"
                      >
                        <img
                          src={post.image}
                          alt={post.title}
                          width="1200"
                          height="675"
                          class="w-full h-full object-cover"
                          loading="lazy"
                        />
                      </div>
                    )}
                  </a>
                </article>
              );
            })}
          </section>
        )}

        <!-- Newsletter Section (Hairline editorial style) -->
        <section class="pt-8 border-t border-grayscale-3/60 dark:border-grayscale-3/30 flex flex-col gap-3">
          <div class="flex flex-col gap-1">
            <h3 class="text-grayscale-12 font-medium text-sm tracking-tight">Newsletter</h3>
            <p class="text-grayscale-11 text-xs leading-relaxed max-w-lg">
              Get notified whenever I publish a new article about design, engineering, and web performance. Zero spam, unsubscribe anytime.
            </p>
          </div>

          <form id="subscribe-form" class="flex flex-col sm:flex-row gap-2 mt-1">
            <label for="subscribe-email" class="sr-only">Email address</label>
            <input 
              id="subscribe-email"
              type="email" 
              required 
              autocomplete="email"
              placeholder="you@domain.com" 
              class="flex-1 w-full px-3.5 py-2 text-[16px] sm:text-xs rounded-lg border border-grayscale-3/70 bg-white dark:bg-grayscale-2 text-grayscale-12 placeholder:text-grayscale-9 focus-visible:outline-none focus:outline-none focus-visible:border-grayscale-6 dark:focus-visible:border-grayscale-6 transition-colors"
            />
            <button 
              type="submit" 
              data-cuelume-hover="tick"
              data-cuelume-press="scan"
              class="w-full sm:w-auto px-4 py-2 text-xs bg-grayscale-12 text-grayscale-1 font-medium rounded-lg hover:opacity-90 active:scale-[0.96] transition-[opacity,transform] cursor-pointer select-none shrink-0"
            >
              Subscribe
            </button>
          </form>
          <p id="subscribe-message" role="status" aria-live="polite" class="text-xs font-mono hidden"></p>
        </section>

        <!-- Footer -->
        <Footer />
      </div>
    </main>
</Layout>

<script>
  const setupBlogFilters = () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.blog-filter-btn');
    const items = document.querySelectorAll<HTMLElement>('.blog-item');
    if (!buttons.length || !items.length) return;

    buttons.forEach((btn) => {
      if (btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';

      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter || 'all';

        buttons.forEach((b) => {
          const isActive = b === btn;
          b.setAttribute('aria-selected', isActive ? 'true' : 'false');
          b.classList.toggle('bg-grayscale-12', isActive);
          b.classList.toggle('text-grayscale-1', isActive);
          b.classList.toggle('text-grayscale-10', !isActive);
        });

        items.forEach((item) => {
          const match = filter === 'all' || item.dataset.category === filter;
          item.style.display = match ? '' : 'none';
        });
      });
    });
  };

  setupBlogFilters();
  document.addEventListener('astro:page-load', setupBlogFilters);

  const setupNewsletterForm = () => {
    const form = document.getElementById('subscribe-form') as HTMLFormElement | null;
    const message = document.getElementById('subscribe-message') as HTMLParagraphElement | null;
    if (!form || !message || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = form.querySelector('input[type="email"]') as HTMLInputElement;
      const email = emailInput ? emailInput.value : '';
      const button = form.querySelector('button') as HTMLButtonElement;
      const originalText = button ? button.textContent : 'Subscribe';
      if (button) {
        button.disabled = true;
        button.textContent = '...';
      }

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, lang: 'en' })
        });
        const data = await res.json();

        if (res.ok) {
          message.textContent = '✓ Subscribed successfully!';
          message.className = 'text-xs font-mono text-emerald-600 dark:text-emerald-400';
          form.reset();
        } else {
          message.textContent = `✗ ${data.error || 'Something went wrong'}`;
          message.className = 'text-xs font-mono text-red-600 dark:text-red-400';
        }
      } catch (err) {
        message.textContent = '✗ Connection error. Please try again.';
        message.className = 'text-xs font-mono text-red-600 dark:text-red-400';
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = originalText;
        }
        message.classList.remove('hidden');
      }
    });
  };

  setupNewsletterForm();
  document.addEventListener('astro:page-load', setupNewsletterForm);
</script>
