---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const enPosts = posts.filter(post => post.id.startsWith('en/'));
  
  return enPosts.map(post => {
    const slug = post.id.replace(/^en\//, '');
    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout 
  title={`${post.data.title} | Kirian Luna Quirós`} 
  description={post.data.description}
  lang="en"
  image={post.data.image}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.description,
    "image": new URL(post.data.image, Astro.site || Astro.url.origin).href,
    "datePublished": post.data.date,
    "author": {
      "@type": "Person",
      "name": "Kirian Luna Quirós",
      "url": "https://kirian.dev"
    },
    "publisher": {
      "@type": "Person",
      "name": "Kirian Luna Quirós",
      "url": "https://kirian.dev"
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": new URL(Astro.url.pathname, Astro.site || Astro.url.origin).href
    }
  })} />

  <Navbar />
  
  <main class="min-h-screen bg-grayscale-1 px-4 sm:px-0">
    <div class="max-w-xl mx-auto md:px-0 px-4 pt-28 pb-16 flex flex-col gap-8">
      
      <!-- Back Link -->
      <a href="/blog/" data-cuelume-press data-cuelume-release class="group flex items-center gap-1.5 text-xs text-grayscale-11 hover:text-accent-9 transition-colors w-fit font-mono">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-0.5 transition-transform"><path d="m15 18-6-6 6-6"/></svg>
        Back to blog
      </a>
      
      <!-- Header -->
      <header class="flex flex-col gap-3">
        <div class="flex items-center justify-between text-[10px] font-mono text-grayscale-10">
          <span>{post.data.date}</span>
          <span class="px-2.5 py-0.5 bg-grayscale-3 text-grayscale-11 rounded-full font-medium text-[9px] shadow-3xs">{post.data.category}</span>
        </div>
        <h1 class="text-grayscale-12 font-semibold tracking-tight text-xl sm:text-2xl mt-1 leading-snug">
          {post.data.title}
        </h1>
        <p class="text-grayscale-11 text-sm leading-relaxed mt-1">
          {post.data.description}
        </p>
      </header>

      <!-- Post Cover Image -->
      <div class="w-full aspect-[16/9] overflow-hidden rounded-lg bg-grayscale-2 border border-grayscale-3 dark:border-grayscale-3/50">
        <img 
          src={post.data.image} 
          alt={post.data.title} 
          class="w-full h-full object-cover" 
        />
      </div>

      <!-- Article Content -->
      <article class="prose w-full">
        <Content />
      </article>

      <!-- Newsletter Section -->
      <section class="mt-8 p-5 rounded-xl bg-white dark:bg-grayscale-2 border border-grayscale-3 dark:border-grayscale-3/40 flex flex-col gap-4 shadow-xs">
        <h3 class="text-grayscale-12 font-semibold text-sm">Subscribe to the newsletter</h3>
        <p class="text-grayscale-11 text-xs leading-relaxed">
          Get notified whenever I publish a new article about design, engineering, and web performance. No spam, unsubscribe at any time.
        </p>
        <form id="subscribe-form" class="flex flex-col sm:flex-row gap-2 mt-1">
          <input 
            type="email" 
            required 
            placeholder="your@email.com" 
            class="flex-1 w-full px-3 py-2 text-xs rounded-lg border border-grayscale-3 bg-grayscale-1 text-grayscale-12 focus:outline-none focus:border-accent-9 transition-colors"
          />
          <button 
            type="submit" 
            data-cuelume-press
            data-cuelume-release
            class="w-full sm:w-auto px-4 py-2 text-xs bg-grayscale-12 text-grayscale-1 font-medium rounded-lg hover:opacity-90 active:scale-95 transition-all cursor-pointer"
          >
            Subscribe
          </button>
        </form>
        <p id="subscribe-message" class="text-xs font-mono hidden"></p>
      </section>

      <script>
        import { play } from "cuelume";

        const form = document.getElementById('subscribe-form') as HTMLFormElement;
        const message = document.getElementById('subscribe-message') as HTMLParagraphElement;

        form?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const emailInput = form.querySelector('input[type="email"]') as HTMLInputElement;
          const email = emailInput.value;
          
          const button = form.querySelector('button') as HTMLButtonElement;
          const originalText = button.textContent;
          button.disabled = true;
          button.textContent = 'Subscribing...';
          
          try {
            const res = await fetch('/api/subscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email, lang: 'en' })
            });
            const data = await res.json();
            
            if (res.ok) {
              play("success");
              message.textContent = '✓ Successfully subscribed!';
              message.className = 'text-xs font-mono text-green-600 block';
              form.reset();
            } else {
              play("error");
              message.textContent = `✗ ${data.error || 'Something went wrong'}`;
              message.className = 'text-xs font-mono text-red-600 block';
            }
          } catch (err) {
            play("error");
            message.textContent = '✗ Connection error. Please try again.';
            message.className = 'text-xs font-mono text-red-600 block';
          } finally {
            button.disabled = false;
            button.textContent = originalText;
            message.classList.remove('hidden');
          }
        });
      </script>

      <!-- Footer -->
      <Footer />

    </div>
  </main>
</Layout>

<script>
  const setupLinks = () => {
    const links = document.querySelectorAll('article.prose a');
    links.forEach(link => {
      if (link.getAttribute('href')?.startsWith('http')) {
        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'noopener noreferrer');
      }
    });
  };

  setupLinks();
  document.addEventListener('astro:after-swap', setupLinks);
</script>

<style is:global>
  /* Markdown styling scoped to the article */
  article.prose a {
    color: var(--color-accent-9);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.15s ease;
  }
  article.prose a:hover {
    color: var(--color-accent-10);
    text-decoration: none;
  }
  article.prose hr {
    border: none;
    text-align: center;
    margin: 2.5rem 0;
  }
  article.prose hr::after {
    content: "···";
    letter-spacing: 0.8em;
    color: var(--color-grayscale-10);
    font-size: 1.25rem;
    font-weight: bold;
  }
  article.prose h2 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-grayscale-12);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }
  article.prose p {
    font-size: 0.875rem;
    line-height: 1.625;
    color: var(--color-grayscale-11);
    margin-bottom: 1.25rem;
  }
  article.prose code {
    font-family: var(--font-geistmono);
    font-size: 0.8125rem;
    background-color: var(--color-grayscale-2);
    padding: 0.125rem 0.25rem;
    border-radius: 4px;
    border: 1px solid var(--color-grayscale-3);
  }
  article.prose pre {
    background-color: var(--color-grayscale-2);
    border: 1px solid var(--color-grayscale-3);
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }
  article.prose pre code {
    background-color: transparent;
    padding: 0;
    border: none;
    border-radius: 0;
  }
  article.prose ul {
    list-style-type: disc;
    padding-left: 1.25rem;
    margin-bottom: 1.25rem;
    color: var(--color-grayscale-11);
    font-size: 0.875rem;
  }
  article.prose li {
    margin-bottom: 0.5rem;
  }
  /* Table styling */
  article.prose table {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
    font-size: 0.8125rem;
    -webkit-overflow-scrolling: touch;
  }
  article.prose th, article.prose td {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--color-grayscale-3);
    text-align: left;
    white-space: nowrap;
  }
  article.prose th {
    font-weight: 600;
    color: var(--color-grayscale-12);
  }
</style>
