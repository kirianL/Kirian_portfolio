---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import CardStampArc from "../../components/CardStampArc.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
  title="Craft | Kirian Luna"
  description="Pequeños estudios de interfaz, patrones de animación y demostraciones de componentes creados por Kirian Luna."
  lang="es"
>
  <Navbar />

  <main class="max-w-2xl mx-auto px-4 sm:px-0 pt-28 pb-16">
    <div class="flex flex-col gap-10">
      <!-- Header Section -->
      <section class="flex flex-col gap-2 px-1">
        <h1
          class="font-figgle text-3xl text-grayscale-12 tracking-tight select-none"
        >
          craft.
        </h1>
        <p class="text-grayscale-11 text-xs sm:text-sm leading-normal">
          Interfaces, componentes y experimentos que he creado desde cero.
        </p>
      </section>

      <!-- Main Showcase Container (Outer shell box capturing all cards, dqnamo style) -->
      <section
        class="rounded-3xl border border-grayscale-3 dark:border-grayscale-3/40 bg-grayscale-1/30 dark:bg-grayscale-2/15 p-3 sm:p-4 flex flex-col gap-3 sm:gap-4 shadow-2xs"
      >
        <!-- 1. Top Featured Card (Hero Full Width) -->
        <a
          href="/es/craft/card-stamp-arc"
          class="group rounded-2xl border border-grayscale-3 dark:border-grayscale-3/50 bg-white dark:bg-grayscale-2/40 overflow-hidden transition-all duration-300 hover:border-grayscale-4 dark:hover:border-grayscale-4/60 shadow-xs block"
        >
          <!-- Preview Canvas -->
          <div
            class="relative w-full pt-16 pb-8 sm:pt-20 sm:pb-10 px-4 sm:px-6 flex items-center justify-center bg-gradient-to-b from-grayscale-1/60 to-grayscale-2/80 dark:from-grayscale-1/20 dark:to-grayscale-3/30 border-b border-grayscale-3/40 overflow-hidden min-h-[220px] sm:min-h-[260px]"
          >
            <!-- Background grid pattern -->
            <div
              class="absolute inset-0 bg-[linear-gradient(to_right,#8881_1px,transparent_1px),linear-gradient(to_bottom,#8881_1px,transparent_1px)] bg-[size:24px_24px] pointer-events-none opacity-40"
            >
            </div>

            <CardStampArc
              className="mt-5 sm:mt-7"
              photos={[
                {
                  id: 0,
                  caption: "Arquitectura",
                  src: "https://images.unsplash.com/photo-1513694203232-719a280e022f?w=600&auto=format&fit=crop&q=80",
                },
                {
                  id: 1,
                  caption: "Montañas",
                  src: "https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=600&auto=format&fit=crop&q=80",
                },
                {
                  id: 2,
                  caption: "Vista al océano",
                  src: "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=600&auto=format&fit=crop&q=80",
                },
                {
                  id: 3,
                  caption: "Estudio creativo",
                  src: "https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=600&auto=format&fit=crop&q=80",
                },
                {
                  id: 4,
                  caption: "Retrato",
                  src: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=600&auto=format&fit=crop&q=80",
                },
              ]}
            />
          </div>

          <!-- Card Info Footer -->
          <div class="p-5 sm:p-6 flex flex-col gap-2">
            <div class="flex items-center justify-between gap-3">
              <h2
                class="text-sm sm:text-base font-semibold text-grayscale-12 tracking-tight group-hover:text-accent-9 transition-colors"
              >
                Card stamp arc
              </h2>
              <svg
                class="w-4 h-4 text-grayscale-10 group-hover:text-grayscale-12 group-hover:translate-x-1 transition-all duration-200 shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </div>
            <p class="text-xs text-grayscale-11 leading-relaxed">
              Arco interactivo de tarjetas polaroid con física de abanico dinámico
              al pasar el cursor, ángulos de rotación escalonados, transiciones
              suaves y sonido.
            </p>
          </div>
        </a>

        <!-- 2. 3-Column Grid of Clean Coming Soon Cards (No mockup graphics, only centered Próximamente word) -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <!-- Coming Soon Card 1 -->
          <div
            class="group rounded-2xl border border-grayscale-3 dark:border-grayscale-3/50 bg-white dark:bg-grayscale-2/40 overflow-hidden transition-all duration-300 shadow-xs cursor-default select-none flex flex-col"
          >
            <div
              class="relative w-full h-32 sm:h-36 bg-gradient-to-b from-grayscale-1/60 to-grayscale-2/80 dark:from-grayscale-1/20 dark:to-grayscale-3/30 overflow-hidden flex items-center justify-center p-4"
            >
              <div
                class="absolute inset-0 bg-[linear-gradient(to_right,#8881_1px,transparent_1px),linear-gradient(to_bottom,#8881_1px,transparent_1px)] bg-[size:16px_16px] opacity-25"
              >
              </div>

              <span
                class="px-3 py-1 rounded-lg bg-white/90 dark:bg-zinc-900/90 text-grayscale-11 text-xs font-mono border border-grayscale-3 dark:border-zinc-800 shadow-xs backdrop-blur-md z-10"
              >
                Próximamente
              </span>
            </div>
          </div>

          <!-- Coming Soon Card 2 -->
          <div
            class="group rounded-2xl border border-grayscale-3 dark:border-grayscale-3/50 bg-white dark:bg-grayscale-2/40 overflow-hidden transition-all duration-300 shadow-xs cursor-default select-none flex flex-col"
          >
            <div
              class="relative w-full h-32 sm:h-36 bg-gradient-to-b from-grayscale-1/60 to-grayscale-2/80 dark:from-grayscale-1/20 dark:to-grayscale-3/30 overflow-hidden flex items-center justify-center p-4"
            >
              <div
                class="absolute inset-0 bg-[linear-gradient(to_right,#8881_1px,transparent_1px),linear-gradient(to_bottom,#8881_1px,transparent_1px)] bg-[size:16px_16px] opacity-25"
              >
              </div>

              <span
                class="px-3 py-1 rounded-lg bg-white/90 dark:bg-zinc-900/90 text-grayscale-11 text-xs font-mono border border-grayscale-3 dark:border-zinc-800 shadow-xs backdrop-blur-md z-10"
              >
                Próximamente
              </span>
            </div>
          </div>

          <!-- Coming Soon Card 3 -->
          <div
            class="group rounded-2xl border border-grayscale-3 dark:border-grayscale-3/50 bg-white dark:bg-grayscale-2/40 overflow-hidden transition-all duration-300 shadow-xs cursor-default select-none flex flex-col"
          >
            <div
              class="relative w-full h-32 sm:h-36 bg-gradient-to-b from-grayscale-1/60 to-grayscale-2/80 dark:from-grayscale-1/20 dark:to-grayscale-3/30 overflow-hidden flex items-center justify-center p-4"
            >
              <div
                class="absolute inset-0 bg-[linear-gradient(to_right,#8881_1px,transparent_1px),linear-gradient(to_bottom,#8881_1px,transparent_1px)] bg-[size:16px_16px] opacity-25"
              >
              </div>

              <span
                class="px-3 py-1 rounded-lg bg-white/90 dark:bg-zinc-900/90 text-grayscale-11 text-xs font-mono border border-grayscale-3 dark:border-zinc-800 shadow-xs backdrop-blur-md z-10"
              >
                Próximamente
              </span>
            </div>
          </div>
        </div>
      </section>

      <!-- Footer -->
      <Footer />
    </div>
  </main>
</Layout>
