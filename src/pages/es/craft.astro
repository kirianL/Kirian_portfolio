                >
                  <svg class="btn-icon w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                  <span class="btn-text">Copiar</span>
                </button>
              </div>
              <pre class="p-4 overflow-x-auto text-zinc-300 max-h-80 leading-relaxed selection:bg-accent-9/30"><code id="code-display">{astroCode}</code></pre>
            </div>
          </div>
        </article>

        <!-- Más Experimentos Pronto -->
        <div class="rounded-xl border border-dashed border-grayscale-3 dark:border-grayscale-3/40 p-6 flex flex-col gap-1 items-center justify-center text-center bg-grayscale-1/30 dark:bg-grayscale-2/10">
          <p class="text-xs font-semibold text-grayscale-12 tracking-tight">
            Más experimentos pronto
          </p>
          <p class="text-[11px] text-grayscale-11 leading-relaxed max-w-sm">
            Diseñando nuevas microinteracciones, físicas de canvas y componentes de interfaz.
          </p>
        </div>
      </section>

      <!-- Footer -->
      <Footer />
    </div>
  </main>
</Layout>

<script is:inline>
  const snippets = {
    astro: `{astroCode}`,
    react: `{reactCode}`,
    usage: `{usageMd}`
  };
</script>

<script>
  declare const snippets: { astro: string; react: string; usage: string };

  let activeTab = 'astro';

  // Hyper-fluid crossfade & spring scale in-button animation
  function animateButtonSuccess(btn: HTMLElement, successText: string) {
    if (btn.classList.contains('is-animating')) return;
    btn.classList.add('is-animating');

    const iconEl = btn.querySelector('.btn-icon') as HTMLElement;
    const textEl = btn.querySelector('.btn-text') as HTMLElement;
    if (!textEl) return;

    const origText = textEl.textContent || '';
    const origIconHtml = iconEl ? iconEl.outerHTML : '';

    // Step 1: Smooth press & blur crossfade out
    btn.style.transition = 'transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.25s ease, border-color 0.25s ease';
    btn.style.transform = 'scale(0.94)';

    if (textEl) {
      textEl.style.transition = 'opacity 0.12s ease, transform 0.12s ease, filter 0.12s ease';
      textEl.style.opacity = '0';
      textEl.style.transform = 'translateY(-3px)';
      textEl.style.filter = 'blur(2px)';
    }
    if (iconEl) {
      iconEl.style.transition = 'opacity 0.12s ease, transform 0.12s ease, filter 0.12s ease';
      iconEl.style.opacity = '0';
      iconEl.style.transform = 'scale(0.7)';
      iconEl.style.filter = 'blur(2px)';
    }

    setTimeout(() => {
      // Step 2: Swap content & trigger spring scale up to 1.03
      btn.style.transform = 'scale(1.03)';
      btn.classList.add('border-emerald-500/60', 'bg-emerald-500/10', 'text-emerald-600', 'dark:text-emerald-400');
      textEl.textContent = successText;

      if (iconEl) {
        iconEl.outerHTML = `<svg class="btn-icon w-3.5 h-3.5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>`;
      }

      const newIcon = btn.querySelector('.btn-icon') as HTMLElement;

      requestAnimationFrame(() => {
        if (textEl) {
          textEl.style.opacity = '1';
          textEl.style.transform = 'translateY(0px)';
          textEl.style.filter = 'blur(0px)';
        }
        if (newIcon) {
          newIcon.style.transition = 'opacity 0.15s ease, transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1)';
          newIcon.style.opacity = '1';
          newIcon.style.transform = 'scale(1)';
        }
      });

      setTimeout(() => {
        btn.style.transform = 'scale(1)';
      }, 150);
    }, 120);

    // Step 3: Revert back smoothly after 1600ms
    setTimeout(() => {
      if (textEl) {
        textEl.style.opacity = '0';
        textEl.style.transform = 'translateY(3px)';
        textEl.style.filter = 'blur(2px)';
      }
      const currentIcon = btn.querySelector('.btn-icon') as HTMLElement;
      if (currentIcon) {
        currentIcon.style.opacity = '0';
        currentIcon.style.transform = 'scale(0.7)';
        currentIcon.style.filter = 'blur(2px)';
      }

      setTimeout(() => {
        textEl.textContent = origText;
        btn.classList.remove('border-emerald-500/60', 'bg-emerald-500/10', 'text-emerald-600', 'dark:text-emerald-400');
        btn.style.transform = '';
        btn.style.transition = '';

        if (currentIcon && origIconHtml) {
          currentIcon.outerHTML = origIconHtml;
        }

        const restoredIcon = btn.querySelector('.btn-icon') as HTMLElement;
        requestAnimationFrame(() => {
          if (textEl) {
            textEl.style.opacity = '1';
            textEl.style.transform = 'translateY(0px)';
            textEl.style.filter = 'blur(0px)';
          }
          if (restoredIcon) {
            restoredIcon.style.opacity = '1';
            restoredIcon.style.transform = 'scale(1)';
          }
        });

        setTimeout(() => {
          btn.classList.remove('is-animating');
        }, 150);
      }, 120);
    }, 1600);
  }

  function initCraftPage() {
    document.querySelectorAll(".copy-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const code = btn.getAttribute("data-copy");
        if (!code) return;

        navigator.clipboard.writeText(code).then(() => {
          animateButtonSuccess(btn as HTMLElement, "¡Copiado!");
        });
      });
    });

    const toggleBtn = document.getElementById("toggle-code-btn");
    const toggleLabel = document.getElementById("toggle-code-label");
    const codeDrawer = document.getElementById("code-drawer");
    const codeDisplay = document.getElementById("code-display");
    const drawerCopy = document.getElementById("drawer-copy-active");

    if (toggleBtn && codeDrawer && toggleLabel) {
      toggleBtn.addEventListener("click", () => {
        const isHidden = codeDrawer.classList.contains("hidden");
        if (isHidden) {
          codeDrawer.classList.remove("hidden");
          toggleLabel.textContent = "Ocultar código";
        } else {
          codeDrawer.classList.add("hidden");
          toggleLabel.textContent = "Ver código";
        }
      });
    }

    // Code drawer tabs switching
    document.querySelectorAll(".code-tab-btn").forEach((tabBtn) => {
      tabBtn.addEventListener("click", () => {
        const tab = tabBtn.getAttribute("data-tab");
        if (!tab || !snippets[tab as keyof typeof snippets] || !codeDisplay) return;
        activeTab = tab;

        document.querySelectorAll(".code-tab-btn").forEach((b) => {
          b.classList.remove("bg-zinc-800", "text-zinc-100", "font-medium");
          b.classList.add("text-zinc-400");
        });
        tabBtn.classList.add("bg-zinc-800", "text-zinc-100", "font-medium");
        tabBtn.classList.remove("text-zinc-400");

        codeDisplay.textContent = snippets[tab as keyof typeof snippets];
      });
    });

    if (drawerCopy && codeDisplay) {
      drawerCopy.addEventListener("click", () => {
        const currentCode = snippets[activeTab as keyof typeof snippets] || codeDisplay.textContent;
        if (!currentCode) return;
        navigator.clipboard.writeText(currentCode).then(() => {
          animateButtonSuccess(drawerCopy as HTMLElement, "¡Copiado!");
        });
      });
    }
  }

  initCraftPage();
  document.addEventListener('astro:after-swap', initCraftPage);
</script>
