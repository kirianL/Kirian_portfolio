                    </svg>
                    <span>Copiar</span>
                  </button>
                </div>
              </div>
              <pre class="p-4 overflow-x-auto text-zinc-300 max-h-72 leading-relaxed selection:bg-accent-9/30"><code id="code-content">{astroCode}</code></pre>
            </div>
          </div>
                <!-- Craft Item 2: More Experiments Minimalist Card -->
        <article class="rounded-xl border border-dashed border-grayscale-3/70 dark:border-grayscale-3/30 bg-grayscale-1/30 dark:bg-grayscale-2/10 p-5 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 transition-colors">
          <div class="flex flex-col gap-1">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-grayscale-10 animate-pulse"></span>
              <h3 class="text-xs font-semibold text-grayscale-12 tracking-tight">
                Más Experimentos Próximamente
              </h3>
            </div>
            <p class="text-[11px] text-grayscale-11 leading-normal">
              Construyendo navegación magnética líquida y física generativa en canvas.
            </p>
          </div>
          <span class="font-mono text-[10px] text-grayscale-10 tracking-tight shrink-0">
            En Desarrollo
          </span>
        </article>
      </section>

      <!-- Footer -->
      <Footer />
    </div>

    <!-- Floating Toast Notification -->
    <div
      id="copy-toast"
      class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 pointer-events-none opacity-0 translate-y-3 transition-all duration-300 ease-out flex items-center gap-2 px-3.5 py-2 rounded-full bg-zinc-900 text-zinc-100 dark:bg-zinc-100 dark:text-zinc-900 text-xs font-medium shadow-lg border border-white/10 dark:border-black/10 select-none"
    >
      <svg class="w-3.5 h-3.5 text-emerald-400 dark:text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
      <span id="copy-toast-text">¡Copiado al portapapeles!</span>
    </div>
  </main>
</Layout>

<script data-astro-code={astroCode} data-react-code={reactCode} data-usage-code={usageCode}>
  // Toast Notification
  const toast = document.getElementById("copy-toast");
  const toastText = document.getElementById("copy-toast-text");
  let toastTimeout: any;

  function showToast(message: string) {
    if (!toast || !toastText) return;
    toastText.textContent = message;
    toast.classList.remove("opacity-0", "translate-y-3", "pointer-events-none");
    toast.classList.add("opacity-100", "translate-y-0");

    clearTimeout(toastTimeout);
    toastTimeout = setTimeout(() => {
      toast.classList.remove("opacity-100", "translate-y-0");
      toast.classList.add("opacity-0", "translate-y-3", "pointer-events-none");
    }, 2200);
  }

  // Copy Buttons
  document.querySelectorAll(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const code = btn.getAttribute("data-copy");
      const label = btn.getAttribute("data-label") || "Código";
      if (!code) return;

      navigator.clipboard.writeText(code).then(() => {
        showToast(`¡${label} copiado al portapapeles!`);
      });
    });
  });

  // Slider controls for live preview
  const sliderSpread = document.getElementById("slider-spread") as HTMLInputElement;
  const sliderArc = document.getElementById("slider-arc") as HTMLInputElement;
  const valSpread = document.getElementById("val-spread");
  const valArc = document.getElementById("val-arc");

  if (sliderSpread && sliderArc) {
    const updatePreview = () => {
      const spread = parseInt(sliderSpread.value, 10);
      const arc = parseInt(sliderArc.value, 10);
      if (valSpread) valSpread.textContent = `${spread}px`;
      if (valArc) valArc.textContent = `${arc}°`;

      window.dispatchEvent(
        new CustomEvent("card-stamp-arc-params-change", {
          detail: { spread, arc }
        })
      );
    };

    sliderSpread.addEventListener("input", updatePreview);
    sliderArc.addEventListener("input", updatePreview);
  }

  // Drawer & Tabbed Code Switcher
  const toggleBtn = document.getElementById("toggle-code-btn");
  const toggleLabel = document.getElementById("toggle-code-label");
  const codeDrawer = document.getElementById("code-drawer");
  const codeContent = document.getElementById("code-content");
  const drawerFileName = document.getElementById("drawer-file-name");
  const drawerCopyBtn = document.getElementById("drawer-copy-btn");

  const currentScript = document.querySelector('script[data-astro-code]');
  const astroCodeStr = currentScript?.getAttribute('data-astro-code') || '';
  const reactCodeStr = currentScript?.getAttribute('data-react-code') || '';
  const usageCodeStr = currentScript?.getAttribute('data-usage-code') || '';

  let currentTab = 'astro';

  const updateDrawerCode = (tab: string) => {
    currentTab = tab;
    if (!codeContent || !drawerFileName) return;

    if (tab === 'astro') {
      codeContent.textContent = astroCodeStr;
      drawerFileName.textContent = 'CardStampArc.astro';
    } else if (tab === 'react') {
      codeContent.textContent = reactCodeStr;
      drawerFileName.textContent = 'CardStampArc.tsx';
    } else if (tab === 'usage') {
      codeContent.textContent = usageCodeStr;
      drawerFileName.textContent = 'UsoEjemplo.astro';
    }
  };

  document.querySelectorAll('.tab-btn').forEach((tabBtn) => {
    tabBtn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('bg-zinc-800', 'text-white');
        b.classList.add('text-zinc-400');
      });
      tabBtn.classList.remove('text-zinc-400');
      tabBtn.classList.add('bg-zinc-800', 'text-white');
      
      const tab = tabBtn.getAttribute('data-tab') || 'astro';
      updateDrawerCode(tab);
    });
  });

  if (drawerCopyBtn) {
    drawerCopyBtn.addEventListener('click', () => {
      const activeCode = currentTab === 'astro' ? astroCodeStr : currentTab === 'react' ? reactCodeStr : usageCodeStr;
      navigator.clipboard.writeText(activeCode).then(() => {
        showToast(`¡Código copiado al portapapeles!`);
      });
    });
  }

  if (toggleBtn && codeDrawer && toggleLabel) {
    toggleBtn.addEventListener("click", () => {
      const isHidden = codeDrawer.classList.contains("hidden");
      if (isHidden) {
        codeDrawer.classList.remove("hidden");
        toggleLabel.textContent = "Ocultar Código";
      } else {
        codeDrawer.classList.add("hidden");
        toggleLabel.textContent = "Ver Código";
      }
    });
  }
</script>
