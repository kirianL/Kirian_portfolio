---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';

import { getCollection } from 'astro:content';

// Localized blog content
const title = "Blog";
const description = "Compartiendo ideas sobre diseño, ingeniería y rendimiento web.";

// Fetch Spanish posts from Content Collection
const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(post => post.id.startsWith('es/'))
  .map(post => ({
    title: post.data.title,
    description: post.data.description,
    date: post.data.date,
    category: post.data.category,
    image: post.data.image,
    link: `/es/blog/${post.id.replace(/^es\//, '')}/`
  }));
---

<Layout 
  title="Blog | Kirian Luna Quirós" 
  description={description}
  lang="es"
>
  <Navbar />
  
  <main class="min-h-screen bg-grayscale-1 px-4 sm:px-0">
    <div class="max-w-xl mx-auto md:px-0 px-4 pt-28 pb-16 flex flex-col gap-12">
      
      <!-- Page Header -->
      <header class="flex flex-col gap-y-4">
        <h1 class="text-grayscale-12 font-semibold tracking-tight text-xl">
          {title}
        </h1>
        <p class="text-grayscale-11 text-sm leading-relaxed max-w-md">
          {description}
        </p>
      </header>

      <!-- Blog Posts List -->
      <section class="flex flex-col gap-6">
        {posts.map((post) => (
          <a href={post.link} class="group flex flex-col gap-3.5 p-3 rounded-xl bg-white dark:bg-grayscale-2 border border-grayscale-3 dark:border-grayscale-3/40 hover:border-grayscale-4 dark:hover:border-grayscale-4/60 transition-all duration-200 shadow-xs">
            <div class="w-full aspect-[16/9] overflow-hidden rounded-lg bg-grayscale-2 border border-grayscale-3 dark:border-grayscale-3/50">
              <img 
                src={post.image} 
                alt={post.title} 
                class="w-full h-full object-cover group-hover:scale-[1.01] transition-transform duration-500 ease-out" 
                loading="lazy"
              />
            </div>
            <div class="flex flex-col gap-1 px-1 py-0.5">
              <div class="flex items-center justify-between text-[10px] font-mono text-grayscale-10">
                <span>{post.date}</span>
                <span class="px-2.5 py-0.5 bg-grayscale-3 text-grayscale-11 rounded-full font-medium text-[9px] shadow-3xs">{post.category}</span>
              </div>
              <h3 class="text-grayscale-12 font-semibold text-[13.5px] leading-tight group-hover:text-accent-9 transition-colors mt-2">
                {post.title}
              </h3>
              <p class="text-grayscale-11 text-[12.5px] leading-relaxed mt-1">
                {post.description}
              </p>
            </div>
          </a>
        ))}
      </section>

      <!-- Newsletter Section -->
      <section class="mt-4 p-5 rounded-xl bg-white dark:bg-grayscale-2 border border-grayscale-3 dark:border-grayscale-3/40 flex flex-col gap-4 shadow-xs">
        <h3 class="text-grayscale-12 font-semibold text-sm">Suscríbete al boletín</h3>
        <p class="text-grayscale-11 text-xs leading-relaxed">
          Recibe notificaciones cada vez que publique un nuevo artículo sobre diseño, ingeniería y rendimiento web. Sin spam, desactívalo en cualquier momento.
        </p>
        <form id="subscribe-form" class="flex flex-col sm:flex-row gap-2 mt-1">
          <input 
            type="email" 
            required 
            placeholder="tu@email.com" 
            class="flex-1 w-full px-3 py-2 text-xs rounded-lg border border-grayscale-3 bg-grayscale-1 text-grayscale-12 focus:outline-none focus:border-accent-9 transition-colors"
          />
          <button 
            type="submit" 
            class="w-full sm:w-auto px-4 py-2 text-xs bg-grayscale-12 text-grayscale-1 font-medium rounded-lg hover:opacity-90 active:scale-95 transition-all cursor-pointer"
          >
            Suscribirse
          </button>
        </form>
        <p id="subscribe-message" class="text-xs font-mono hidden"></p>
      </section>

      <script>
        const form = document.getElementById('subscribe-form') as HTMLFormElement;
        const message = document.getElementById('subscribe-message') as HTMLParagraphElement;

        form?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const emailInput = form.querySelector('input[type="email"]') as HTMLInputElement;
          const email = emailInput.value;
          
          const button = form.querySelector('button') as HTMLButtonElement;
          const originalText = button.textContent;
          button.disabled = true;
          button.textContent = 'Suscribiendo...';
          
          try {
            const res = await fetch('/api/subscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email, lang: 'es' })
            });
            const data = await res.json();
            
            if (res.ok) {
              message.textContent = '✓ ¡Suscrito con éxito!';
              message.className = 'text-xs font-mono text-green-600';
              form.reset();
            } else {
              message.textContent = `✗ ${data.error || 'Algo salió mal'}`;
              message.className = 'text-xs font-mono text-red-600';
            }
          } catch (err) {
            message.textContent = '✗ Error de conexión. Por favor intenta de nuevo.';
            message.className = 'text-xs font-mono text-red-600';
          } finally {
            button.disabled = false;
            button.textContent = originalText;
            message.classList.remove('hidden');
          }
        });
      </script>

      <!-- Footer -->
      <footer class="mt-6 text-center text-xs text-grayscale-10 font-mono border-t border-grayscale-3/40 dark:border-grayscale-3/20 pt-8">
        Made with &lt;3
      </footer>

    </div>
  </main>
</Layout>
