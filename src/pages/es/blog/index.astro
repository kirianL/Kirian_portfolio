---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { absoluteUrl, PERSON_ID } from '../../../lib/seo';

const title = "Blog | Kirian Luna";
const description = "Notas sobre interfaces rápidas, sistemas y software desde Limón.";

const categoryColors: Record<string, string> = {
  "Ingeniería UI": "text-violet-600 dark:text-violet-400",
  "Arquitectura": "text-sky-600 dark:text-sky-400",
  "Rendimiento": "text-amber-600 dark:text-amber-400",
  "Sistemas de Diseño": "text-orange-600 dark:text-orange-400",
  "Cultura / Diseño": "text-emerald-600 dark:text-emerald-400",
};

// Fetch Spanish posts from Content Collection
const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(post => post.id.startsWith('es/'))
  .map(post => {
    const rawBody = post.body || "";
    const wordCount = rawBody.trim().split(/\s+/).filter(Boolean).length;
    const readTime = `${Math.max(1, Math.ceil(wordCount / 200))} min de lectura`;

    const slug = post.id.replace(/^es\//, '');
    return {
      slug,
      title: post.data.title,
      description: post.data.description,
      date: post.data.date,
      category: post.data.category,
      image: post.data.image,
      readTime,
      link: `/es/blog/${slug}/`
    };
  })
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const blogItemList = {
  '@type': 'ItemList',
  '@id': absoluteUrl('/es/blog/#itemlist'),
  name: 'Artículos de Kirian Luna',
  numberOfItems: posts.length,
  itemListElement: posts.map((post, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'BlogPosting',
      headline: post.title,
      description: post.description,
      url: absoluteUrl(post.link),
      datePublished: new Date(post.date).toISOString(),
      articleSection: post.category,
      author: { '@id': PERSON_ID },
      inLanguage: 'es',
    },
  })),
};
---

<Layout 
  title={title}
  description={description}
  lang="es"
  pageType="CollectionPage"
  schema={blogItemList}
>
  <Navbar />
  
  <main id="main-content" class="bg-grayscale-1">
    <div class="max-w-2xl mx-auto px-4 sm:px-0 pt-24 sm:pt-28 pb-8 flex flex-col gap-8 sm:gap-10">
        
        <!-- Blog Header -->
        <header class="flex flex-col gap-2">
          <div class="flex items-baseline justify-between gap-4">
            <h1 class="font-figgle text-3xl text-grayscale-12 tracking-tight select-none">
              blog.
            </h1>
            <span class="text-[11px] font-mono tabular-nums text-grayscale-10">
              {posts.length} artículos
            </span>
          </div>
          <p class="text-grayscale-11 text-xs leading-normal">
            {description}
          </p>
        </header>

        <!-- Open Editorial Grid (no card boxes — images & type breathe on the canvas) -->
        <section class="grid grid-cols-1 sm:grid-cols-2 gap-x-7 gap-y-10 w-full">
          {posts.map((post, index) => {
            const catColor = categoryColors[post.category] ?? "text-grayscale-11";
            return (
            <article class="flex flex-col">
              <a 
                href={post.link} 
                data-astro-prefetch="viewport"
                data-cuelume-hover="tick" 
                data-cuelume-press="page" 
                data-cuelume-release="release"
                class="group flex flex-col gap-3.5 active:scale-[0.985] transition-transform duration-200 ease-[cubic-bezier(0.2,0,0,1)]"
              >
                <!-- Free 16:9 Artwork -->
                {post.image && (
                  <div
                    data-blog-cover={post.slug}
                    class="w-full aspect-video overflow-hidden rounded-xl bg-grayscale-2 outline-1 -outline-offset-1 outline-black/10 dark:outline-white/10 shadow-[0_2px_10px_-2px_rgba(0,0,0,0.06)] dark:shadow-[0_4px_16px_-4px_rgba(0,0,0,0.35)] group-hover:shadow-[0_10px_28px_-6px_rgba(0,0,0,0.12)] dark:group-hover:shadow-[0_10px_28px_-6px_rgba(0,0,0,0.5)] transition-shadow duration-300 ease-[cubic-bezier(0.2,0,0,1)]"
                  >
                    <img 
                      src={post.image} 
                      alt={post.title} 
                      width="1200"
                      height="675"
                      class="w-full h-full object-cover" 
                      loading={index < 2 ? "eager" : "lazy"}
                    />
                  </div>
                )}

                <!-- Editorial Text Block (directly on canvas) -->
                <div class="flex flex-col gap-1.5 px-0.5">
                  <div class="flex items-center justify-between gap-2 text-[11px] font-mono">
                    <span class:list={["font-medium tracking-tight", catColor]}>
                      {post.category}
                    </span>
                    <time class="text-grayscale-10 tabular-nums">{post.date}</time>
                  </div>

                  <h2 class="text-grayscale-12 font-medium text-[15px] leading-snug tracking-tight text-balance group-hover:text-grayscale-11 transition-colors duration-200">
                    {post.title}
                  </h2>

                  <p class="text-grayscale-11 text-xs leading-relaxed line-clamp-2">
                    {post.description}
                  </p>
                </div>
              </a>
            </article>
            );
          })}
        </section>

        <!-- Newsletter Section (Clean & Minimal) -->
        <section class="p-5 sm:p-6 rounded-2xl bg-grayscale-2/40 border border-grayscale-3/50 dark:border-grayscale-3/30 flex flex-col gap-3">
          <div class="flex flex-col gap-1">
            <h3 class="text-grayscale-12 font-medium text-sm tracking-tight">Boletín</h3>
            <p class="text-grayscale-11 text-xs leading-relaxed max-w-lg">
              Recibe notificaciones cuando publique un nuevo artículo sobre diseño, ingeniería y arquitectura web. Sin spam, puedes cancelar cuando quieras.
            </p>
          </div>

          <form id="subscribe-form" class="flex flex-col sm:flex-row gap-2 mt-1">
            <label for="subscribe-email" class="sr-only">Correo electrónico</label>
            <input 
              id="subscribe-email"
              type="email" 
              required 
              autocomplete="email"
              placeholder="tu@correo.com" 
              class="flex-1 w-full px-3.5 py-2 text-[16px] sm:text-xs rounded-lg border border-grayscale-3/70 bg-white dark:bg-grayscale-2 text-grayscale-12 placeholder:text-grayscale-9 focus-visible:outline-none focus:outline-none focus-visible:border-grayscale-6 dark:focus-visible:border-grayscale-6 transition-colors"
            />
            <button 
              type="submit" 
              data-cuelume-hover="tick"
              data-cuelume-press="scan"
              class="w-full sm:w-auto px-4 py-2 text-xs bg-grayscale-12 text-grayscale-1 font-medium rounded-lg hover:opacity-90 active:scale-[0.96] transition-[opacity,transform] cursor-pointer select-none shrink-0"
            >
              Suscribirme
            </button>
          </form>
          <p id="subscribe-message" role="status" aria-live="polite" class="text-xs font-mono hidden"></p>
        </section>

        <!-- Footer -->
        <Footer />
      </div>
    </main>
</Layout>

<script>
  const setupNewsletterForm = () => {
    const form = document.getElementById('subscribe-form') as HTMLFormElement | null;
    const message = document.getElementById('subscribe-message') as HTMLParagraphElement | null;
    if (!form || !message || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = form.querySelector('input[type="email"]') as HTMLInputElement;
      const email = emailInput ? emailInput.value : '';
      const button = form.querySelector('button') as HTMLButtonElement;
      const originalText = button ? button.textContent : 'Suscribirme';
      if (button) {
        button.disabled = true;
        button.textContent = '...';
      }

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, lang: 'es' })
        });
        const data = await res.json();

        if (res.ok) {
          message.textContent = '✓ ¡Suscrito con éxito!';
          message.className = 'text-xs font-mono text-emerald-600 dark:text-emerald-400';
          form.reset();
        } else {
          message.textContent = `✗ ${data.error || 'Algo salió mal'}`;
          message.className = 'text-xs font-mono text-red-600 dark:text-red-400';
        }
      } catch (err) {
        message.textContent = '✗ Error de conexión. Por favor intenta de nuevo.';
        message.className = 'text-xs font-mono text-red-600 dark:text-red-400';
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = originalText;
        }
        message.classList.remove('hidden');
      }
    });
  };

  setupNewsletterForm();
  document.addEventListener('astro:page-load', setupNewsletterForm);
</script>
