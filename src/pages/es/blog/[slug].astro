---
import { getCollection, render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import BlogTOC from "../../../components/blog/BlogTOC.astro";
import BlogReactions from "../../../components/blog/BlogReactions.astro";
import ScrollRuler from "../../../components/blog/ScrollRuler.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const esPosts = posts.filter((post) => post.id.startsWith("es/"));

  return esPosts.map((post) => {
    const slug = post.id.replace(/^es\//, "");
    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Exact reading time in Spanish
const rawBody = post.body || "";
const wordCount = rawBody.trim().split(/\s+/).filter(Boolean).length;
const readTime = `${Math.max(1, Math.ceil(wordCount / 200))} min de lectura`;
---

<Layout
  title={`${post.data.title} | Kirian Luna`}
  description={post.data.description}
  lang="es"
  image={post.data.image}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.description,
    "image": new URL(post.data.image, Astro.site || Astro.url.origin).href,
    "datePublished": post.data.date,
    "author": {
      "@type": "Person",
      "name": "Kirian Luna",
      "url": "https://kirian.dev"
    },
    "publisher": {
      "@type": "Person",
      "name": "Kirian Luna",
      "url": "https://kirian.dev"
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": new URL(Astro.url.pathname, Astro.site || Astro.url.origin).href
    }
  })} />

  <Navbar />

  <!-- Atmospheric Editorial Scroll Vignettes -->
  <div class="blog-vignette-top"></div>
  <div class="blog-vignette-bottom"></div>

  <!-- Vertical Scroll Progress Ruler -->
  <ScrollRuler />

  <main class="min-h-screen bg-grayscale-1 px-4 sm:px-6 lg:px-8 py-10 md:py-16 pt-24 md:pt-28">
    <div class="max-w-7xl mx-auto">
      
      <!-- Minimalist Symmetrically Centered Layout -->
      <div class="flex flex-col lg:flex-row justify-center items-start gap-8 xl:gap-14">
        
        <!-- LEFT SIDEBAR: Navigation & TOC (Sticky Desktop) -->
        <aside class="hidden lg:flex flex-col w-56 xl:w-64 shrink-0 sticky top-28 h-fit gap-8 self-start">
          <a
            href="/es/blog/"
            data-cuelume-press
            data-cuelume-release
            class="group inline-flex items-center gap-1.5 font-mono text-xs text-grayscale-11 hover:text-accent-9 transition-colors w-fit"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-0.5 transition-transform">
              <path d="m15 18-6-6 6-6"/>
            </svg>
            Volver al blog
          </a>

          <!-- Restored & Polished Numbered Table of Contents -->
          <BlogTOC headings={headings} lang="es" />
        </aside>

        <!-- CENTER COLUMN: Airy, Open, Perfectly Centered Article Canvas -->
        <div class="w-full max-w-2xl xl:max-w-3xl flex flex-col gap-10 min-w-0">
          
          <!-- Mobile Back Link -->
          <a href="/es/blog/" class="lg:hidden flex items-center gap-1.5 font-mono text-xs text-grayscale-11 hover:text-accent-9 transition-colors w-fit">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m15 18-6-6 6-6"/>
            </svg>
            Volver al blog
          </a>

          <!-- Article Header -->
          <header class="flex flex-col gap-3">
            <div class="flex items-center justify-between text-xs font-mono text-grayscale-10">
              <div class="flex items-center gap-2">
                <span>{post.data.date}</span>
                <span>·</span>
                <span>{readTime}</span>
              </div>
              <span class="px-2.5 py-0.5 bg-grayscale-3 dark:bg-grayscale-3/50 text-grayscale-11 rounded-full text-[10px] font-mono">
                {post.data.category}
              </span>
            </div>

            <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-grayscale-12 leading-snug font-sans mt-2">
              {post.data.title}
            </h1>

            <p class="text-base text-grayscale-11 leading-relaxed font-normal mt-1">
              {post.data.description}
            </p>
          </header>

          <!-- Cover Image (Clean, Minimalist, Natural) -->
          <div class="w-full overflow-hidden rounded-xl bg-grayscale-2 border border-grayscale-3/60 dark:border-grayscale-3/40">
            <img 
              src={post.data.image} 
              alt={post.data.title} 
              class="w-full h-auto object-cover max-h-[460px]" 
            />
          </div>

          <!-- Article Prose Body -->
          <article class="prose max-w-full">
            <Content />
          </article>

          <!-- Mobile Only: Reactions & Author Box -->
          <div class="lg:hidden flex flex-col gap-6 pt-6 border-t border-grayscale-3/60 dark:border-grayscale-3/40">
            <div class="flex items-center gap-3">
              <img src="/LogoKirian.png" alt="Kirian Luna" class="w-9 h-9 sm:w-10 sm:h-10 aspect-square object-contain dark:invert shrink-0" />
              <div class="flex flex-col">
                <span class="text-xs font-medium text-grayscale-12">Kirian Luna</span>
                <span class="text-[11px] text-grayscale-10 font-mono">Ingeniero de Software & Diseñador</span>
              </div>
            </div>

            <div class="flex flex-col gap-2">
              <span class="text-[11px] font-mono uppercase tracking-wider text-grayscale-10">Reacciones</span>
              <BlogReactions slug={Astro.params.slug!} lang="es" />
            </div>
          </div>

          <!-- Minimalist Newsletter Box -->
          <section class="mt-4 p-6 rounded-xl border border-grayscale-3/60 dark:border-grayscale-3/40 bg-grayscale-2/30 dark:bg-grayscale-2/20 flex flex-col gap-3">
            <h3 class="text-grayscale-12 font-medium text-sm">Suscríbete al boletín</h3>
            <p class="text-grayscale-11 text-xs leading-relaxed">
              Recibe notificaciones cuando publique nuevos artículos sobre diseño, ingeniería y rendimiento web. Cero spam, cancela cuando quieras.
            </p>
            <form id="subscribe-form" class="flex flex-col sm:flex-row gap-2 mt-1">
              <input 
                type="email" 
                required 
                placeholder="tu@email.com" 
                class="flex-1 w-full px-3 py-2 text-xs rounded-lg border border-grayscale-3 bg-white dark:bg-black/20 text-grayscale-12 focus:outline-none focus:border-accent-9 transition-colors font-mono"
              />
              <button 
                type="submit" 
                data-cuelume-press
                data-cuelume-release
                class="w-full sm:w-auto px-4 py-2 text-xs bg-grayscale-12 text-grayscale-1 font-mono uppercase font-medium rounded-lg hover:opacity-90 active:scale-95 transition-all cursor-pointer"
              >
                Suscribirse
              </button>
            </form>
            <p id="subscribe-message" class="text-xs font-mono hidden"></p>
          </section>

          <!-- Footer -->
          <Footer />

        </div>

        <!-- RIGHT SIDEBAR: Author & Reactions (Sticky Desktop) -->
        <aside class="hidden lg:flex flex-col w-56 xl:w-64 shrink-0 sticky top-28 h-fit gap-8 self-start">
          
          <!-- Author -->
          <div class="flex flex-col gap-2.5">
            <span class="text-[11px] font-mono uppercase tracking-wider text-grayscale-10">Autor</span>
            <div class="flex items-center gap-3">
              <img src="/LogoKirian.png" alt="Kirian Luna" class="w-9 h-9 sm:w-10 sm:h-10 aspect-square object-contain dark:invert shrink-0" />
              <div class="flex flex-col min-w-0">
                <span class="text-xs font-medium text-grayscale-12 truncate">Kirian Luna</span>
                <span class="text-[11px] font-mono text-grayscale-10 truncate">Ingeniero & Diseñador</span>
              </div>
            </div>
          </div>

          <!-- Reactions (Pixel-art hand gestures) -->
          <div class="flex flex-col gap-2.5">
            <span class="text-[11px] font-mono uppercase tracking-wider text-grayscale-10">Reacciones</span>
            <BlogReactions slug={Astro.params.slug!} lang="es" />
          </div>

        </aside>

      </div>
    </div>
  </main>
</Layout>

<script>
  import { play } from "cuelume";

  // Newsletter subscription handler
  const setupNewsletter = () => {
    const form = document.getElementById('subscribe-form') as HTMLFormElement;
    const message = document.getElementById('subscribe-message') as HTMLParagraphElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = form.querySelector('input[type="email"]') as HTMLInputElement;
      const email = emailInput?.value;
      
      const button = form.querySelector('button') as HTMLButtonElement;
      const originalText = button.textContent;
      button.disabled = true;
      button.textContent = 'Suscribiendo...';
      
      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, lang: 'es' })
        });
        const data = await res.json();
        
        if (res.ok) {
          play("success");
          message.textContent = '✓ ¡Suscripción confirmada!';
          message.className = 'text-xs font-mono text-green-600 block mt-1';
          form.reset();
        } else {
          play("error");
          message.textContent = `✗ ${data.error || 'Algo salió mal'}`;
          message.className = 'text-xs font-mono text-red-600 block mt-1';
        }
      } catch (err) {
        play("error");
        message.textContent = '✗ Error de conexión. Inténtalo de nuevo.';
        message.className = 'text-xs font-mono text-red-600 block mt-1';
      } finally {
        button.disabled = false;
        button.textContent = originalText;
        message.classList.remove('hidden');
      }
    });
  };

  // Setup external links safely
  const setupLinks = () => {
    const links = document.querySelectorAll('article.prose a');
    links.forEach(link => {
      if (link.getAttribute('href')?.startsWith('http')) {
        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'noopener noreferrer');
      }
    });
  };

  setupNewsletter();
  setupLinks();

  document.addEventListener('astro:page-load', () => {
    setupNewsletter();
    setupLinks();
  });
  document.addEventListener('astro:after-swap', () => {
    setupNewsletter();
    setupLinks();
  });
</script>

<style is:global>
  /* Markdown styling scoped to the article */
  article.prose a {
    color: var(--color-accent-9);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
    transition: color 0.15s ease;
  }
  article.prose a:hover {
    color: var(--color-accent-10);
  }
  article.prose hr {
    border: none;
    text-align: center;
    margin: 3rem 0;
  }
  article.prose hr::after {
    content: "···";
    letter-spacing: 0.8em;
    color: var(--color-grayscale-10);
    font-size: 1.25rem;
    font-weight: bold;
  }
  article.prose h2 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-grayscale-12);
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
    line-height: 1.35;
  }
  article.prose h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-grayscale-12);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }
  article.prose p {
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--color-grayscale-11);
    margin-bottom: 1.35rem;
  }

  /* Modern Editorial Pull-Quotes with Quotation Mark */
  article.prose blockquote {
    position: relative;
    margin: 3.5rem 0;
    padding: 0.5rem 0 0.5rem 2.5rem;
    border: none;
  }
  article.prose blockquote::before {
    content: "“";
    position: absolute;
    left: 0;
    top: -0.6rem;
    font-family: 'Newsreader', Georgia, serif;
    font-size: 3.75rem;
    line-height: 1;
    color: var(--color-grayscale-8);
    font-style: normal;
    pointer-events: none;
    user-select: none;
  }
  article.prose blockquote p {
    font-family: 'Newsreader', Georgia, serif;
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.55;
    color: var(--color-grayscale-12);
    letter-spacing: -0.015em;
    margin: 0;
  }
  @media (min-width: 640px) {
    article.prose blockquote {
      margin: 4.5rem 0;
      padding-left: 3.25rem;
    }
    article.prose blockquote::before {
      font-size: 4.75rem;
      top: -0.85rem;
    }
    article.prose blockquote p {
      font-size: 1.45rem;
      line-height: 1.5;
    }
  }

  article.prose code {
    font-family: var(--font-jetbrains-mono, monospace);
    font-size: 0.8125rem;
    background-color: var(--color-grayscale-2);
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    border: 1px solid var(--color-grayscale-3);
  }
  article.prose pre {
    background-color: var(--color-grayscale-2);
    border: 1px solid var(--color-grayscale-3);
    padding: 1.25rem;
    border-radius: 10px;
    overflow-x: auto;
    margin: 1.75rem 0;
  }
  article.prose pre code {
    background-color: transparent;
    padding: 0;
    border: none;
  }
  article.prose ul {
    list-style-type: disc;
    padding-left: 1.35rem;
    margin-bottom: 1.35rem;
    color: var(--color-grayscale-11);
    font-size: 0.9375rem;
    line-height: 1.7;
  }
  article.prose li {
    margin-bottom: 0.5rem;
  }
  article.prose table {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.8125rem;
    font-family: var(--font-jetbrains-mono, monospace);
    -webkit-overflow-scrolling: touch;
  }
  article.prose th, article.prose td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-grayscale-3);
    text-align: left;
    white-space: nowrap;
  }
  article.prose th {
    font-weight: 600;
    color: var(--color-grayscale-12);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    background-color: var(--color-grayscale-2);
  }
</style>
