---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Projects from "../../components/Projects.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
  title="Proyectos | Kirian Luna"
  description="Herramientas, APIs y productos construidos o mantenidos por Kirian Luna."
  lang="es"
>
  <Navbar />

  <main class="min-h-screen bg-grayscale-1">
    <div class="max-w-2xl mx-auto px-6 sm:px-0 pt-28 pb-16">
      <div class="flex flex-col gap-10">
        <!-- Interactive Projects Component (Handles Title, Subtitle, and Filters adaptively) -->
        <Projects />

        <!-- Footer -->
        <Footer />
      </div>
    </div>
  </main>
</Layout>
