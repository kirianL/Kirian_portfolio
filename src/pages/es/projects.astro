---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Projects from "../../components/Projects.astro";
---

<Layout
  title="Proyectos | Kirian Luna Quirós"
  description="Herramientas, APIs y productos construidos o mantenidos por Kirian Luna Quirós."
  lang="es"
>
  <Navbar />

  <main class="max-w-xl mx-auto px-4 sm:px-0 pt-28 pb-16">
    <div class="flex flex-col gap-10">
      <!-- Interactive Projects Component (Handles Title, Subtitle, and Filters adaptively) -->
      <Projects />

      <!-- Footer -->
      <footer
        class="mt-6 text-center text-xs text-grayscale-10 font-mono border-t border-grayscale-3/40 dark:border-grayscale-3/20 pt-8"
      >
        Made with &lt;3
      </footer>
    </div>
  </main>
</Layout>
