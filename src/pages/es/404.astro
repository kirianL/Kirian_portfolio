---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
  title="404 — Página no encontrada | Kirian Luna"
  description="La página solicitada no pudo ser encontrada. Explora los enlaces de navegación para conocer proyectos, artículos o contactarme."
  lang="es"
>
  <Navbar />

  <main id="main-content" class="bg-grayscale-1">
    <div class="max-w-2xl mx-auto px-6 sm:px-0 pt-32 pb-12 flex flex-col gap-10">
      <div class="flex flex-col gap-3">
        <span class="font-mono text-xs text-accent-10 font-semibold tracking-wider uppercase">Error 404</span>
        <h1 class="font-figgle text-4xl text-grayscale-12 tracking-tight select-none">
          página no encontrada.
        </h1>
        <p class="text-grayscale-11 text-sm leading-relaxed max-w-lg mt-1">
          El recurso solicitado ha cambiado de ubicación, ha sido renombrado o no existe en este dominio. Puedes utilizar los siguientes accesos para continuar navegando:
        </p>
      </div>

      <!-- Navigation Directory -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <a
          href="/es/"
          data-cuelume-hover="tick"
          data-cuelume-press="page"
          class="p-4 rounded-xl border border-grayscale-3 dark:border-grayscale-3/40 bg-white dark:bg-grayscale-2/30 hover:border-grayscale-4 dark:hover:border-grayscale-4/60 transition-all flex flex-col gap-1 group shadow-3xs"
        >
          <span class="text-xs font-semibold text-grayscale-12 group-hover:text-accent-9 transition-colors flex items-center justify-between">
            Inicio / Portafolio
            <span class="text-grayscale-9 group-hover:translate-x-0.5 transition-transform">→</span>
          </span>
          <span class="text-[11px] text-grayscale-10">Volver a la vista principal del portafolio.</span>
        </a>

        <a
          href="/es/about"
          data-cuelume-hover="tick"
          data-cuelume-press="page"
          class="p-4 rounded-xl border border-grayscale-3 dark:border-grayscale-3/40 bg-white dark:bg-grayscale-2/30 hover:border-grayscale-4 dark:hover:border-grayscale-4/60 transition-all flex flex-col gap-1 group shadow-3xs"
        >
          <span class="text-xs font-semibold text-grayscale-12 group-hover:text-accent-9 transition-colors flex items-center justify-between">
            Sobre Kirian
            <span class="text-grayscale-9 group-hover:translate-x-0.5 transition-transform">→</span>
          </span>
          <span class="text-[11px] text-grayscale-10">Trayectoria, filosofía técnica y servicios.</span>
        </a>

        <a
          href="/es/projects"
          data-cuelume-hover="tick"
          data-cuelume-press="page"
          class="p-4 rounded-xl border border-grayscale-3 dark:border-grayscale-3/40 bg-white dark:bg-grayscale-2/30 hover:border-grayscale-4 dark:hover:border-grayscale-4/60 transition-all flex flex-col gap-1 group shadow-3xs"
        >
          <span class="text-xs font-semibold text-grayscale-12 group-hover:text-accent-9 transition-colors flex items-center justify-between">
            Proyectos Destacados
            <span class="text-grayscale-9 group-hover:translate-x-0.5 transition-transform">→</span>
          </span>
          <span class="text-[11px] text-grayscale-10">Aplicaciones en producción y código abierto.</span>
        </a>

        <a
          href="/es/contact"
          data-cuelume-hover="tick"
          data-cuelume-press="page"
          class="p-4 rounded-xl border border-grayscale-3 dark:border-grayscale-3/40 bg-white dark:bg-grayscale-2/30 hover:border-grayscale-4 dark:hover:border-grayscale-4/60 transition-all flex flex-col gap-1 group shadow-3xs"
        >
          <span class="text-xs font-semibold text-grayscale-12 group-hover:text-accent-9 transition-colors flex items-center justify-between">
            Contacto Directo
            <span class="text-grayscale-9 group-hover:translate-x-0.5 transition-transform">→</span>
          </span>
          <span class="text-[11px] text-grayscale-10">Formulario, correo y redes profesionales.</span>
        </a>
      </div>

      <!-- Agent / Machine index links -->
      <div class="pt-4 border-t border-grayscale-3/50 dark:border-grayscale-3/25 flex flex-wrap gap-4 text-xs font-mono text-grayscale-10">
        <a href="/llms.txt" class="hover:text-grayscale-12 underline underline-offset-4">llms.txt</a>
        <a href="/llms-full.txt" class="hover:text-grayscale-12 underline underline-offset-4">llms-full.txt</a>
        <a href="/sitemap-index.xml" class="hover:text-grayscale-12 underline underline-offset-4">sitemap.xml</a>
      </div>

      <Footer />
    </div>
  </main>
</Layout>
