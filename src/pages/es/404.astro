---
import Layout from "../../layouts/Layout.astro";

const currentYear = new Date().getFullYear();
---

<Layout
  title="Página no encontrada – Kirian Luna"
  description="No hay nada aquí. Puede que la página se haya movido o que la dirección contenga un error tipográfico."
  lang="es"
>
  <main id="main-content" class="bg-grayscale-1">
    <div class="max-w-2xl mx-auto px-6 py-12 sm:py-24">
      <!-- Header -->
      <header class="flex flex-col items-start gap-5 pb-6">
        <a 
          href="/es/" 
          data-cuelume-hover="tick"
          data-cuelume-press="page"
          class="inline-flex items-center gap-1.5 text-xs text-grayscale-11 hover:text-grayscale-12 transition-colors group"
        >
          <svg 
            xmlns="http://www.w3.org/2000/svg" 
            width="16" 
            height="16" 
            viewBox="0 0 24 24" 
            fill="none" 
            stroke="currentColor" 
            stroke-width="2" 
            stroke-linecap="round" 
            stroke-linejoin="round" 
            class="w-4 h-4 text-grayscale-10 group-hover:text-grayscale-12 group-hover:-translate-x-0.5 transition-all"
            aria-hidden="true"
          >
            <path d="m12 19-7-7 7-7"></path>
            <path d="M19 12H5"></path>
          </svg>
          Inicio
        </a>

        <h1 class="text-grayscale-12 font-medium text-base leading-relaxed">
          Página no encontrada
        </h1>

        <p class="text-xs text-grayscale-11 leading-relaxed">
          No hay nada en <code id="missing-path" class="font-mono text-grayscale-12 break-all">/404</code>. Puede que la página se haya movido o que la dirección contenga un error tipográfico.
        </p>
      </header>

      <!-- Minimal Left-Aligned Footer matching Alexandre Joly 404 -->
      <footer class="pt-8 flex flex-col gap-2.5 text-xs text-grayscale-10 font-mono">
        <p class="leading-relaxed">
          © {currentYear} Kirian Luna · <a href="/es/about" data-cuelume-hover="tick" class="underline underline-offset-2 hover:text-grayscale-12 transition-colors">Sobre mí</a> · <a href="/es/contact" data-cuelume-hover="tick" class="underline underline-offset-2 hover:text-grayscale-12 transition-colors">Contacto</a> · <a href="/es/privacy" data-cuelume-hover="tick" class="underline underline-offset-2 hover:text-grayscale-12 transition-colors">Privacidad</a>
        </p>

        <ul class="flex flex-wrap items-center gap-x-3 gap-y-1 list-none p-0 m-0">
          <li class="flex items-center gap-1">
            <span class="text-grayscale-12 font-medium">100</span>
            <a 
              href="https://is-agentic.com/scan/kirian.dev" 
              target="_blank" 
              rel="noopener noreferrer" 
              data-cuelume-hover="tick"
              title="Agent readiness 100/100"
              class="underline underline-offset-2 decoration-grayscale-4 hover:decoration-grayscale-11 text-grayscale-11 hover:text-grayscale-12 transition-colors"
            >
              Is Agentic
            </a>
          </li>
          <li class="select-none text-grayscale-5">·</li>
          <li class="flex items-center gap-1">
            <span class="text-grayscale-12 font-medium">100</span>
            <a 
              href="https://pagespeed.web.dev/analysis?url=https%3A%2F%2Fkirian.dev%2F&form_factor=mobile" 
              target="_blank" 
              rel="noopener noreferrer" 
              data-cuelume-hover="tick"
              title="Google Lighthouse 100"
              class="underline underline-offset-2 decoration-grayscale-4 hover:decoration-grayscale-11 text-grayscale-11 hover:text-grayscale-12 transition-colors"
            >
              Lighthouse
            </a>
          </li>
        </ul>
      </footer>
    </div>
  </main>
</Layout>

<script is:inline>
  function update404Path() {
    if (typeof window !== 'undefined') {
      const pathEl = document.getElementById('missing-path');
      if (pathEl && window.location.pathname) {
        pathEl.textContent = window.location.pathname;
      }
    }
  }

  update404Path();
  document.addEventListener('astro:page-load', update404Path);
</script>
