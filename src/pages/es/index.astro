---
import Layout from "../../layouts/Layout.astro";
import RedDitherBanner from "../../components/hero/RedDitherBanner.astro";
import CentralHero from "../../components/hero/CentralHero.astro";
import { dictionaries } from "../../data/data";
import { professionalServiceSchema } from "../../lib/seo";

const data = dictionaries.ES;
---

<Layout
  title="Kirian Luna | Ingeniero de Software"
  description="Portafolio profesional de Kirian Luna, Ingeniero de Software basado en Costa Rica. Especialista en React, Next.js, Astro y desarrollo full-stack moderno."
  lang="es"
  loadSerifFonts={true}
  pageType="ProfilePage"
  schema={professionalServiceSchema}
>
  <main id="main-content" class="relative min-h-[100dvh] w-full bg-[#0a0a0a] text-[#f5f5f5] flex flex-col justify-center items-center pt-[22dvh] pb-10 overflow-hidden">
    <RedDitherBanner />
    <CentralHero
      lang="ES"
      name={data.name}
      pronunciation="/ˈkiː.ɹi.ɑːn ˈluː.nɑː/"
      roles={["Ingeniero de Software", "Design Engineer"]}
      basedInLine="Basado en 🇨🇷 Limón, Costa Rica"
      socialLabel="twitter"
      socialUrl={data.contact.twitter}
      rolePrefix="Actualmente trabajando como ingeniero de software"
      companyName="UltimateMediaProductions"
      companyUrl="https://ultimatemediaproductions.com"
      lines={[
        "Graduado de Ingeniería en Sistemas por la Universidad Latina de Costa Rica.",
        "De Limón, Costa Rica, con más de 2 años de experiencia construyendo productos digitales y plataformas web.",
        "En los últimos años he desarrollado plataformas SaaS, APIs REST con RBAC e interfaces accesibles con TypeScript, React 19, Next.js, Astro y PostgreSQL.",
      ]}
      reachOutPrefix="Escríbeme a"
      email={data.contact.email}
      ctaPrimaryLabel="agendar llamada"
      ctaPrimaryHref="/es/contact"
      ctaSecondaryLabel="ver mi trabajo"
      ctaSecondaryHref="/es/projects"
    />

    <!-- Floating Toast Notification -->
    <div
      id="copy-toast-es"
      role="status"
      class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 pointer-events-none opacity-0 translate-y-3 transition-[opacity,transform] duration-300 ease-out flex items-center gap-2 px-3.5 py-2 rounded-full bg-zinc-100 text-zinc-900 text-xs font-medium shadow-lg border border-black/10 select-none"
    >
      <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
      <span id="copy-toast-text-es"></span>
    </div>
  </main>

  {/*
    SECCIONES ARCHIVADAS PARA RECONSTRUCCIÓN POR ETAPAS:
    Toda la información original sigue intacta en src/data/data.ts y componentes:
    - Navbar, Metadata row, About (#sobre-mi-intro), WorkExperience, Projects, TechStack, Blog, Contact, Footer.
  */}
</Layout>

<script>
  import { play } from "cuelume";

  const setupHeroCopyES = () => {
    const toast = document.getElementById("copy-toast-es");
    const toastText = document.getElementById("copy-toast-text-es");
    const copyBtns = document.querySelectorAll<HTMLElement>("[data-copy-email]");
    let toastTimeout: ReturnType<typeof setTimeout> | undefined;

    copyBtns.forEach((btn) => {
      if (btn.dataset.copyBound === "1") return;
      btn.dataset.copyBound = "1";

      btn.addEventListener("click", (e) => {
        e.preventDefault();
        const email = btn.getAttribute("data-copy-email");
        if (!email || !navigator.clipboard?.writeText) return;

        navigator.clipboard
          .writeText(email)
          .then(() => {
            play("success");
            if (toast && toastText) {
              toastText.textContent = "¡Correo copiado al portapapeles!";
              toast.classList.remove("opacity-0", "translate-y-3");
              toast.classList.add("opacity-100", "translate-y-0");

              if (toastTimeout) clearTimeout(toastTimeout);
              toastTimeout = setTimeout(() => {
                toast.classList.remove("opacity-100", "translate-y-0");
                toast.classList.add("opacity-0", "translate-y-3");
                toastText.textContent = "";
              }, 2500);
            }
          })
          .catch(() => {});
      });
    });
  };

  document.addEventListener("astro:page-load", setupHeroCopyES);
</script>
