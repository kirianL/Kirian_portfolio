---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Projects from "../components/Projects.astro";
import Footer from "../components/Footer.astro";
import { projectItemListSchema } from "../lib/seo";
---

<Layout
  title="Projects | Kirian Luna"
  description="Selected projects by Kirian Luna: full-stack platforms, cultural heritage experiences, SaaS products and high-performance landing pages."
  lang="en"
  pageType="CollectionPage"
  schema={projectItemListSchema}
>
  <Navbar />

  <main id="main-content" class="bg-grayscale-1">
    <div class="max-w-2xl mx-auto px-6 sm:px-0 pt-28 pb-12 flex flex-col gap-10">
      <!-- Interactive Projects Component (Handles Title, Subtitle, and Filters adaptively) -->
      <Projects />

      <!-- Footer -->
      <Footer />
    </div>
  </main>
</Layout>
