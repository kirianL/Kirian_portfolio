---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Projects from "../components/Projects.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Projects | Kirian Luna Quirós"
  description="Tools, APIs, and products built or maintained by Kirian Luna Quirós."
  lang="en"
>
  <Navbar />

  <main class="max-w-xl mx-auto px-4 sm:px-0 pt-28 pb-16">
    <div class="flex flex-col gap-10">
      <!-- Interactive Projects Component (Handles Title, Subtitle, and Filters adaptively) -->
      <Projects />

      <!-- Footer -->
      <Footer />
    </div>
  </main>
</Layout>
