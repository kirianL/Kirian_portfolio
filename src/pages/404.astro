---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="404 — Page Not Found | Kirian Luna"
  description="The requested page could not be found. Explore navigation links to discover projects, writing, or get in touch."
  lang="en"
>
  <Navbar />

  <main id="main-content" class="min-h-screen bg-grayscale-1 flex flex-col justify-between">
    <div class="max-w-2xl mx-auto px-6 sm:px-0 pt-36 pb-20 w-full flex flex-col gap-10">
      <div class="flex flex-col gap-3">
        <span class="font-mono text-xs text-accent-10 font-semibold tracking-wider uppercase">Error 404</span>
        <h1 class="font-figgle text-4xl text-grayscale-12 tracking-tight select-none">
          page not found.
        </h1>
        <p class="text-grayscale-11 text-sm leading-relaxed max-w-lg mt-1">
          The page or resource you are looking for has been moved, renamed, or does not exist on this domain. Use the links below to navigate to key sections:
        </p>
      </div>

      <!-- Navigation Directory -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <a
          href="/"
          data-cuelume-hover="tick"
          data-cuelume-press="page"
          class="p-4 rounded-xl border border-grayscale-3 dark:border-grayscale-3/40 bg-white dark:bg-grayscale-2/30 hover:border-grayscale-4 dark:hover:border-grayscale-4/60 transition-all flex flex-col gap-1 group shadow-3xs"
        >
          <span class="text-xs font-semibold text-grayscale-12 group-hover:text-accent-9 transition-colors flex items-center justify-between">
            Home / Portfolio
            <span class="text-grayscale-9 group-hover:translate-x-0.5 transition-transform">→</span>
          </span>
          <span class="text-[11px] text-grayscale-10">Return to the primary homepage overview.</span>
        </a>

        <a
          href="/about"
          data-cuelume-hover="tick"
          data-cuelume-press="page"
          class="p-4 rounded-xl border border-grayscale-3 dark:border-grayscale-3/40 bg-white dark:bg-grayscale-2/30 hover:border-grayscale-4 dark:hover:border-grayscale-4/60 transition-all flex flex-col gap-1 group shadow-3xs"
        >
          <span class="text-xs font-semibold text-grayscale-12 group-hover:text-accent-9 transition-colors flex items-center justify-between">
            About Kirian
            <span class="text-grayscale-9 group-hover:translate-x-0.5 transition-transform">→</span>
          </span>
          <span class="text-[11px] text-grayscale-10">Background, engineering philosophy & services.</span>
        </a>

        <a
          href="/projects"
          data-cuelume-hover="tick"
          data-cuelume-press="page"
          class="p-4 rounded-xl border border-grayscale-3 dark:border-grayscale-3/40 bg-white dark:bg-grayscale-2/30 hover:border-grayscale-4 dark:hover:border-grayscale-4/60 transition-all flex flex-col gap-1 group shadow-3xs"
        >
          <span class="text-xs font-semibold text-grayscale-12 group-hover:text-accent-9 transition-colors flex items-center justify-between">
            Selected Projects
            <span class="text-grayscale-9 group-hover:translate-x-0.5 transition-transform">→</span>
          </span>
          <span class="text-[11px] text-grayscale-10">Production applications, case studies & tools.</span>
        </a>

        <a
          href="/contact"
          data-cuelume-hover="tick"
          data-cuelume-press="page"
          class="p-4 rounded-xl border border-grayscale-3 dark:border-grayscale-3/40 bg-white dark:bg-grayscale-2/30 hover:border-grayscale-4 dark:hover:border-grayscale-4/60 transition-all flex flex-col gap-1 group shadow-3xs"
        >
          <span class="text-xs font-semibold text-grayscale-12 group-hover:text-accent-9 transition-colors flex items-center justify-between">
            Contact Surface
            <span class="text-grayscale-9 group-hover:translate-x-0.5 transition-transform">→</span>
          </span>
          <span class="text-[11px] text-grayscale-10">Direct form, email, and social networks.</span>
        </a>
      </div>

      <!-- Agent / Machine index links -->
      <div class="pt-4 border-t border-grayscale-3/50 dark:border-grayscale-3/25 flex flex-wrap gap-4 text-xs font-mono text-grayscale-10">
        <a href="/llms.txt" class="hover:text-grayscale-12 underline underline-offset-4">llms.txt</a>
        <a href="/llms-full.txt" class="hover:text-grayscale-12 underline underline-offset-4">llms-full.txt</a>
        <a href="/sitemap-index.xml" class="hover:text-grayscale-12 underline underline-offset-4">sitemap.xml</a>
      </div>

      <Footer />
    </div>
  </main>
</Layout>
