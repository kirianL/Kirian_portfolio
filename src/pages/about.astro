---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="About | Kirian Luna — Software Engineer"
  description="I'm Kirian Luna, a software engineer and builder based in Limón, Costa Rica. Learn about my path, philosophy, and current work."
  lang="en"
>
  <Navbar />

  <main id="main-content" class="min-h-screen bg-grayscale-1">
    <div class="max-w-xl mx-auto px-6 sm:px-0 pt-28 pb-16 flex flex-col gap-10">
      
      <!-- Back Link -->
      <div>
        <a
          href="/"
          data-cuelume-hover="tick"
          class="inline-flex items-center gap-1 text-xs font-mono text-grayscale-10 hover:text-grayscale-12 transition-colors select-none"
        >
          <span>←</span>
          <span>Home</span>
        </a>
      </div>

      <!-- Intro Block -->
      <section class="flex flex-col gap-3">
        <h1 class="text-sm font-semibold text-grayscale-12 font-mono tracking-tight select-none">
          About
        </h1>
        <p class="text-xs sm:text-[13px] text-grayscale-11 leading-relaxed">
          I'm Kirian Luna, a software engineer and builder based in Limón, Costa Rica. I work across full-stack engineering and product design: I architect backend systems, build responsive and accessible frontends, and keep refining every interaction until it feels fast, natural, and durable. I work in Spanish and English.
        </p>
      </section>

      <!-- Minimal Two-Column Structured Sections -->
      <div class="flex flex-col gap-9 text-xs sm:text-[13px] leading-relaxed">
        
        <!-- Path -->
        <section class="grid grid-cols-1 sm:grid-cols-[110px_1fr] gap-2 sm:gap-6 items-baseline">
          <span class="text-xs font-mono text-grayscale-10 select-none">Path</span>
          <div class="flex flex-col gap-3.5 text-grayscale-11">
            <p>
              I earned my Bachelor's Degree in Systems Engineering from <a href="https://www.ulatina.ac.cr/" target="_blank" rel="noopener noreferrer" class="text-grayscale-12 underline underline-offset-4 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Universidad Latina de Costa Rica</a>. That academic foundation in software architectures, relational databases, and network protocols established my passion for building resilient, type-safe digital platforms.
            </p>
            <p>
              At Sorin Labs, I design and build full-stack web applications, internal tools, and robust APIs. I lead engineering across modern TypeScript, Next.js, Astro, and PostgreSQL, focusing on scalable schemas, sub-second latency, and uncompromising performance.
            </p>
          </div>
        </section>

        <!-- On the side -->
        <section class="grid grid-cols-1 sm:grid-cols-[110px_1fr] gap-2 sm:gap-6 items-baseline">
          <span class="text-xs font-mono text-grayscale-10 select-none">On the side</span>
          <div class="flex flex-col gap-3 text-grayscale-11">
            <p>
              Outside client and team work, I build independent tools, craft tactile micro-interactions (like the cuelume audio feedback engine), and develop digital cultural initiatives celebrating Costa Rican Caribbean heritage. The <a href="/" class="text-grayscale-12 underline underline-offset-4 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">home page</a> highlights what I'm working on now.
            </p>
          </div>
        </section>

        <!-- Philosophy -->
        <section class="grid grid-cols-1 sm:grid-cols-[110px_1fr] gap-2 sm:gap-6 items-baseline">
          <span class="text-xs font-mono text-grayscale-10 select-none">Philosophy</span>
          <div class="flex flex-col gap-3 text-grayscale-11">
            <p>
              I believe software should be fast, deliberate, and built to last. No unnecessary framework bloat, no gratuitous dependencies—just clean abstractions, strict type safety, accessible DOM semantics, and a 100/100 standard for performance and user experience.
            </p>
          </div>
        </section>

        <!-- Connect -->
        <section class="grid grid-cols-1 sm:grid-cols-[110px_1fr] gap-2 sm:gap-6 items-baseline">
          <span class="text-xs font-mono text-grayscale-10 select-none">Connect</span>
          <div class="flex flex-col gap-3 text-grayscale-11">
            <p>
              I collaborate with teams and startups globally. If you'd like to discuss engineering roles, contract projects, or architecture reviews, reach out via email at <a href="mailto:kirianluna.u@gmail.com" class="text-grayscale-12 underline underline-offset-4 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">kirianluna.u@gmail.com</a>, find me on <a href="https://linkedin.com/in/kirianluna" target="_blank" rel="noopener noreferrer" class="text-grayscale-12 underline underline-offset-4 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">LinkedIn</a> and <a href="https://github.com/kirianL" target="_blank" rel="noopener noreferrer" class="text-grayscale-12 underline underline-offset-4 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">GitHub</a>, or send a note through the <a href="/contact" class="text-grayscale-12 underline underline-offset-4 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">contact page</a>.
            </p>
          </div>
        </section>

      </div>

      <Footer />
    </div>
  </main>
</Layout>
