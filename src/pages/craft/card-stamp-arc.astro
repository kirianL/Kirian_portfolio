          >
            <!-- Header Bar -->
            <div class="px-3.5 py-2.5 bg-zinc-900/90 border-b border-zinc-800/80 flex items-center justify-between flex-wrap gap-2">
              <div class="flex items-center gap-1.5 overflow-x-auto scrollbar-none py-0.5 max-w-full">
                <button
                  type="button"
                  class="code-tab-btn px-3 py-1 rounded-lg text-zinc-100 bg-zinc-800 border border-zinc-700/60 font-medium cursor-pointer transition-all duration-200 shadow-xs text-xs"
                  data-tab="astro"
                >
                  CardStampArc.astro
                </button>
                <button
                  type="button"
                  class="code-tab-btn px-3 py-1 rounded-lg text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/50 border border-transparent font-medium cursor-pointer transition-all duration-200 text-xs"
                  data-tab="react"
                >
                  CardStampArc.tsx
                </button>
                <button
                  type="button"
                  class="code-tab-btn px-3 py-1 rounded-lg text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/50 border border-transparent font-medium cursor-pointer transition-all duration-200 text-xs"
                  data-tab="usage"
                >
                  Usage.md
                </button>
              </div>

              <div class="flex items-center gap-2 shrink-0 ml-auto font-sans text-xs">
                <button
                  type="button"
                  id="drawer-toggle-wrap"
                  title="Toggle Word Wrap"
                  class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800/60 border border-transparent transition-all cursor-pointer"
                >
                  <svg class="w-3.5 h-3.5 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h11a4 4 0 010 8h-1m-4-4l-3 3m3-3l-3-3M3 6h18M3 14h7" />
                  </svg>
                  <span class="text-[11.5px] font-medium">Wrap</span>
                </button>

                <button
                  type="button"
                  id="drawer-toggle-expand"
                  title="Toggle Full Height"
                  class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800/60 border border-transparent transition-all cursor-pointer"
                >
                  <svg class="w-3.5 h-3.5 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                  </svg>
                  <span id="expand-toggle-text" class="text-[11.5px] font-medium">Full view</span>
                </button>

                <div class="w-px h-4 bg-zinc-800 self-center"></div>

                <button
                  type="button"
                  id="drawer-copy-active"
                  class="relative text-xs text-zinc-200 hover:text-zinc-100 bg-zinc-800 hover:bg-zinc-700/90 border border-zinc-700/60 inline-flex items-center justify-center cursor-pointer transition-all duration-300 ease-out active:scale-95 px-3 py-1 rounded-lg"
                >
                  <span class="btn-default inline-flex items-center gap-1.5 transition-all duration-200">
                    <svg class="w-3.5 h-3.5 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                    <span class="font-medium">Copy</span>
                  </span>
                  <span class="btn-success absolute inset-0 inline-flex items-center justify-center gap-1.5 opacity-0 pointer-events-none scale-90 transition-all duration-200 text-emerald-400 font-medium">
                    <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>Copied!</span>
                  </span>
                </button>
              </div>
            </div>

            <!-- Pre Container -->
            <div id="code-pre-container" class="relative max-h-96 overflow-y-auto overflow-x-auto transition-all duration-300 scrollbar-thin scrollbar-thumb-zinc-800 scrollbar-track-transparent">
              <pre id="code-pre" class="p-4 sm:p-5 text-zinc-200 leading-relaxed whitespace-pre font-mono text-xs sm:text-[12.5px] selection:bg-indigo-500/30 selection:text-indigo-100"><code id="code-display" class="block">{astroCode}</code></pre>
            </div>
          </div>
        </div>
      </section>

      <Footer />
    </div>
  </main>
</Layout>

<script>
  let activeTab = "astro";
  let isWordWrap = false;
  let isFullHeight = false;

  function getSnippetContent(tab: string): string {
    const codeDrawer = document.getElementById("code-drawer");
    if (!codeDrawer) return "";
    if (tab === "react") return codeDrawer.getAttribute("data-snippet-react") || "";
    if (tab === "usage") return codeDrawer.getAttribute("data-snippet-usage") || "";
    return codeDrawer.getAttribute("data-snippet-astro") || "";
  }

  function animateOverlaySuccess(btn: HTMLElement) {
    if (btn.classList.contains("is-animating")) return;
    btn.classList.add("is-animating");

    const defaultContent = btn.querySelector(".btn-default") as HTMLElement;
    const successContent = btn.querySelector(".btn-success") as HTMLElement;

    btn.style.transform = "scale(0.95)";
    btn.classList.add("border-emerald-500/60", "bg-emerald-500/10");

    if (defaultContent) {
      defaultContent.style.opacity = "0";
      defaultContent.style.transform = "scale(0.92)";
    }

    setTimeout(() => {
      btn.style.transform = "scale(1.02)";
      if (successContent) {
        successContent.style.opacity = "1";
        successContent.style.transform = "scale(1)";
      }

      setTimeout(() => {
        btn.style.transform = "scale(1)";
      }, 150);
    }, 100);

    setTimeout(() => {
      if (successContent) {
        successContent.style.opacity = "0";
        successContent.style.transform = "scale(0.92)";
      }

      setTimeout(() => {
        btn.classList.remove("border-emerald-500/60", "bg-emerald-500/10");
        btn.style.transform = "";

        if (defaultContent) {
          defaultContent.style.opacity = "1";
          defaultContent.style.transform = "scale(1)";
        }

        setTimeout(() => {
          btn.classList.remove("is-animating");
        }, 150);
      }, 100);
    }, 1600);
  }

  function initCraftDetailPage() {
    document.querySelectorAll(".copy-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const code = btn.getAttribute("data-copy");
        if (!code) return;

        navigator.clipboard.writeText(code).then(() => {
          animateOverlaySuccess(btn as HTMLElement);
        });
      });
    });

    const toggleBtn = document.getElementById("toggle-code-btn");
    const toggleLabel = document.getElementById("toggle-code-label");
    const toggleIcon = document.getElementById("toggle-code-icon");
    const codeDrawer = document.getElementById("code-drawer");
    const codeDisplay = document.getElementById("code-display");
    const codePreContainer = document.getElementById("code-pre-container");
    const codePre = document.getElementById("code-pre");
    const drawerCopy = document.getElementById("drawer-copy-active");
    const wrapBtn = document.getElementById("drawer-toggle-wrap");
    const expandBtn = document.getElementById("drawer-toggle-expand");
    const expandText = document.getElementById("expand-toggle-text");

    if (toggleBtn && codeDrawer && toggleLabel) {
      toggleBtn.addEventListener("click", () => {
        const isHidden = codeDrawer.classList.contains("hidden");
        if (isHidden) {
          codeDrawer.classList.remove("hidden");
          toggleLabel.textContent = "Hide code";
          toggleBtn.classList.add("border-grayscale-4", "dark:border-grayscale-4", "bg-grayscale-3/60");
          if (toggleIcon) toggleIcon.style.transform = "rotate(180deg)";
        } else {
          codeDrawer.classList.add("hidden");
          toggleLabel.textContent = "View code";
          toggleBtn.classList.remove("border-grayscale-4", "dark:border-grayscale-4", "bg-grayscale-3/60");
          if (toggleIcon) toggleIcon.style.transform = "rotate(0deg)";
        }
      });
    }

    document.querySelectorAll(".code-tab-btn").forEach((tabBtn) => {
      tabBtn.addEventListener("click", () => {
        const tab = tabBtn.getAttribute("data-tab");
        if (!tab || !codeDisplay) return;
        activeTab = tab;

        const newCode = getSnippetContent(tab);

        document.querySelectorAll(".code-tab-btn").forEach((b) => {
          b.classList.remove("bg-zinc-800", "text-zinc-100", "border-zinc-700/60", "shadow-xs");
          b.classList.add("text-zinc-400", "border-transparent");
        });

        tabBtn.classList.add("bg-zinc-800", "text-zinc-100", "border-zinc-700/60", "shadow-xs");
        tabBtn.classList.remove("text-zinc-400", "border-transparent");

        codeDisplay.textContent = newCode;
      });
    });

    if (wrapBtn && codePre) {
      wrapBtn.addEventListener("click", () => {
        isWordWrap = !isWordWrap;
        if (isWordWrap) {
          codePre.classList.remove("whitespace-pre");
          codePre.classList.add("whitespace-pre-wrap", "break-words");
          wrapBtn.classList.add("text-zinc-100", "bg-zinc-800");
          wrapBtn.classList.remove("text-zinc-400");
        } else {
          codePre.classList.remove("whitespace-pre-wrap", "break-words");
          codePre.classList.add("whitespace-pre");
          wrapBtn.classList.remove("text-zinc-100", "bg-zinc-800");
          wrapBtn.classList.add("text-zinc-400");
        }
      });
    }

    if (expandBtn && codePreContainer && expandText) {
      expandBtn.addEventListener("click", () => {
        isFullHeight = !isFullHeight;
        if (isFullHeight) {
          codePreContainer.classList.remove("max-h-96");
          codePreContainer.classList.add("max-h-none");
          expandText.textContent = "Compact";
          expandBtn.classList.add("text-zinc-100", "bg-zinc-800");
          expandBtn.classList.remove("text-zinc-400");
        } else {
          codePreContainer.classList.remove("max-h-none");
          codePreContainer.classList.add("max-h-96");
          expandText.textContent = "Full view";
          expandBtn.classList.remove("text-zinc-100", "bg-zinc-800");
          expandBtn.classList.add("text-zinc-400");
        }
      });
    }

    if (drawerCopy && codeDisplay) {
      drawerCopy.addEventListener("click", () => {
        const currentCode = getSnippetContent(activeTab) || codeDisplay.textContent;
        if (!currentCode) return;
        navigator.clipboard.writeText(currentCode).then(() => {
          animateOverlaySuccess(drawerCopy as HTMLElement);
        });
      });
    }
  }

  initCraftDetailPage();
  document.addEventListener("astro:after-swap", initCraftDetailPage);
</script>
