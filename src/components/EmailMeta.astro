---
interface Props {
  label: string;
  email: string;
}

const { label, email } = Astro.props;
const currentLocale = Astro.currentLocale || "en";
const copiedLabel = currentLocale === "es" ? "Copiado" : "Copied";
const atIndex = email.indexOf("@");
const localPart = atIndex > -1 ? email.slice(0, atIndex) : email;
const domainPart = atIndex > -1 ? email.slice(atIndex) : "";
---

<div class="flex flex-col gap-1.5">
  <span class="text-[10px] font-medium uppercase tracking-[0.12em] text-grayscale-11">
    {label}
  </span>

  <button
    type="button"
    data-email-meta-btn={email}
    data-cuelume-hover="tick"
    data-cuelume-press
    aria-label={`${label}: ${email}`}
    title={email}
    class="email-meta-btn text-grayscale-12 text-sm inline-flex items-center gap-1.5 w-fit cursor-pointer rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-9 focus-visible:ring-offset-2"
  >
    <!-- Leading Icon Slot (Envelope -> Check Morph on Copy) -->
    <span class="relative inline-flex items-center justify-center w-3.5 h-3.5 shrink-0">
      <svg
        class="email-meta-envelope w-3.5 h-3.5 text-grayscale-11"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
        />
      </svg>

      <svg
        class="email-meta-check w-3.5 h-3.5 text-[#059669] dark:text-[#34d399] absolute inset-0"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 13l4 4L19 7" />
      </svg>
    </span>

    <!-- Email Text + Floating Copy Branch -->
    <span class="relative inline-flex items-center">
      <span class="email-meta-local">{localPart}</span><span class="email-meta-domain">{domainPart}</span>

      <span class="email-copied-branch" aria-hidden="true">
        <svg class="email-branch-svg" viewBox="0 0 16 16" fill="none">
          <path
            class="email-branch-path"
            d="M1.5 0V8.5C1.5 11.2614 3.73858 13.5 6.5 13.5H15.5"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linecap="round"
          />
        </svg>
        <span class="email-copied-label">{copiedLabel}</span>
      </span>
    </span>
  </button>
</div>

<style is:global>
  .email-meta-envelope {
    transition:
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      color 200ms ease,
      opacity 220ms cubic-bezier(0.2, 0, 0, 1),
      filter 220ms cubic-bezier(0.2, 0, 0, 1);
  }

  .email-meta-check {
    opacity: 0;
    transform: scale(0.25);
    filter: blur(4px);
    pointer-events: none;
    transition:
      opacity 240ms cubic-bezier(0.2, 0, 0, 1),
      transform 260ms cubic-bezier(0.2, 0, 0, 1),
      filter 240ms cubic-bezier(0.2, 0, 0, 1);
  }

  .email-meta-local,
  .email-meta-domain {
    transition:
      color 220ms ease,
      opacity 220ms ease;
  }

  /* Floating Copied Branch (zero layout shift) */
  .email-copied-branch {
    position: absolute;
    top: calc(100% + 1px);
    left: 0.65rem;
    display: inline-flex;
    align-items: flex-end;
    gap: 0.3rem;
    pointer-events: none;
    z-index: 20;
    opacity: 0;
    transform: translateY(-2px);
    transition:
      opacity 160ms ease-out,
      transform 180ms ease-out;
  }

  .email-branch-svg {
    width: 15px;
    height: 15px;
    color: color-mix(in srgb, #059669 40%, var(--color-grayscale-7));
    flex-shrink: 0;
    margin-bottom: 4px;
  }

  html.dark .email-branch-svg {
    color: color-mix(in srgb, #34d399 45%, var(--color-grayscale-7));
  }

  .email-branch-path {
    stroke-dasharray: 28;
    stroke-dashoffset: 28;
    transition: stroke-dashoffset 180ms ease-out;
  }

  .email-copied-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: #059669;
  }

  html.dark .email-copied-label {
    color: #34d399;
  }

  /* Copied State: Icon Morph + Branch Reveal */
  .email-meta-btn[data-copied="true"] .email-meta-envelope {
    opacity: 0;
    transform: scale(0.25);
    filter: blur(4px);
  }

  .email-meta-btn[data-copied="true"] .email-meta-check {
    opacity: 1;
    transform: scale(1);
    filter: blur(0);
  }

  .email-meta-btn[data-copied="true"] .email-copied-branch {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 220ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .email-meta-btn[data-copied="true"] .email-branch-path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 220ms cubic-bezier(0.22, 1, 0.36, 1) 20ms;
  }

  @media (hover: hover) {
    .email-meta-btn:not([data-copied="true"]):hover .email-meta-local {
      color: #1e40af;
    }

    html.dark .email-meta-btn:not([data-copied="true"]):hover .email-meta-local {
      color: #60a5fa;
    }

    .email-meta-btn:not([data-copied="true"]):hover .email-meta-domain {
      opacity: 0.48;
    }

    .email-meta-btn:not([data-copied="true"]):hover .email-meta-envelope {
      color: #1e40af;
      transform: translateY(-1px) rotate(-7deg);
    }

    html.dark .email-meta-btn:not([data-copied="true"]):hover .email-meta-envelope {
      color: #60a5fa;
    }
  }
</style>

<script is:inline>
  (function () {
    if (window.__emailMetaCopyCapture) return;
    window.__emailMetaCopyCapture = true;
    var copiedTimer = null;

    document.addEventListener(
      "click",
      function (e) {
        var target = e.target;
        if (!(target instanceof Element)) return;
        var btn = target.closest("[data-email-meta-btn]");
        if (!btn) return;

        var email = btn.getAttribute("data-email-meta-btn") || "kirianluna.u@gmail.com";

        function showCopied() {
          btn.setAttribute("data-copied", "true");
          if (copiedTimer) clearTimeout(copiedTimer);
          copiedTimer = setTimeout(function () {
            btn.removeAttribute("data-copied");
          }, 1800);
        }

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(email).then(showCopied).catch(function () {
            var ta = document.createElement("textarea");
            ta.value = email;
            ta.style.position = "fixed";
            ta.style.opacity = "0";
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand("copy"); } catch (err) {}
            document.body.removeChild(ta);
            showCopied();
          });
        } else {
          var ta = document.createElement("textarea");
          ta.value = email;
          ta.style.position = "fixed";
          ta.style.opacity = "0";
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand("copy"); } catch (err) {}
          document.body.removeChild(ta);
          showCopied();
        }
      },
      true
    );
  })();
</script>
