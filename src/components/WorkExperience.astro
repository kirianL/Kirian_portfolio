---
import { dictionaries } from "../data/data";

const currentLocale = Astro.currentLocale === 'es' ? 'ES' : 'EN';
const isEs = currentLocale === 'ES';
const data = dictionaries[currentLocale];
const experienceList = data.experienceList || [];

// Group experiences by year preserving chronological descending order
const experiencesByYear: Record<string, typeof experienceList> = {};

experienceList.forEach((exp: any) => {
  const year = exp.year || exp.period?.match(/\b(20\d{2})\b/)?.[1] || '2026';
  if (!experiencesByYear[year]) {
    experiencesByYear[year] = [];
  }
  experiencesByYear[year].push(exp);
});

const sortedYears = Object.keys(experiencesByYear).sort((a, b) => Number(b) - Number(a));

// Curated muted colors per folder icon (no neon, purely tasteful & minimal)
const folderStyles: Record<string, {
  iconColor: string;
  iconFill: string;
  iconStroke: string;
  lineColor: string;
  badgeColor: string;
}> = {
  "2026": {
    iconColor: "text-blue-600 dark:text-blue-400",
    iconFill: "fill-blue-500/10 dark:fill-blue-400/15",
    iconStroke: "currentColor",
    lineColor: "border-blue-500/25 dark:border-blue-400/25",
    badgeColor: "text-blue-600/90 dark:text-blue-400/90 bg-blue-50 dark:bg-blue-950/40 border-blue-200/60 dark:border-blue-900/40",
  },
  "2025": {
    iconColor: "text-amber-600 dark:text-amber-400",
    iconFill: "fill-amber-500/10 dark:fill-amber-400/15",
    iconStroke: "currentColor",
    lineColor: "border-amber-500/25 dark:border-amber-400/25",
    badgeColor: "text-amber-600/90 dark:text-amber-400/90 bg-amber-50 dark:bg-amber-950/40 border-amber-200/60 dark:border-amber-900/40",
  },
  "2024": {
    iconColor: "text-emerald-600 dark:text-emerald-400",
    iconFill: "fill-emerald-500/10 dark:fill-emerald-400/15",
    iconStroke: "currentColor",
    lineColor: "border-emerald-500/25 dark:border-emerald-400/25",
    badgeColor: "text-emerald-600/90 dark:text-emerald-400/90 bg-emerald-50 dark:bg-emerald-950/40 border-emerald-200/60 dark:border-emerald-900/40",
  }
};

const defaultFolderStyle = {
  iconColor: "text-grayscale-10 dark:text-grayscale-9",
  iconFill: "fill-grayscale-4/20 dark:fill-grayscale-4/10",
  iconStroke: "currentColor",
  lineColor: "border-grayscale-4/40 dark:border-grayscale-4/20",
  badgeColor: "text-grayscale-10 bg-grayscale-2 border-grayscale-4/40",
};
---

<section id="experiencia" class="flex flex-col w-full gap-4">
  <!-- Minimal Header -->
  <div class="flex items-center justify-between px-1">
    <h2 class="font-figgle text-3xl text-grayscale-12 tracking-tight select-none">
      {isEs ? 'experiencia.' : 'experience.'}
    </h2>

    <!-- Minimalist Toggle All Button -->
    <button
      id="folder-deck-toggle-all"
      type="button"
      class="group inline-flex items-center gap-1.5 px-2 py-0.5 text-[11px] font-mono text-grayscale-11 hover:text-grayscale-12 rounded-md transition-colors select-none cursor-pointer"
      data-cuelume-hover="tick"
      data-cuelume-press
      data-all-open="false"
      data-text-expand={isEs ? 'expandir todas' : 'expand all'}
      data-text-collapse={isEs ? 'colapsar todas' : 'collapse all'}
    >
      <span id="folder-deck-toggle-text">
        {isEs ? 'expandir todas' : 'expand all'}
      </span>
    </button>
  </div>

  <!-- Folders List -->
  <div class="flex flex-col divide-y divide-grayscale-3/60 dark:divide-grayscale-3/30 border-y border-grayscale-3/60 dark:border-grayscale-3/30" id="experience-folders-container">
    {
      sortedYears.map((year) => {
        const style = folderStyles[year] || defaultFolderStyle;
        const exps = experiencesByYear[year];
        const isInitiallyOpen = false;

        return (
          <div
            class="minimal-folder-item group/folder flex flex-col w-full py-3"
            data-folder-year={year}
            data-open={isInitiallyOpen ? "true" : "false"}
          >
            <!-- Folder Row Trigger -->
            <button
              type="button"
              class="folder-trigger-btn w-full flex items-center justify-between gap-3 text-left py-1 select-none cursor-pointer focus-visible:outline-none group/btn"
              data-cuelume-hover="tick"
              data-cuelume-press
              aria-expanded={isInitiallyOpen ? "true" : "false"}
              aria-controls={`folder-content-${year}`}
            >
              <!-- Left: Folder icon + Year + Count -->
              <div class="flex items-center gap-3">
                <!-- Folder Icon with Opening Flap Motion -->
                <div class={`folder-icon-box relative flex items-center justify-center shrink-0 w-6 h-6 ${style.iconColor} transition-transform duration-200 group-hover/btn:scale-105`}>
                  <svg
                    class="w-5 h-5 folder-svg overflow-visible"
                    viewBox="0 0 20 18"
                    fill="none"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <!-- Folder Back -->
                    <path
                      d="M2 4.5C2 3.67 2.67 3 3.5 3H7.2C7.6 3 8 3.16 8.3 3.45L9.5 4.55C9.8 4.84 10.2 5 10.6 5H16.5C17.33 5 18 5.67 18 6.5V14.5C18 15.33 17.33 16 16.5 16H3.5C2.67 16 2 15.33 2 14.5V4.5Z"
                      class={`${style.iconFill}`}
                      stroke="currentColor"
                    />
                    <!-- Inner Document Sheet -->
                    <rect
                      class="folder-sheet transition-transform duration-300 ease-out"
                      x="4.5"
                      y="4.5"
                      width="11"
                      height="7"
                      rx="0.8"
                      fill="currentColor"
                      fill-opacity="0.2"
                    />
                    <!-- Folder Flap (front) -->
                    <path
                      class="folder-flap transition-transform duration-350 ease-out"
                      d="M2 7.5C2 6.95 2.45 6.5 3 6.5H17C17.55 6.5 18 6.95 18 7.5L17.2 14.8C17.15 15.46 16.6 16 15.9 16H4.1C3.4 16 2.85 15.46 2.8 14.8L2 7.5Z"
                      class={`${style.iconFill}`}
                      stroke="currentColor"
                    />
                  </svg>
                </div>

                <!-- Year -->
                <span class="font-mono text-[13px] font-medium text-grayscale-12 tracking-tight group-hover/btn:text-grayscale-12 transition-colors">
                  {year}
                </span>

                <!-- Separator -->
                <span class="text-grayscale-6 select-none font-mono text-xs">·</span>

                <!-- Counter badge -->
                <span class="text-[11px] font-mono text-grayscale-11">
                  {exps.length} {isEs ? (exps.length === 1 ? 'rol' : 'roles') : (exps.length === 1 ? 'role' : 'roles')}
                </span>
              </div>

              <!-- Right: Chevron indicator -->
              <div class="flex items-center gap-2 text-grayscale-9 group-hover/btn:text-grayscale-11 transition-colors">
                <span
                  class="folder-state-indicator text-[11px] font-mono opacity-0 group-hover/btn:opacity-100 transition-opacity duration-200 hidden sm:inline"
                  data-text-open={isEs ? 'plegar' : 'collapse'}
                  data-text-close={isEs ? 'desplegar' : 'expand'}
                >
                  {isInitiallyOpen ? (isEs ? 'plegar' : 'collapse') : (isEs ? 'desplegar' : 'expand')}
                </span>

                <div class="folder-chevron transition-transform duration-350 ease-out">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m6 9 6 6 6-6"/>
                  </svg>
                </div>
              </div>
            </button>

            <!-- Collapsible Items Container -->
            <div
              id={`folder-content-${year}`}
              class="folder-collapsible-content"
            >
              <div class="folder-collapsible-inner overflow-hidden min-h-0">
                <!-- Minimal items list with subtle left rail -->
                <div class={`flex flex-col gap-6 pl-4 sm:pl-7 pt-4 pb-2 ml-3 border-l ${style.lineColor}`}>
                  {
                    exps.map((exp: any, expIndex: number) => (
                      <div
                        class="folder-exp-item flex flex-col sm:grid sm:grid-cols-[11.5rem_1fr] gap-x-6 gap-y-2 group/entry"
                        style={`--stagger-delay: ${expIndex * 60}ms;`}
                      >
                        <!-- Left Column: Period -->
                        <div class="text-grayscale-10 text-xs font-mono select-none pt-0.5 sm:block hidden whitespace-nowrap">
                          {exp.period}
                        </div>

                        <!-- Right Column: Role Title, Company Badge, Description & Stack -->
                        <div class="flex flex-col gap-2">
                          <!-- Mobile Period -->
                          <div class="sm:hidden text-[10px] font-mono uppercase tracking-wider text-grayscale-10 select-none mb-0.5 whitespace-nowrap">
                            {exp.period}
                          </div>

                          <!-- Line 1: Role Title & Company Link -->
                          <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
                            <h3 class="text-grayscale-12 font-medium tracking-tight text-[14px] leading-snug">
                              {exp.role}
                            </h3>

                            {exp.companyUrl ? (
                              <a
                                href={exp.companyUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                data-cuelume-hover="tick"
                                data-cuelume-press
                                class="group/company inline-flex items-center gap-1 text-[13px] text-grayscale-11 hover:text-grayscale-12 transition-colors duration-150"
                              >
                                <span class="font-medium underline decoration-grayscale-4/70 dark:decoration-grayscale-6 underline-offset-4 group-hover/company:decoration-grayscale-12 transition-colors">
                                  {exp.company}
                                </span>
                                <svg class="w-3 h-3 text-grayscale-8 group-hover/company:text-grayscale-12 transition-transform duration-150 group-hover/company:translate-x-0.5 group-hover/company:-translate-y-0.5 ml-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                  <path d="M7 17L17 7"/>
                                  <path d="M7 7h10v10"/>
                                </svg>
                              </a>
                            ) : (
                              <span class="text-[13px] text-grayscale-11 font-medium">{exp.company}</span>
                            )}
                          </div>

                          <!-- Experience Details Bullet -->
                          <div class="flex gap-2 text-grayscale-11 text-[13px] leading-relaxed mt-0.5">
                            <svg class="w-3 h-3 text-grayscale-9 mt-[4px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M5 12h14" />
                              <path d="m12 5 7 7-7 7" />
                            </svg>
                            <p class="tracking-tight text-grayscale-11 group-hover/entry:text-grayscale-12 transition-colors duration-200">
                              {exp.description}
                            </p>
                          </div>

                          <!-- Tech Stack (Clean Minimalist Editorial) -->
                          {exp.stack && exp.stack.length > 0 && (
                            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 pl-5 pt-0.5 text-[11px] font-mono text-grayscale-10 select-none">
                              {exp.stack.map((tech: string) => (
                                <span class="hover:text-grayscale-12 transition-colors duration-150">
                                  {tech}
                                </span>
                              ))}
                            </div>
                          )}
                        </div>
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<style>
  /* SVG Folder Flap Animation */
  .folder-svg {
    perspective: 400px;
  }

  .folder-flap {
    transform-origin: 2px 14px;
    transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .folder-sheet {
    transform-origin: center bottom;
    transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .folder-chevron {
    transform: rotate(0deg);
    transition: transform 380ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Grid collapsible drawer - Pure butter smooth */
  .folder-collapsible-content {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 400ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* OPEN STATE */
  .minimal-folder-item[data-open="true"] .folder-collapsible-content {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .minimal-folder-item[data-open="true"] .folder-chevron {
    transform: rotate(180deg);
  }

  .minimal-folder-item[data-open="true"] .folder-flap {
    transform: rotateX(-32deg) scaleY(0.88) translateY(0.5px);
  }

  .minimal-folder-item[data-open="true"] .folder-sheet {
    transform: translateY(-2.5px);
  }

  /* Content items transition smoothly as a unified block */
  .folder-collapsible-inner {
    overflow: hidden;
    min-height: 0;
    transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .minimal-folder-item[data-open="true"] .folder-collapsible-inner {
    transform: translateY(0);
  }

  .minimal-folder-item[data-open="false"] .folder-collapsible-inner {
    transform: translateY(-4px);
  }

  .folder-exp-item {
    transition: opacity 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .minimal-folder-item[data-open="true"] .folder-exp-item {
    opacity: 1;
  }

  .minimal-folder-item[data-open="false"] .folder-exp-item {
    opacity: 0.2;
  }
</style>

<script>
  function setupMinimalExperienceFolders() {
    const container = document.getElementById("experience-folders-container");
    const toggleAllBtn = document.getElementById("folder-deck-toggle-all");
    const toggleAllText = document.getElementById("folder-deck-toggle-text");
    if (!container) return;

    const folderItems = container.querySelectorAll<HTMLElement>(".minimal-folder-item");

    function updateFolderState(item: HTMLElement, open: boolean) {
      item.setAttribute("data-open", open ? "true" : "false");

      const indicator = item.querySelector<HTMLElement>(".folder-state-indicator");
      if (indicator) {
        indicator.textContent = open 
          ? (indicator.dataset.textOpen || "plegar") 
          : (indicator.dataset.textClose || "desplegar");
      }

      const triggerBtn = item.querySelector<HTMLButtonElement>(".folder-trigger-btn");
      if (triggerBtn) {
        triggerBtn.setAttribute("aria-expanded", open ? "true" : "false");
      }
    }

    function checkAllOpenState() {
      let allOpen = true;
      folderItems.forEach((item) => {
        if (item.getAttribute("data-open") !== "true") {
          allOpen = false;
        }
      });

      if (toggleAllBtn && toggleAllText) {
        toggleAllBtn.setAttribute("data-all-open", allOpen ? "true" : "false");
        toggleAllText.textContent = allOpen 
          ? (toggleAllBtn.dataset.textCollapse || "colapsar todas") 
          : (toggleAllBtn.dataset.textExpand || "expandir todas");
      }
    }

    // Attach listeners
    folderItems.forEach((item) => {
      const triggerBtn = item.querySelector<HTMLButtonElement>(".folder-trigger-btn");
      if (triggerBtn && !triggerBtn.dataset.hasFolderListener) {
        triggerBtn.dataset.hasFolderListener = "true";
        triggerBtn.addEventListener("click", (e) => {
          e.preventDefault();
          const isOpen = item.getAttribute("data-open") === "true";
          updateFolderState(item, !isOpen);
          checkAllOpenState();
        });
      }
    });

    if (toggleAllBtn && !toggleAllBtn.dataset.hasToggleAllListener) {
      toggleAllBtn.dataset.hasToggleAllListener = "true";
      toggleAllBtn.addEventListener("click", (e) => {
        e.preventDefault();
        const currentlyAllOpen = toggleAllBtn.getAttribute("data-all-open") === "true";
        const nextState = !currentlyAllOpen;

        folderItems.forEach((item) => {
          updateFolderState(item, nextState);
        });

        checkAllOpenState();
      });
    }

    checkAllOpenState();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupMinimalExperienceFolders);
  } else {
    setupMinimalExperienceFolders();
  }
  document.addEventListener("astro:page-load", setupMinimalExperienceFolders);
  document.addEventListener("astro:after-swap", setupMinimalExperienceFolders);
</script>
