    // Costa Rica Time (UTC-6)
    const now = new Date();
    const utc = now.getTime() + now.getTimezoneOffset() * 60000;
    const crDate = new Date(utc + 3600000 * -6);

    const month = crDate.getMonth() + 1; // 1-12
    const date = crDate.getDate(); // 1-31
    const hours = crDate.getHours();
    const day = crDate.getDay(); // 0 = Sun, 6 = Sat

    // 1. Costa Rica & Limón Special Cultural Dates & National Holidays
