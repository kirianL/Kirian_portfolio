      },
      "12-1": {
        badgeEs: "[Kirian: Abolición del Ejército]",
        badgeEn: "[Kirian: Army Abolition]",
        textEs: `"1 Dic: Abolición del ejército en Costa Rica (1948)."`,
        textEn: `"Dec 1: Abolition of the military in Costa Rica."`,
        sprite: "palm",
      },
      "12-25": {
        badgeEs: "[Kirian: Fiestas Navideñas]",
        badgeEn: "[Kirian: Holiday Season]",
        textEs: `"25 Dic: ¡Feliz Navidad y felices fiestas!"`,
        textEn: `"Dec 25: Merry Christmas & happy holidays!"`,
        sprite: "palm",
      },
      "1-1": {
        badgeEs: "[Kirian: Año Nuevo]",
        badgeEn: "[Kirian: New Year]",
        textEs: `"1 Ene: ¡Feliz Año Nuevo! Iniciando con código limpio."`,
        textEn: `"Jan 1: Happy New Year! Starting with clean code."`,
        sprite: "pc",
      },
    };

    const todayKey = `${month}-${date}`;
    if (holidays[todayKey]) {
      const h = holidays[todayKey];
      return {
        badge: isEs ? h.badgeEs : h.badgeEn,
        text: isEs ? h.textEs : h.textEn,
        sprite: h.sprite,
      };
    }

    const isWeekend = day === 0 || day === 6;
    const isWorkHours = !isWeekend && hours >= 9 && hours < 18;
    const isLateNight = hours >= 22 || hours < 6;

    if (isWorkHours) {
      const phrasesEs = [
        `"Compilando nuevas ideas y puliendo interfaces."`,
        `"Enfocado en código. Modo concentración."`,
        `"Cazando bugs en el sistema con café en mano."`,
        `"Diseñando la próxima versión."`,
      ];
      const phrasesEn = [
        `"Compiling new ideas and polishing interfaces."`,
        `"Deep in the code. Deep focus mode."`,
        `"Hunting system bugs with coffee in hand."`,
        `"Crafting the next release."`,
      ];
      const idx = Math.floor(Math.random() * phrasesEs.length);
      return {
        badge: "[Kirian: Online]",
        text: isEs ? phrasesEs[idx] : phrasesEn[idx],
        sprite: "pc",
      };
    } else if (isLateNight) {
      const phrasesEs = [
        `"En modo reposo. Recargando batería para mañana."`,
        `"Kirian está descansando. Vuelve con el sol."`,
        `"Servidores estables. Nos vemos en el próximo commit."`,
      ];
      const phrasesEn = [
        `"In rest mode. Recharging battery for tomorrow."`,
        `"Kirian is resting. Come back at sunrise."`,
        `"Servers stable. See you at the next commit."`,
      ];
      const idx = Math.floor(Math.random() * phrasesEs.length);
      return {
        badge: "[Kirian: AFK / Zzz]",
        text: isEs ? phrasesEs[idx] : phrasesEn[idx],
        sprite: "moon",
      };
    } else if (isWeekend) {
      const phrasesEs = [
        `"Limón: Cahuita protege el arrecife vivo más biodiverso."`,
        `"Limón: El Calypso es patrimonio inmaterial de Costa Rica."`,
        `"Limón: Concentra más del 4% de la biodiversidad mundial."`,
        `"Limón: Refugio costero de manatíes y delfines tucuxi."`,
        `"Limón: Auténtico rice and beans con leche de coco."`,
      ];
      const phrasesEn = [
        `"Limón: Cahuita protects Costa Rica's live coral reef."`,
        `"Limón: Calypso music is Costa Rican Cultural Heritage."`,
        `"Limón: Hosts over 4% of the planet's biodiversity."`,
        `"Limón: Coastal refuge for manatees & tucuxi dolphins."`,
        `"Limón: Authentic coconut rice & beans Caribbean craft."`,
      ];
      const idx = Math.floor(Math.random() * phrasesEs.length);
      return {
        badge: "[Kirian: Off Duty]",
        text: isEs ? phrasesEs[idx] : phrasesEn[idx],
        sprite: "palm",
      };
    } else {
      // Evening / Leisure
      const phrasesEs = [
        `"Fuera de horario laboral. Descansando la mente."`,
        `"Lejos de la pantalla. Nos vemos pronto."`,
        `"Tomando un respiro antes del próximo sprint."`,
      ];
      const phrasesEn = [
        `"Off work hours. Resting the mind."`,
        `"Away from the screen. Catch you soon."`,
        `"Taking a breather before the next sprint."`,
      ];
      const idx = Math.floor(Math.random() * phrasesEs.length);
      return {
        badge: "[Kirian: AFK]",
        text: isEs ? phrasesEs[idx] : phrasesEn[idx],
        sprite: "gamepad",
      };
    }
  }

  function applyPresence(lanyardData: any) {
    try {
      if (typeof window !== "undefined") {
        (window as any).__lastLanyardData = lanyardData;
      }
      const spotifyWidget = document.getElementById("spotify-widget");
      const gameWidget = document.getElementById("game-widget");
      const devWidget = document.getElementById("dev-status-widget");

      const songEl = document.getElementById("spotify-song");
      const artistEl = document.getElementById("spotify-artist");
      const sepEl = document.getElementById("spotify-separator");
      const linkEl = document.getElementById("spotify-link") as HTMLAnchorElement | null;
      const eqEl = document.getElementById("spotify-equalizer");
      const albumImg = document.getElementById("spotify-album-img") as HTMLImageElement | null;
      const vinylImg = document.getElementById("spotify-vinyl-img") as HTMLImageElement | null;

      const gameNameEl = document.getElementById("game-name");
      const gameDetailsEl = document.getElementById("game-details");
      const gameSepEl = document.getElementById("game-separator");

      const devBadge = document.getElementById("dev-status-badge");
      const devSprite = document.getElementById("dev-status-sprite");
      const devDialogue = document.getElementById("dev-status-dialogue");

      // 1. Spotify state directly from live Discord presence OR direct Spotify API
      let isSpotifyPlaying = false;
      let activeTrack: any = null;

      if (lanyardData?.listening_to_spotify && lanyardData.spotify) {
        isSpotifyPlaying = true;
        activeTrack = {
          title: lanyardData.spotify.song,
          artist: lanyardData.spotify.artist,
          albumImageUrl: lanyardData.spotify.album_art_url,
          songUrl: `https://open.spotify.com/track/${lanyardData.spotify.track_id}`,
        };
      } else if (lastDirectSpotifyState && lastDirectSpotifyState.isPlaying) {
        isSpotifyPlaying = true;
        activeTrack = {
          title: lastDirectSpotifyState.title,
          artist: lastDirectSpotifyState.artist,
          albumImageUrl: lastDirectSpotifyState.albumImageUrl,
          songUrl: lastDirectSpotifyState.songUrl,
        };
      }

      // 2. Gaming state directly from live Discord activities
      let game: { isPlaying: boolean; gameName: string; details?: string } | null = null;
      if (lanyardData?.activities) {
        const g = lanyardData.activities.find(
          (a: any) => (a.type === 0 || a.type === 1 || a.type === 5) && a.name !== "Spotify"
        );
        if (g && g.name) {
          game = {
            isPlaying: true,
            gameName: g.name,
            details: g.details || g.state || "",
          };
        }
      }
      const isGamePlaying = !!(game && game.isPlaying && game.gameName);

      // Render Spotify
      if (isSpotifyPlaying && activeTrack) {
        if (spotifyWidget) {
          spotifyWidget.classList.remove("hidden");
          spotifyWidget.classList.add("flex");
        }

        if (activeTrack.albumImageUrl) {
          if (albumImg && albumImg.src !== activeTrack.albumImageUrl) albumImg.src = activeTrack.albumImageUrl;
          if (vinylImg && vinylImg.src !== activeTrack.albumImageUrl) vinylImg.src = activeTrack.albumImageUrl;
        }

        if (songEl && songEl.textContent !== activeTrack.title) {
          decryptMotion(songEl, activeTrack.title, 18);
        }
        if (artistEl && artistEl.textContent !== activeTrack.artist) {
          decryptMotion(artistEl, activeTrack.artist || "", 20);
        }
        if (sepEl) sepEl.classList.remove("hidden");
        if (linkEl && activeTrack.songUrl) linkEl.href = activeTrack.songUrl;

        if (eqEl) {
          eqEl.classList.remove("hidden");
          eqEl.classList.add("inline-flex");
        }
      } else {
        if (spotifyWidget) {
          spotifyWidget.classList.add("hidden");
          spotifyWidget.classList.remove("flex");
        }
      }

      // Render Gaming
      if (isGamePlaying && game) {
        if (gameWidget) {
          gameWidget.classList.remove("hidden");
          gameWidget.classList.add("flex");
        }

        if (gameNameEl && gameNameEl.textContent !== game.gameName) {
          decryptMotion(gameNameEl, game.gameName, 18);
        }

        if (game.details) {
          if (gameDetailsEl) {
            gameDetailsEl.textContent = game.details;
            gameDetailsEl.classList.remove("hidden");
          }
          if (gameSepEl) gameSepEl.classList.remove("hidden");
        } else {
          if (gameDetailsEl) gameDetailsEl.classList.add("hidden");
          if (gameSepEl) gameSepEl.classList.add("hidden");
        }
      } else {
        if (gameWidget) {
          gameWidget.classList.add("hidden");
          gameWidget.classList.remove("flex");
        }
      }

      // Render Dev status when idle
      if (!isSpotifyPlaying && !isGamePlaying) {
        if (devWidget) {
          devWidget.classList.remove("hidden");
          devWidget.classList.add("flex");
        }

        const devInfo = getDevStatusDialogue();
        if (devBadge) devBadge.textContent = devInfo.badge;
        if (devSprite && devInfo.sprite && PIXEL_SPRITES[devInfo.sprite]) {
          devSprite.innerHTML = PIXEL_SPRITES[devInfo.sprite];
        }
        if (devDialogue && devDialogue.textContent !== devInfo.text && !(devDialogue as any)._decryptTimer) {
          devDialogue.title = devInfo.text;
          decryptMotion(devDialogue, devInfo.text, 14);
        }
      } else {
        if (devWidget) {
          devWidget.classList.add("hidden");
          devWidget.classList.remove("flex");
        }
      }
    } catch {}
  }

  let isUpdating = false;
  let lastDirectSpotifyState: any = null;

  async function checkDirectSpotify() {
    try {
      const spotifyRes = await fetchWithTimeout("/api/spotify", 3000);
      if (spotifyRes && spotifyRes.isPlaying) {
        lastDirectSpotifyState = spotifyRes;
      } else {
        lastDirectSpotifyState = null;
      }
    } catch {
      lastDirectSpotifyState = null;
    }
    return lastDirectSpotifyState;
  }

  async function loadSpotify() {
    if (isUpdating) return;
    isUpdating = true;

    try {
      // 1. Check Lanyard Discord presence
      const lanyardRes = await fetchWithTimeout(`https://api.lanyard.rest/v1/users/${DISCORD_USER_ID}`, 3000);
      const lanyardData = lanyardRes && lanyardRes.success && lanyardRes.data ? lanyardRes.data : null;

      // 2. If Discord is not reporting Spotify (e.g. Discord closed/offline), check Spotify Web API directly
      if (!lanyardData?.listening_to_spotify) {
        await checkDirectSpotify();
      } else {
        lastDirectSpotifyState = null;
      }

      applyPresence(lanyardData || {});
    } catch {
      // Fallback: check direct Spotify
      await checkDirectSpotify();
      applyPresence({});
    } finally {
      isUpdating = false;
    }
  }

  // Real-Time Lanyard WebSocket Connection (Instant Push Updates on song change / game switch)
  let lanyardSocket: WebSocket | null = null;
  let heartbeatInterval: any = null;

  function connectLanyardSocket() {
    if (typeof window === "undefined" || !("WebSocket" in window)) return;
    if (lanyardSocket && (lanyardSocket.readyState === WebSocket.OPEN || lanyardSocket.readyState === WebSocket.CONNECTING)) {
      return;
    }

    try {
      lanyardSocket = new WebSocket("wss://api.lanyard.rest/socket");

      lanyardSocket.onmessage = (event) => {
        try {
          const message = JSON.parse(event.data);
          const { op, d, t } = message;

          if (op === 1) {
            // Hello packet: start heartbeat & subscribe to user
            if (d && d.heartbeat_interval) {
              if (heartbeatInterval) clearInterval(heartbeatInterval);
              heartbeatInterval = setInterval(() => {
                if (lanyardSocket && lanyardSocket.readyState === WebSocket.OPEN) {
                  lanyardSocket.send(JSON.stringify({ op: 3 }));
                }
              }, d.heartbeat_interval);
            }

            // Subscribe to Kirian's live presence
            lanyardSocket.send(
              JSON.stringify({
                op: 2,
                d: { subscribe_to_id: DISCORD_USER_ID },
              })
            );
          } else if (op === 0) {
            // Event packet (INIT_STATE or PRESENCE_UPDATE)
            if (t === "INIT_STATE" || t === "PRESENCE_UPDATE") {
              if (d) {
                if (!d.listening_to_spotify) {
                  checkDirectSpotify().then(() => applyPresence(d));
                } else {
                  lastDirectSpotifyState = null;
                  applyPresence(d);
                }
              }
            }
          }
        } catch {}
      };

      lanyardSocket.onclose = () => {
        if (heartbeatInterval) clearInterval(heartbeatInterval);
        setTimeout(connectLanyardSocket, 5000);
      };

      lanyardSocket.onerror = () => {
        try { lanyardSocket?.close(); } catch {}
      };
    } catch {}
  }

  async function loadPostHogStats() {
    const container = document.getElementById("posthog-stats");
    if (!container) return;

    const isEs =
      document.documentElement.lang === "es" ||
      window.location.pathname.includes("/es/") ||
      window.location.pathname === "/es";

    try {
      const res = await fetch("/api/stats");
      if (res.ok) {
        const data = await res.json();
        const views = data.pageviews || 0;
        const visitors = data.visitors || 0;

        if (views > 0 || visitors > 0) {
          const fViews = new Intl.NumberFormat().format(views);
          const fVisitors = new Intl.NumberFormat().format(visitors);
          container.textContent = isEs
            ? `${fViews} vistas | Visitante #${fVisitors}`
            : `${fViews} views | Visitor #${fVisitors}`;
          container.classList.remove("opacity-0");
          container.classList.add("opacity-100");
        }
      }
    } catch {}
  }

  function init() {
    // 1. Immediately trigger the decrypt animation on page arrival (0ms wait!)
    const devInfo = getDevStatusDialogue();
    const devBadge = document.getElementById("dev-status-badge");
    const devSprite = document.getElementById("dev-status-sprite");
    const devDialogue = document.getElementById("dev-status-dialogue");
    if (devBadge) devBadge.textContent = devInfo.badge;
    if (devSprite && devInfo.sprite && PIXEL_SPRITES[devInfo.sprite]) {
      devSprite.innerHTML = PIXEL_SPRITES[devInfo.sprite];
    }
    if (devDialogue) {
      devDialogue.title = devInfo.text;
      decryptMotion(devDialogue, devInfo.text, 14);
    }

    // 2. Click re-trigger for decrypt animation
    const devWidget = document.getElementById("dev-status-widget");
    if (devWidget) {
      devWidget.onclick = () => {
        const info = getDevStatusDialogue();
        const dial = document.getElementById("dev-status-dialogue");
        if (dial) {
          decryptMotion(dial, info.text, 14);
        }
      };
    }

    // 3. Immediately apply cached presence if available in memory (0ms instant render)
    if (typeof window !== "undefined" && (window as any).__lastLanyardData) {
      applyPresence((window as any).__lastLanyardData);
    }
    loadSpotify();
    connectLanyardSocket();
    loadPostHogStats();
  }

  // Load immediately on page initialization and view transitions
  init();
  document.addEventListener("astro:page-load", init);

  // High-performance Mobile & Desktop Revalidation System
  if (typeof window !== "undefined") {
    let lastPoll = 0;
    const triggerRevalidation = () => {
      const now = Date.now();
      if (now - lastPoll > 2500) {
        lastPoll = now;
        loadSpotify();
        connectLanyardSocket();
      }
    };

    // 1. Regular 3s Polling when active as backup to WebSocket
    setInterval(() => {
      if (!document.hidden) {
        loadSpotify();
      }
    }, 3000);

    // 2. Mobile Instant Wakeup (Tab switch, App switch, Screen unlock, Page show)
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) {
        triggerRevalidation();
      }
    });

    window.addEventListener("pageshow", triggerRevalidation);
    window.addEventListener("focus", triggerRevalidation);

    // 3. Mobile touch or desktop hover instant revalidation
    const footerWrapper = document.getElementById("footer-status-wrapper");
    if (footerWrapper) {
      footerWrapper.addEventListener("touchstart", triggerRevalidation, { passive: true });
      footerWrapper.addEventListener("mouseenter", triggerRevalidation, { passive: true });
    }
  }
</script>
