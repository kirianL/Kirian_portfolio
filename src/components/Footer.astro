---
const currentLocale = Astro.currentLocale || "en";
const text = currentLocale === "es" ? "Hecho con <3" : "Made with <3";
---

<footer
  class="mt-6 text-center text-xs text-grayscale-10 font-mono border-t border-grayscale-3/40 dark:border-grayscale-3/20 pt-8"
>
  {text}<span id="umami-stats" class="opacity-0 transition-opacity duration-300"></span>
</footer>

<script>
  async function loadStats() {
    const container = document.getElementById('umami-stats');
    if (!container) return;
    
    const shareToken = import.meta.env.PUBLIC_UMAMI_SHARE_TOKEN || "IKILGPgXIuMcSBcX";
    
    try {
      // 1. Get the JWT token and metadata from the share endpoint
      const authRes = await fetch(`https://cloud.umami.is/analytics/us/api/share/${shareToken}`);
      if (!authRes.ok) return;
      const authData = await authRes.json();
      const token = authData.token;
      const websiteId = authData.websiteId;
      if (!token || !websiteId) return;

      // 2. Fetch stats using the shared token headers
      const startAt = new Date('2024-01-01').getTime();
      const endAt = Date.now();
      const statsRes = await fetch(`https://cloud.umami.is/analytics/us/api/websites/${websiteId}/stats?startAt=${startAt}&endAt=${endAt}`, {
        headers: {
          'x-umami-share-token': token,
          'x-umami-share-context': 'share'
        }
      });
      
      if (statsRes.ok) {
        const data = await statsRes.json();
        const views = data.pageviews || 0;
        const visitors = data.visitors || 0;
        if (views > 0) {
          const formattedViews = new Intl.NumberFormat().format(views);
          const formattedVisitors = new Intl.NumberFormat().format(visitors);
          const isEs = document.documentElement.lang === 'es' || window.location.pathname.includes('/es/');
          
          container.textContent = isEs 
            ? ` • ${formattedViews} vistas • Visitante #${formattedVisitors}` 
            : ` • ${formattedViews} views • Visitor #${formattedVisitors}`;
          container.classList.remove('opacity-0');
        }
      }
    } catch (e) {
      console.warn("Could not load Umami stats:", e);
    }
  }

  // Load on initial load
  loadStats();
  // Support Astro view transitions
  document.addEventListener('astro:page-load', loadStats);
</script>
