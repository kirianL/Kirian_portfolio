---
import { execSync } from "node:child_process";

const currentLocale = Astro.currentLocale || "en";

let lastUpdateDate = "";
try {
  const gitIso = execSync("git log -1 --format=%cI", { encoding: "utf-8" }).trim();
  const date = new Date(gitIso);
  lastUpdateDate = date.toLocaleDateString(currentLocale === "es" ? "es-CR" : "en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
} catch {
  lastUpdateDate = new Date().toLocaleDateString(currentLocale === "es" ? "es-CR" : "en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}

const updateLabel = currentLocale === "es" ? "Última actualización" : "Last update";
const listeningLabel = currentLocale === "es" ? "Escuchando ahora" : "Currently listening";
const playingLabel = currentLocale === "es" ? "Jugando ahora" : "Currently playing";

const defaultTrack = {
  title: "Die With A Smile",
  artist: "Lady Gaga, Bruno Mars",
  songUrl: "https://open.spotify.com/track/2plbrEY59IikOBgBGLjaoe",
  albumImageUrl: "https://i.scdn.co/image/ab67616d0000b2738278b782cba5a98e47f55b93",
};

// Fetch initial stats from PostHog at build time
let initialViews = 0;
let initialVisitors = 0;
try {
  const posthogApiKey =
    process.env.POSTHOG_PERSONAL_API_KEY ||
    import.meta.env.POSTHOG_PERSONAL_API_KEY;
  const posthogProjectId =
    process.env.POSTHOG_PROJECT_ID ||
    import.meta.env.POSTHOG_PROJECT_ID ||
    "657608";
  const posthogHost =
    process.env.PUBLIC_POSTHOG_HOST ||
    import.meta.env.PUBLIC_POSTHOG_HOST ||
    "https://us.i.posthog.com";

  if (posthogApiKey) {
    const res = await fetch(
      `${posthogHost}/api/projects/${posthogProjectId}/query/`,
      {
        method: "POST",
        headers: {
          Authorization: `Bearer ${posthogApiKey}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          query: {
            kind: "HogQLQuery",
            query:
              "SELECT count(), count(DISTINCT distinct_id) FROM events WHERE event = '$pageview'",
          },
        }),
      }
    );
    if (res.ok) {
      const data = await res.json();
      initialViews = 1964 + (Number(data?.results?.[0]?.[0]) || 0);
      initialVisitors = 257 + (Number(data?.results?.[0]?.[1]) || 0);
    }
  }
} catch {}

if (initialViews === 0) {
  initialViews = 1964;
  initialVisitors = 257;
}

const formattedViews = new Intl.NumberFormat().format(initialViews);
const formattedVisitors = new Intl.NumberFormat().format(initialVisitors);

const defaultDevSprite = `<svg viewBox="0 0 24 24" class="w-full h-full block" shape-rendering="crispEdges"><rect x="2" y="2" width="20" height="15" fill="#71717a"/><rect x="4" y="4" width="16" height="11" fill="#09090b"/><rect x="6" y="6" width="6" height="2" fill="#22c55e"/><rect x="6" y="9" width="10" height="2" fill="#4ade80"/><rect x="6" y="12" width="4" height="2" fill="#86efac"/><rect x="10" y="17" width="4" height="3" fill="#71717a"/><rect x="6" y="20" width="12" height="2" fill="#a1a1aa"/></svg>`;
const defaultBadge = "[Kirian: Online]";
const defaultDialogue =
  currentLocale === "es"
    ? `"Compilando nuevas ideas y puliendo interfaces."`
    : `"Crafting the next release."`;

const initialStatsText =
  currentLocale === "es"
    ? `${formattedViews} vistas | Visitante #${formattedVisitors}`
    : `${formattedViews} views | Visitor #${formattedVisitors}`;
---

<footer
  class="mt-6 text-center text-xs text-grayscale-10 font-mono border-t border-grayscale-3/40 dark:border-grayscale-3/20 pt-8 flex flex-col items-center justify-center gap-1.5"
>
  <!-- Active State Container (Fluid Dual Activity Stacking for Spotify & Gaming) -->
  <div id="footer-status-wrapper" class="flex flex-col items-center justify-center gap-y-1.5 text-xs text-center leading-relaxed py-0.5 px-3 max-w-full transition-all duration-300">
    <!-- 1. SPOTIFY LIVE ROW -->
    <div
      id="spotify-widget"
      class="hidden transition-all duration-300 flex-wrap items-center justify-center gap-x-1.5 gap-y-0.5 text-xs text-center leading-relaxed max-w-full"
    >
      <!-- Minimalist Spotify Icon -->
      <svg class="w-3.5 h-3.5 text-[#1DB954] shrink-0 inline-block align-middle" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
      </svg>

      <span class="text-grayscale-10 shrink-0">{listeningLabel}:</span>

      <!-- Hover Track Link -->
      <a
        id="spotify-link"
        href={defaultTrack.songUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-cuelume-hover="tick"
        class="spotify-track-container text-[#1DB954] dark:text-[#1ED760] no-underline font-medium inline-flex items-center gap-1.5 cursor-pointer text-center relative"
      >
        <!-- Song Title with Centered Tooltip Origin -->
        <span class="relative inline-flex items-center">
          <span id="spotify-song" class="font-mono tracking-tight text-[#1DB954] dark:text-[#1ED760]">{defaultTrack.title}</span>

          <!-- Floating Spinning Vinyl & Sleeve Popover -->
          <div
            id="spotify-album-preview"
            class="spotify-preview-card pointer-events-none flex flex-col items-center justify-center"
          >
            <div class="vinyl-preview-wrapper relative flex items-center justify-center">
              <!-- Spinning Vinyl Disc (Pure CSS Grooves, 0KB network overhead) -->
              <div class="vinyl-disc absolute w-[4.6rem] h-[4.6rem] sm:w-[5.2rem] sm:h-[5.2rem] rounded-full flex items-center justify-center">
                <!-- Center Album Mini Label -->
                <div class="relative w-6 h-6 sm:w-7 sm:h-7 rounded-full overflow-hidden border border-black/50 shadow-inner flex items-center justify-center bg-zinc-950">
                  <img
                    id="spotify-vinyl-img"
                    src={defaultTrack.albumImageUrl}
                    alt=""
                    width="28"
                    height="28"
                    class="w-full h-full object-cover block"
                    loading="lazy"
                  />
                  <div class="absolute w-1.5 h-1.5 rounded-full bg-zinc-950 border border-white/40"></div>
                </div>
              </div>

              <!-- Square Album Cover Sleeve (Front Layer) -->
              <div class="vinyl-sleeve relative z-10 w-20 h-20 sm:w-22 sm:h-22 aspect-square shrink-0 rounded-xl overflow-hidden shadow-[0_16px_36px_rgba(0,0,0,0.4)] ring-1 ring-black/15 dark:ring-white/20 bg-zinc-950">
                <img
                  id="spotify-album-img"
                  src={defaultTrack.albumImageUrl}
                  alt="Album Cover"
                  width="88"
                  height="88"
                  class="w-full h-full aspect-square object-contain block"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        </span>

        <span id="spotify-separator" class="text-grayscale-10 font-normal shrink-0">—</span>
        <span id="spotify-artist" class="text-grayscale-11 dark:text-grayscale-10 font-normal font-mono">{defaultTrack.artist}</span>

        <!-- Mini animated equalizer bars -->
        <span id="spotify-equalizer" class="hidden items-end gap-[1.5px] h-2.5 w-2.5 shrink-0 ml-0.5">
          <span class="w-[1.5px] h-full bg-[#1DB954] rounded-full animate-music-bar-1"></span>
          <span class="w-[1.5px] h-2/3 bg-[#1DB954] rounded-full animate-music-bar-2"></span>
          <span class="w-[1.5px] h-4/5 bg-[#1DB954] rounded-full animate-music-bar-3"></span>
        </span>
      </a>
    </div>

    <!-- 2. GAMING LIVE ROW (Clean Minimalist Design) -->
    <div
      id="game-widget"
      class="hidden transition-all duration-300 flex-wrap items-center justify-center gap-x-1.5 gap-y-0.5 text-xs text-center leading-relaxed max-w-full"
    >
      <!-- Gamepad Icon in Navy / Sky Blue -->
      <span class="w-3.5 h-3.5 shrink-0 inline-flex items-center justify-center animate-pixel-idle">
        <svg viewBox="0 0 24 24" class="w-full h-full block" shape-rendering="crispEdges"><rect x="3" y="6" width="18" height="11" fill="#0284c7"/><rect x="5" y="10" width="5" height="2" fill="#0f172a"/><rect x="6" y="8" width="2" height="6" fill="#0f172a"/><rect x="16" y="9" width="2" height="2" fill="#ef4444"/><rect x="18" y="11" width="2" height="2" fill="#38bdf8"/><rect x="14" y="11" width="2" height="2" fill="#eab308"/><rect x="16" y="13" width="2" height="2" fill="#22c55e"/></svg>
      </span>

      <span class="text-grayscale-10 shrink-0">{playingLabel}:</span>

      <!-- Game Name & Details in Navy Blue -->
      <span
        id="game-container"
        data-cuelume-hover="tick"
        data-cuelume-press
        data-cuelume-release
        class="game-track-container text-sky-700 dark:text-sky-400 no-underline font-medium inline-flex items-center gap-1.5 cursor-default text-center"
      >
        <span id="game-name" class="font-mono tracking-tight text-sky-700 dark:text-sky-400 font-semibold"></span>
        <span id="game-separator" class="text-grayscale-10 font-normal shrink-0 hidden">—</span>
        <span id="game-details" class="text-grayscale-11 dark:text-grayscale-10 font-normal font-mono hidden"></span>
      </span>
    </div>

    <!-- 3. RETRO PIXEL-SPRITE DEV STATUS (Active When Idle) -->
    <div
      id="dev-status-widget"
      data-cuelume-hover="tick"
      class="flex transition-all duration-300 flex-col sm:flex-row items-center justify-center gap-x-1.5 gap-y-0.5 text-[11px] sm:text-xs text-center leading-relaxed max-w-full select-none px-2"
    >
      <!-- Title & Sprite Group -->
      <div class="inline-flex items-center justify-center gap-1.5 whitespace-nowrap shrink-0">
        <span id="dev-status-sprite" class="w-4.5 h-4.5 sm:w-5 sm:h-5 shrink-0 inline-flex items-center justify-center animate-pixel-idle" set:html={defaultDevSprite}></span>
        <span id="dev-status-badge" class="font-mono text-zinc-900 dark:text-zinc-100 font-semibold whitespace-nowrap">{defaultBadge}</span>
        <span class="text-grayscale-10 font-mono hidden sm:inline shrink-0">›</span>
      </div>

      <!-- Dialogue text -->
      <span id="dev-status-dialogue" class="font-mono text-grayscale-11 dark:text-grayscale-10 italic text-center max-w-xs sm:max-w-none text-balance sm:whitespace-nowrap inline-flex items-center justify-center" data-rendered-text={defaultDialogue} title={defaultDialogue}>{defaultDialogue}</span>
    </div>
  </div>

  <p>{updateLabel}: {lastUpdateDate}</p>
  <p
    id="posthog-stats"
    class={`transition-opacity duration-300 ${initialStatsText ? "opacity-100" : "opacity-0"}`}
  >
    {initialStatsText}
  </p>
</footer>

<style is:global>
  .spotify-preview-card {
    position: absolute;
    bottom: calc(100% + 14px);
    left: 50%;
    transform: translate(-50%, 6px) scale(0.94);
    opacity: 0;
    visibility: hidden;
    filter: blur(4px);
    transition: opacity 0.18s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.22s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity, filter;
    z-index: 50;
  }

  .spotify-track-container:hover .spotify-preview-card {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translate(-50%, 0px) scale(1) !important;
    filter: blur(0px) !important;
  }

  /* Ultra-Fast Pure CSS Vinyl Disc */
  .vinyl-disc {
    background: radial-gradient(
      circle,
      #18181b 0%,
      #18181b 26%,
      #09090b 29%,
      #27272a 32%,
      #09090b 37%,
      #27272a 43%,
      #09090b 50%,
      #27272a 58%,
      #09090b 68%,
      #18181b 80%,
      #09090b 92%,
      #000000 100%
    );
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08), 0 8px 24px rgba(0, 0, 0, 0.5);
    transform: translate3d(0, 0, 0) rotate(0deg);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
    z-index: 1;
  }

  .vinyl-sleeve {
    transform: translate3d(0, 0, 0);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  /* Hover Reveal: Sleeve shifts left, Vinyl slides right and spins continuously */
  .spotify-track-container:hover .vinyl-sleeve {
    transform: translate3d(-14px, 0, 0);
  }

  .spotify-track-container:hover .vinyl-disc {
    transform: translate3d(22px, 0, 0) rotate(360deg);
    animation: vinyl-spin 3s linear infinite;
    animation-delay: 0.22s;
  }

  @keyframes vinyl-spin {
    from {
      transform: translate3d(22px, 0, 0) rotate(0deg);
    }
    to {
      transform: translate3d(22px, 0, 0) rotate(360deg);
    }
  }

  /* Retro Sprite Idle Bobbing */
  @keyframes pixel-bob {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-1.5px); }
  }
  .animate-pixel-idle {
    animation: pixel-bob 2s ease-in-out infinite;
  }

  @keyframes music-bar-1 {
    0%, 100% { height: 25%; }
    50% { height: 100%; }
  }
  @keyframes music-bar-2 {
    0%, 100% { height: 100%; }
    50% { height: 35%; }
  }
  @keyframes music-bar-3 {
    0%, 100% { height: 60%; }
    50% { height: 95%; }
  }
  .animate-music-bar-1 {
    animation: music-bar-1 0.8s ease-in-out infinite;
  }
  .animate-music-bar-2 {
    animation: music-bar-2 0.7s ease-in-out infinite;
  }
  .animate-music-bar-3 {
    animation: music-bar-3 0.9s ease-in-out infinite;
  }
</style>

<script>
  const GLYPHS = "01!@#$%^&*~_+-=<>?/\\[]{}AaBbCcDdEeFfGgHh";
  const DISCORD_USER_ID = "609201692935847978";

  const PIXEL_SPRITES: Record<string, string> = {
    pc: `<svg viewBox="0 0 24 24" class="w-full h-full block" shape-rendering="crispEdges"><rect x="2" y="2" width="20" height="15" fill="#71717a"/><rect x="4" y="4" width="16" height="11" fill="#09090b"/><rect x="6" y="6" width="6" height="2" fill="#22c55e"/><rect x="6" y="9" width="10" height="2" fill="#4ade80"/><rect x="6" y="12" width="4" height="2" fill="#86efac"/><rect x="10" y="17" width="4" height="3" fill="#71717a"/><rect x="6" y="20" width="12" height="2" fill="#a1a1aa"/></svg>`,
    palm: `<svg viewBox="0 0 24 24" class="w-full h-full block" shape-rendering="crispEdges"><rect x="9" y="2" width="6" height="3" fill="#10b981"/><rect x="4" y="4" width="5" height="3" fill="#059669"/><rect x="15" y="4" width="5" height="3" fill="#059669"/><rect x="2" y="7" width="4" height="3" fill="#047857"/><rect x="18" y="7" width="4" height="3" fill="#047857"/><rect x="9" y="6" width="3" height="3" fill="#78350f"/><rect x="12" y="7" width="3" height="3" fill="#92400e"/><rect x="11" y="9" width="3" height="3" fill="#b45309"/><rect x="10" y="12" width="3" height="4" fill="#92400e"/><rect x="11" y="16" width="3" height="5" fill="#78350f"/><rect x="5" y="21" width="14" height="2" fill="#f59e0b"/></svg>`,
    drum: `<svg viewBox="0 0 24 24" class="w-full h-full block" shape-rendering="crispEdges"><rect x="6" y="2" width="12" height="3" fill="#fde047"/><rect x="4" y="5" width="16" height="2" fill="#ca8a04"/><rect x="5" y="7" width="14" height="3" fill="#ef4444"/><rect x="5" y="10" width="14" height="3" fill="#f59e0b"/><rect x="6" y="13" width="12" height="3" fill="#10b981"/><rect x="7" y="16" width="10" height="4" fill="#854d0e"/><rect x="6" y="20" width="12" height="2" fill="#ca8a04"/></svg>`,
