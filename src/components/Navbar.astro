---
const currentLocale = Astro.currentLocale || 'en';

// Localized navigation labels
const navLabels = {
  en: {
    home: 'Home',
    projects: 'Projects',
    blog: 'Blog',
    skills: 'Skills',
    contact: 'Contact',
    agency: 'Agency'
  },
  es: {
    home: 'Inicio',
    projects: 'Proyectos',
    blog: 'Blog',
    skills: 'Habilidades',
    contact: 'Contacto',
    agency: 'Agencia'
  }
}[currentLocale as 'en' | 'es'];

// Get localized prefix (empty for 'en', '/es' for Spanish, etc.)
const localePrefix = currentLocale === 'en' ? '' : `/${currentLocale}`;
const homePath = currentLocale === 'en' ? '/' : `/${currentLocale}/`;

const pathname = Astro.url.pathname;

// Mapping for blog posts to keep translation on detail pages
const blogMapping: Record<string, string> = {
  '/blog/digitalizing-a-cultural-identity': '/es/blog/digitalizar-una-identidad-cultural',
  '/blog/digitalizing-a-cultural-identity/': '/es/blog/digitalizar-una-identidad-cultural/',
  '/es/blog/digitalizar-una-identidad-cultural': '/blog/digitalizing-a-cultural-identity',
  '/es/blog/digitalizar-una-identidad-cultural/': '/blog/digitalizing-a-cultural-identity/',
};

let enPath = '/';
let esPath = '/es/';

if (blogMapping[pathname]) {
  if (currentLocale === 'en') {
    enPath = pathname;
    esPath = blogMapping[pathname];
  } else {
    esPath = pathname;
    enPath = blogMapping[pathname];
  }
} else if (pathname === '/blog' || pathname === '/blog/') {
  enPath = '/blog/';
  esPath = '/es/blog/';
} else if (pathname === '/es/blog' || pathname === '/es/blog/') {
  enPath = '/blog/';
  esPath = '/es/blog/';
} else if (pathname.startsWith('/es/')) {
  enPath = pathname.replace(/^\/es/, '') || '/';
  esPath = pathname;
} else if (pathname !== '/') {
  enPath = pathname;
  esPath = `/es${pathname}`;
}
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-background/60 backdrop-blur-md">
  <div class="max-w-xl mx-auto px-4 sm:px-0 py-5 flex items-center justify-between">
    <!-- Brand / Logo Link -->
    <a href={homePath} class="text-sm font-semibold tracking-tight text-primary-text hover:text-primary transition-colors">
      {navLabels.home}
    </a>

    <!-- Nav Links + Language Selector -->
    <div class="flex items-center gap-5">
      <div class="flex items-center gap-3.5 text-xs font-medium text-muted-text">
        <a href={`${homePath}#proyectos`} class="hover:text-primary-text transition-colors">{navLabels.projects}</a>
        <a href={`${localePrefix || ''}/blog/`} class="hover:text-primary-text transition-colors">{navLabels.blog}</a>
        <a href={`${homePath}#habilidades`} class="hidden md:inline hover:text-primary-text transition-colors">{navLabels.skills}</a>
        <a href={`${homePath}#contacto`} class="hidden md:inline hover:text-primary-text transition-colors">{navLabels.contact}</a>
        <a href="https://sorinlabs.dev" target="_blank" rel="noopener noreferrer" class="hover:text-primary-text transition-colors flex items-center gap-0.5 group/agency">
          {navLabels.agency}
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-2.5 h-2.5 opacity-60 group-hover/agency:opacity-100 group-hover/agency:translate-x-0.5 group-hover/agency:-translate-y-0.5 transition-all duration-200"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
        </a>
      </div>

      <!-- Language Selector (Minimalist active-pills layout) -->
      <div class="flex items-center gap-0.5 font-mono text-[10px] text-muted-text bg-muted-secondary/40 p-0.5 rounded-lg border border-border/20">
        <a 
          href={enPath} 
          class={`px-2 py-0.5 rounded-md transition-all duration-150 ${currentLocale === 'en' ? 'bg-card-surface text-primary-text font-bold shadow-xs' : 'hover:text-primary-text'}`}
        >
          EN
        </a>
        <a 
          href={esPath} 
          class={`px-2 py-0.5 rounded-md transition-all duration-150 ${currentLocale === 'es' ? 'bg-card-surface text-primary-text font-bold shadow-xs' : 'hover:text-primary-text'}`}
        >
          ES
        </a>
      </div>
    </div>
  </div>
</nav>
