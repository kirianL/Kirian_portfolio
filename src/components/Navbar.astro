---
const currentLocale = Astro.currentLocale || "en";

// Localized navigation labels
const navLabels = {
  en: {
    home: "Home",
    projects: "Projects",
    blog: "Blog",
    skills: "Skills",
    contact: "Contact",
    agency: "Agency",
  },
  es: {
    home: "Inicio",
    projects: "Proyectos",
    blog: "Blog",
    skills: "Habilidades",
    contact: "Contacto",
    agency: "Agencia",
  },
}[currentLocale as "en" | "es"];

// Get localized prefix (empty for 'en', '/es' for Spanish, etc.)
const localePrefix = currentLocale === "en" ? "" : `/${currentLocale}`;
const homePath = currentLocale === "en" ? "/" : `/${currentLocale}/`;

const pathname = Astro.url.pathname;

// Mapping for blog posts to keep translation on detail pages
const blogMapping: Record<string, string> = {
  "/blog/digitalizing-a-cultural-identity":
    "/es/blog/digitalizar-una-identidad-cultural",
  "/blog/digitalizing-a-cultural-identity/":
    "/es/blog/digitalizar-una-identidad-cultural/",
  "/es/blog/digitalizar-una-identidad-cultural":
    "/blog/digitalizing-a-cultural-identity",
  "/es/blog/digitalizar-una-identidad-cultural/":
    "/blog/digitalizing-a-cultural-identity/",
};

let enPath = "/";
let esPath = "/es/";

if (blogMapping[pathname]) {
  if (currentLocale === "en") {
    enPath = pathname;
    esPath = blogMapping[pathname];
  } else {
    esPath = pathname;
    enPath = blogMapping[pathname];
  }
} else if (pathname === "/blog" || pathname === "/blog/") {
  enPath = "/blog/";
  esPath = "/es/blog/";
} else if (pathname === "/es/blog" || pathname === "/es/blog/") {
  enPath = "/blog/";
  esPath = "/es/blog/";
} else if (pathname.startsWith("/es/")) {
  enPath = pathname.replace(/^\/es/, "") || "/";
  esPath = pathname;
} else if (pathname !== "/") {
  enPath = pathname;
  esPath = `/es${pathname}`;
}
---

<nav
  class="fixed top-0 left-0 right-0 z-50 bg-grayscale-1/70 backdrop-blur-md border-b border-grayscale-3/40 dark:border-grayscale-3/20 transition-all duration-200"
>
  <div
    class="max-w-2xl mx-auto px-4 sm:px-0 py-4 flex items-center justify-between"
  >
    <!-- Brand / Logo Link -->
    <a
      href={homePath}
      data-cuelume-hover="tick"
      data-cuelume-press="page"
      data-cuelume-release="release"
      class="text-xs sm:text-sm font-semibold tracking-tight text-grayscale-12 hover:text-accent-9 transition-colors"
    >
      {navLabels.home}
    </a>

    <!-- Nav Links + Language Selector -->
    <div class="flex items-center gap-2.5 sm:gap-5">
      <div
        class="flex items-center gap-2.5 sm:gap-4 text-[11px] sm:text-[12.5px] font-medium text-grayscale-11"
      >
        <a
          href={`${localePrefix || ""}/projects/`}
          data-cuelume-hover="tick"
          data-cuelume-press="page"
          data-cuelume-release="release"
          class="hover:text-grayscale-12 transition-colors"
          >{navLabels.projects}</a
        >
        <a
          href={`${localePrefix || ""}/blog/`}
          data-cuelume-hover="tick"
          data-cuelume-press="page"
          data-cuelume-release="release"
          class="hover:text-grayscale-12 transition-colors">{navLabels.blog}</a
        >
        <a
          href={`${localePrefix || ""}/contact/`}
          data-cuelume-hover="tick"
          data-cuelume-press="page"
          data-cuelume-release="release"
          class="hover:text-grayscale-12 transition-colors"
          >{navLabels.contact}</a
        >
        <a
          href="https://sorinlabs.dev"
          target="_blank"
          rel="noopener noreferrer"
          data-cuelume-hover="tick"
          data-cuelume-press="scan"
          class="hover:text-grayscale-12 transition-colors flex items-center gap-0.5 group/agency"
        >
          {navLabels.agency}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="10"
            height="10"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-2.5 h-2.5 opacity-60 group-hover/agency:opacity-100 group-hover/agency:translate-x-0.5 group-hover/agency:-translate-y-0.5 transition-all duration-200"
            ><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg
          >
        </a>
      </div>

      <!-- Language Selector (Minimalist active-pills layout, quiet & bordered) -->
      <div
        class="flex items-center gap-0.5 font-mono text-[10px] text-grayscale-10 bg-grayscale-2/60 p-0.5 rounded-lg border border-grayscale-3/40 shrink-0"
      >
        <a
          href={enPath}
          data-cuelume-hover="tick"
          data-cuelume-toggle
          class={`px-1.5 sm:px-2 py-0.5 rounded-md transition-all duration-150 ${currentLocale === "en" ? "bg-white dark:bg-grayscale-3 text-grayscale-12 font-bold shadow-3xs" : "hover:text-grayscale-12"}`}
        >
          EN
        </a>
        <a
          href={esPath}
          data-cuelume-hover="tick"
          data-cuelume-toggle
          class={`px-1.5 sm:px-2 py-0.5 rounded-md transition-all duration-150 ${currentLocale === "es" ? "bg-white dark:bg-grayscale-3 text-grayscale-12 font-bold shadow-3xs" : "hover:text-grayscale-12"}`}
        >
          ES
        </a>
      </div>
    </div>
  </div>
</nav>
