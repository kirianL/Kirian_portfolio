---
const currentLocale = Astro.currentLocale || "en";

// Localized navigation labels
const navLabels = {
  en: {
    home: "Home",
    projects: "Projects",
    craft: "Craft",
    blog: "Blog",
    skills: "Skills",
    contact: "Contact",
    agency: "Agency",
  },
  es: {
    home: "Inicio",
    projects: "Proyectos",
    craft: "Craft",
    blog: "Blog",
    skills: "Habilidades",
    contact: "Contacto",
    agency: "Agencia",
  },
}[currentLocale as "en" | "es"];

// Get localized prefix (empty for 'en', '/es' for Spanish, etc.)
const localePrefix = currentLocale === "en" ? "" : `/${currentLocale}`;
const homePath = currentLocale === "en" ? "/" : `/${currentLocale}/`;

const pathname = Astro.url.pathname;

// Mapping for blog posts to keep translation on detail pages
const blogMapping: Record<string, string> = {
  "/blog/digitalizing-a-cultural-identity":
    "/es/blog/digitalizar-una-identidad-cultural",
  "/blog/digitalizing-a-cultural-identity/":
    "/es/blog/digitalizar-una-identidad-cultural/",
  "/es/blog/digitalizar-una-identidad-cultural":
    "/blog/digitalizing-a-cultural-identity",
  "/es/blog/digitalizar-una-identidad-cultural/":
    "/blog/digitalizing-a-cultural-identity/",
};

const cleanCurrent = pathname.replace(/\/$/, "");
let enPath = "/";
let esPath = "/es/";

if (blogMapping[pathname] || blogMapping[`${pathname}/`]) {
  const match = blogMapping[pathname] || blogMapping[`${pathname}/`];
  if (currentLocale === "en") {
    enPath = pathname;
    esPath = match;
  } else {
    esPath = pathname;
    enPath = match;
  }
} else if (cleanCurrent.startsWith("/es")) {
  const base = cleanCurrent.replace(/^\/es/, "") || "";
  enPath = base ? `${base}/` : "/";
  esPath = `${cleanCurrent}/`;
} else {
  enPath = cleanCurrent ? `${cleanCurrent}/` : "/";
  esPath = cleanCurrent ? `/es${cleanCurrent}/` : "/es/";
}
---

<nav
  class="fixed top-0 left-0 right-0 z-50 bg-grayscale-1/70 backdrop-blur-md border-b border-grayscale-3/40 dark:border-grayscale-3/20 transition-colors duration-200"
>
  <div
    class="max-w-2xl mx-auto px-6 sm:px-0 py-4 flex items-center justify-between"
  >
    <!-- Brand / Logo Link -->
    <a
      href={homePath}
      data-astro-prefetch="viewport"
      data-cuelume-hover="tick"
      data-cuelume-press="page"
      data-cuelume-release="release"
      class="text-xs sm:text-sm font-semibold tracking-tight text-grayscale-12 hover:text-accent-9 transition-colors"
    >
      {navLabels.home}
    </a>

    <!-- Nav Links + Language Selector -->
    <div class="flex items-center gap-1.5 sm:gap-5">
      <div
        class="flex items-center gap-2 sm:gap-4 text-[11px] sm:text-[12.5px] font-medium text-grayscale-11 shrink-0"
      >
        <a
          href={`${localePrefix || ""}/projects/`}
          data-astro-prefetch="viewport"
          data-cuelume-hover="tick"
          data-cuelume-press="page"
          data-cuelume-release="release"
          class={`hover:text-grayscale-12 transition-colors ${pathname.includes("/projects") ? "text-grayscale-12 font-semibold" : ""}`}
          >{navLabels.projects}</a
        >
        <a
          href={`${localePrefix || ""}/craft/`}
          data-astro-prefetch="viewport"
          data-cuelume-hover="tick"
          data-cuelume-press="page"
          data-cuelume-release="release"
          class={`hover:text-grayscale-12 transition-colors ${pathname.includes("/craft") ? "text-grayscale-12 font-semibold" : ""}`}
          >{navLabels.craft}</a
        >
        <a
          href={`${localePrefix || ""}/blog/`}
          data-astro-prefetch="viewport"
          data-cuelume-hover="tick"
          data-cuelume-press="page"
          data-cuelume-release="release"
          class={`hover:text-grayscale-12 transition-colors ${pathname.includes("/blog") ? "text-grayscale-12 font-semibold" : ""}`}
          >{navLabels.blog}</a
        >
        <a
          href={`${localePrefix || ""}/contact/`}
          data-astro-prefetch="viewport"
          data-cuelume-hover="tick"
          data-cuelume-press="page"
          data-cuelume-release="release"
          class={`hover:text-grayscale-12 transition-colors ${pathname.includes("/contact") ? "text-grayscale-12 font-semibold" : ""}`}
          >{navLabels.contact}</a
        >
        <a
          href="https://sorinlabs.dev"
          target="_blank"
          rel="noopener noreferrer"
          data-cuelume-hover="tick"
          data-cuelume-press="scan"
          class="hover:text-grayscale-12 transition-colors hidden sm:flex items-center gap-0.5 group/agency"
        >
          {navLabels.agency}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="10"
            height="10"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-2.5 h-2.5 opacity-60 group-hover/agency:opacity-100 group-hover/agency:translate-x-0.5 group-hover/agency:-translate-y-0.5 transition-all duration-200"
            ><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg
          >
        </a>
      </div>

      <!-- Theme Switcher + Language Selector Container -->
      <div class="flex items-center gap-1.5 shrink-0">
        <!-- Theme Toggle Button (Naked icon, no container box) -->
        <button
          id="theme-toggle"
          type="button"
          aria-label={currentLocale === "es" ? "Cambiar modo de color" : "Toggle color theme"}
          title={currentLocale === "es" ? "Cambiar modo de color" : "Toggle color theme"}
          data-cuelume-hover="tick"
          data-cuelume-toggle
          class="group flex items-center justify-center p-1 text-grayscale-10 hover:text-grayscale-12 shrink-0 transition-all duration-200 cursor-pointer focus:outline-hidden active:scale-90"
        >
          <!-- Sun Icon (visible in dark mode) -->
          <svg
            id="theme-toggle-sun"
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="hidden dark:block text-amber-400 group-hover:text-amber-300 transition-transform duration-300 group-hover:rotate-12 group-hover:scale-105"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
          </svg>

          <!-- Moon Icon (visible in light mode) -->
          <svg
            id="theme-toggle-moon"
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="block dark:hidden text-grayscale-11 group-hover:text-grayscale-12 transition-transform duration-300 group-hover:-rotate-12 group-hover:scale-105"
          >
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </button>

        <!-- Language Selector (Minimalist active-pills layout, quiet & bordered) -->
        <div
          class="flex items-center gap-0.5 font-mono text-[10px] text-grayscale-10 bg-grayscale-2/60 p-0.5 rounded-lg border border-grayscale-3/40 shrink-0"
        >
          <a
            href={enPath}
            data-astro-prefetch="viewport"
            data-lang-switch
            data-cuelume-hover="tick"
            data-cuelume-toggle
            class={`px-1.5 sm:px-2 py-0.5 rounded-md transition-all duration-150 ${currentLocale === "en" ? "bg-white dark:bg-grayscale-3 text-grayscale-12 font-bold shadow-3xs" : "hover:text-grayscale-12"}`}
          >
            EN
          </a>
          <a
            href={esPath}
            data-astro-prefetch="viewport"
            data-lang-switch
            data-cuelume-hover="tick"
            data-cuelume-toggle
            class={`px-1.5 sm:px-2 py-0.5 rounded-md transition-all duration-150 ${currentLocale === "es" ? "bg-white dark:bg-grayscale-3 text-grayscale-12 font-bold shadow-3xs" : "hover:text-grayscale-12"}`}
          >
            ES
          </a>
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  const initNavbarInteractions = () => {
    // 1. Theme Toggle Button
    const toggleBtn = document.getElementById("theme-toggle");
    if (toggleBtn) {
      toggleBtn.onclick = (e) => {
        e.preventDefault();

        // Trigger fluid spring spin animation on the icon
        toggleBtn.classList.remove("animate-theme-spin");
        void toggleBtn.offsetWidth;
        toggleBtn.classList.add("animate-theme-spin");
        setTimeout(() => toggleBtn.classList.remove("animate-theme-spin"), 450);

        // Temporarily disable transitions for 100% instant theme switching across all elements
        document.documentElement.classList.add("disable-transitions");

        const isDark = document.documentElement.classList.contains("dark");
        const nextIsDark = !isDark;
        if (isDark) {
          document.documentElement.classList.remove("dark");
          document.documentElement.classList.add("light");
          localStorage.setItem("theme", "light");
        } else {
          document.documentElement.classList.add("dark");
          document.documentElement.classList.remove("light");
          localStorage.setItem("theme", "dark");
        }

        document.documentElement.style.colorScheme = nextIsDark ? "dark" : "light";
        document.documentElement.style.backgroundColor = nextColor;

        // Instantly update all theme-color meta tags for iOS Safari status bar
        const nextColor = nextIsDark ? "#111113" : "#ffffff";
        document.querySelectorAll('meta[name="theme-color"]').forEach((m) => {
          m.setAttribute("content", nextColor);
        });

        // Force synchronous style recalculation flush
        window.getComputedStyle(document.documentElement).opacity;

        // Re-enable normal transitions after layout paint
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            document.documentElement.classList.remove("disable-transitions");
          });
        });
      };
    }

    // 2. Language Switch Scroll Preservation (Keep exact scroll position when toggling ES/EN)
    const langLinks = document.querySelectorAll("[data-lang-switch]");
    langLinks.forEach((link) => {
      link.addEventListener("click", () => {
        const scrollY = window.scrollY || document.documentElement.scrollTop || 0;
        sessionStorage.setItem("portfolio_lang_scroll", scrollY.toString());
      });
    });
  };

  const restoreLangScroll = () => {
    const savedScroll = sessionStorage.getItem("portfolio_lang_scroll");
    if (savedScroll !== null) {
      const targetY = parseInt(savedScroll, 10);
      window.scrollTo({ top: targetY, behavior: "instant" });
      requestAnimationFrame(() => {
        window.scrollTo({ top: targetY, behavior: "instant" });
        sessionStorage.removeItem("portfolio_lang_scroll");
      });
    }
  };

  initNavbarInteractions();
  restoreLangScroll();

  document.addEventListener("astro:page-load", () => {
    initNavbarInteractions();
    restoreLangScroll();
  });

  document.addEventListener("astro:before-swap", (e: any) => {
    const savedScroll = sessionStorage.getItem("portfolio_lang_scroll");
    if (savedScroll !== null && e.newDocument) {
      e.newDocument.documentElement.scrollTop = parseInt(savedScroll, 10);
    }
  });
</script>
