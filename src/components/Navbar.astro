---
const currentLocale = Astro.currentLocale || "en";

// Localized navigation labels
const navLabels = {
  en: {
    home: "Home",
    projects: "Projects",
    blog: "Blog",
    skills: "Skills",
    contact: "Contact",
    agency: "Agency",
  },
  es: {
    home: "Inicio",
    projects: "Proyectos",
    blog: "Blog",
    skills: "Habilidades",
    contact: "Contacto",
    agency: "Agencia",
  },
}[currentLocale as "en" | "es"];

// Get localized prefix (empty for 'en', '/es' for Spanish, etc.)
const localePrefix = currentLocale === "en" ? "" : `/${currentLocale}`;
const homePath = currentLocale === "en" ? "/" : `/${currentLocale}/`;

const pathname = Astro.url.pathname;

// Mapping for blog posts to keep translation on detail pages
const blogMapping: Record<string, string> = {
  "/blog/digitalizing-a-cultural-identity":
    "/es/blog/digitalizar-una-identidad-cultural",
  "/blog/digitalizing-a-cultural-identity/":
    "/es/blog/digitalizar-una-identidad-cultural/",
  "/es/blog/digitalizar-una-identidad-cultural":
    "/blog/digitalizing-a-cultural-identity",
  "/es/blog/digitalizar-una-identidad-cultural/":
    "/blog/digitalizing-a-cultural-identity/",
};

const cleanCurrent = pathname.replace(/\/$/, "");
let enPath = "/";
let esPath = "/es/";

if (blogMapping[pathname] || blogMapping[`${pathname}/`]) {
  const match = blogMapping[pathname] || blogMapping[`${pathname}/`];
  if (currentLocale === "en") {
    enPath = pathname;
    esPath = match;
  } else {
    esPath = pathname;
    enPath = match;
  }
} else if (cleanCurrent.startsWith("/es")) {
  const base = cleanCurrent.replace(/^\/es/, "") || "";
  enPath = base ? `${base}/` : "/";
  esPath = `${cleanCurrent}/`;
} else {
  enPath = cleanCurrent ? `${cleanCurrent}/` : "/";
  esPath = cleanCurrent ? `/es${cleanCurrent}/` : "/es/";
}
---

<nav
  id="main-navbar"
  transition:persist="main-navbar"
  class="fixed top-0 left-0 right-0 z-50 bg-grayscale-1/70 backdrop-blur-md border-b border-grayscale-3/40 dark:border-grayscale-3/20 transition-colors duration-200"
  style="padding-top: env(safe-area-inset-top);"
>
  <div
    class="max-w-2xl mx-auto px-4 sm:px-0 py-2.5 sm:py-3 flex items-center justify-between gap-2"
  >
    <!-- Brand / Logo Link -->
    <a
      id="nav-brand-logo"
      href={homePath}
      data-astro-prefetch="viewport"
      data-cuelume-hover="tick"
      data-cuelume-press="page"
      data-cuelume-release="release"
      class="flex items-center gap-2 group text-xs sm:text-sm font-semibold tracking-tight text-grayscale-12 hover:text-accent-9 transition-colors shrink-0"
      aria-label={navLabels.home}
    >
      <img
        src="/LogoKirian.png"
        alt="Kirian Luna"
        width="32"
        height="32"
        class="w-6 h-6 sm:w-8 sm:h-8 aspect-square object-contain dark:invert transition-transform group-hover:scale-105 shrink-0"
      />
    </a>

    <!-- Nav Links + Language Selector -->
    <div class="flex items-center gap-1.5 sm:gap-5 min-w-0">
      <div
        class="hidden sm:flex items-center gap-4 text-[12.5px] font-medium text-grayscale-11 shrink-0"
      >
        <a
          id="nav-link-projects"
          href={`${localePrefix || ""}/projects`}
          data-astro-prefetch="viewport"
          data-cuelume-hover="tick"
          data-cuelume-press="page"
          data-cuelume-release="release"
          class={`hover:text-grayscale-12 transition-colors ${pathname.includes("/projects") ? "text-grayscale-12 font-semibold" : ""}`}
          >{navLabels.projects}</a
        >
        <a
          id="nav-link-blog"
          href={`${localePrefix || ""}/blog`}
          data-astro-prefetch="viewport"
          data-cuelume-hover="tick"
          data-cuelume-press="page"
          data-cuelume-release="release"
          class={`hover:text-grayscale-12 transition-colors ${pathname.includes("/blog") ? "text-grayscale-12 font-semibold" : ""}`}
          >{navLabels.blog}</a
        >
        <a
          id="nav-link-contact"
          href={`${localePrefix || ""}/contact`}
          data-astro-prefetch="viewport"
          data-cuelume-hover="tick"
          data-cuelume-press="page"
          data-cuelume-release="release"
          class={`hover:text-grayscale-12 transition-colors ${pathname.includes("/contact") ? "text-grayscale-12 font-semibold" : ""}`}
          >{navLabels.contact}</a
        >
        <a
          id="nav-link-agency"
          href="https://sorinlabs.dev"
          target="_blank"
          rel="noopener noreferrer"
          data-cuelume-hover="tick"
          data-cuelume-press="scan"
          class="hover:text-grayscale-12 transition-colors flex items-center gap-0.5 group/agency"
        >
          <span id="nav-text-agency">{navLabels.agency}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="10"
            height="10"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-2.5 h-2.5 opacity-60 group-hover/agency:opacity-100 group-hover/agency:translate-x-0.5 group-hover/agency:-translate-y-0.5 transition-[transform,opacity] duration-200"
            ><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg
          >
        </a>
      </div>

      <!-- Theme Switcher + Language Selector + Mobile Menu Trigger -->
      <div class="flex items-center gap-1.5 shrink-0">
        <!-- Theme Toggle Button (Naked icon, no container box) -->
        <button
          id="theme-toggle"
          type="button"
          aria-label={currentLocale === "es" ? "Cambiar modo de color" : "Toggle color theme"}
          title={currentLocale === "es" ? "Cambiar modo de color" : "Toggle color theme"}
          data-cuelume-hover="tick"
          data-cuelume-toggle
          class="group flex items-center justify-center min-w-7 min-h-7 p-1.5 rounded-md text-grayscale-10 hover:text-grayscale-12 shrink-0 transition-[color,transform] duration-200 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-9 focus-visible:ring-offset-2 active:scale-[0.96]"
        >
          <!-- Sun Icon (visible in dark mode) -->
          <svg
            id="theme-toggle-sun"
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="hidden dark:block text-amber-400 group-hover:text-amber-300 transition-transform duration-300 group-hover:rotate-12 group-hover:scale-105"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
          </svg>

          <!-- Moon Icon (visible in light mode) -->
          <svg
            id="theme-toggle-moon"
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="block dark:hidden text-grayscale-11 group-hover:text-grayscale-12 transition-transform duration-300 group-hover:-rotate-12 group-hover:scale-105"
          >
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </button>

        <!-- Language Selector (Minimalist active-pills layout with Costa Rica micro-animation) -->
        <div
          class="flex items-center gap-0.5 font-mono text-[10px] text-grayscale-10 bg-grayscale-2/60 p-0.5 rounded-lg border border-grayscale-3/40 shrink-0"
        >
          <a
            id="lang-btn-en"
            href={enPath}
            data-astro-prefetch="viewport"
            data-lang-switch
            data-cuelume-hover="tick"
            data-cuelume-toggle
            aria-label="Switch to English"
            title="English"
            class={`px-1.5 sm:px-2 py-0.5 rounded-md transition-[color,background-color,box-shadow] duration-150 ${currentLocale === "en" ? "bg-white dark:bg-grayscale-3 text-grayscale-12 font-bold shadow-3xs" : "hover:text-grayscale-12"}`}
          >
            EN
          </a>
          <a
            id="lang-btn-es"
            href={esPath}
            data-astro-prefetch="viewport"
            data-lang-switch
            data-cuelume-hover="tick"
            data-cuelume-toggle
            aria-label="Español (Costa Rica)"
            title="Español (Costa Rica)"
            class={`cr-tico-btn px-1.5 sm:px-2 py-0.5 rounded-md transition-[opacity,background-color,box-shadow] duration-200 flex items-center justify-center ${currentLocale === "es" ? "bg-white dark:bg-grayscale-3 text-grayscale-12 shadow-3xs" : "opacity-70 hover:opacity-100"}`}
          >
            <!-- Costa Rica Minimalist Micro Flag -->
            <span
              class="cr-flag-container inline-flex items-center justify-center w-[14px] h-[9.5px] rounded-[1.5px] overflow-hidden border border-black/10 dark:border-white/15 shadow-2xs shrink-0 select-none"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 15 10"
                class="w-full h-full block"
                preserveAspectRatio="none"
              >
                <!-- Blue top stripe (1/6) -->
                <rect width="15" height="1.67" fill="#002B7F"></rect>
                <!-- White stripe (1/6) -->
                <rect y="1.67" width="15" height="1.67" fill="#FFFFFF"></rect>
                <!-- Red center stripe (2/6) -->
                <rect y="3.33" width="15" height="3.34" fill="#CE1126"></rect>
                <!-- White stripe (1/6) -->
                <rect y="6.67" width="15" height="1.67" fill="#FFFFFF"></rect>
                <!-- Blue bottom stripe (1/6) -->
                <rect y="8.33" width="15" height="1.67" fill="#002B7F"></rect>
              </svg>
              <!-- Soft satin sheen reflection -->
              <span class="cr-flag-sheen"></span>
            </span>
          </a>
        </div>

        <!-- Mobile Hamburger Button (asymmetric 2-line editorial toggle) -->
        <button
          id="mobile-menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu-drawer"
          aria-label={currentLocale === "es" ? "Abrir menú" : "Open menu"}
          data-cuelume-hover="tick"
          data-cuelume-press
          class="mobile-burger-btn sm:hidden relative inline-flex items-center justify-center w-8 h-8 ml-0.5 rounded-md text-grayscale-12 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-9 focus-visible:ring-offset-2"
        >
          <span class="burger-line burger-line--top" aria-hidden="true"></span>
          <span class="burger-line burger-line--bottom" aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </div>
</nav>

<!-- Mobile Menu Curtain Overlay (outside <nav> so backdrop-filter doesn't trap fixed positioning) -->
<div
  id="mobile-menu-drawer"
  transition:persist="mobile-menu-drawer"
  data-open="false"
  aria-hidden="true"
  class="mobile-menu-drawer sm:hidden fixed inset-0 z-40 bg-grayscale-1/[0.97] backdrop-blur-md flex flex-col justify-center px-6 overscroll-contain touch-none"
>
  <nav aria-label={currentLocale === "es" ? "Navegación móvil" : "Mobile navigation"} class="flex flex-col">
    <a
      id="mobile-nav-projects"
      href={`${localePrefix || ""}/projects`}
      data-astro-prefetch="viewport"
      data-mobile-nav-link
      data-cuelume-press="page"
      class="mobile-menu-item group flex items-baseline justify-between py-4 border-b border-grayscale-3/40 dark:border-grayscale-3/20"
      style="--item-i: 0;"
    >
      <span class="mobile-menu-label font-display text-3xl font-medium tracking-tight text-grayscale-12">{navLabels.projects}</span>
      <span class="mobile-menu-dot" aria-hidden="true"></span>
    </a>

    <a
      id="mobile-nav-blog"
      href={`${localePrefix || ""}/blog`}
      data-astro-prefetch="viewport"
      data-mobile-nav-link
      data-cuelume-press="page"
      class="mobile-menu-item group flex items-baseline justify-between py-4 border-b border-grayscale-3/40 dark:border-grayscale-3/20"
      style="--item-i: 1;"
    >
      <span class="mobile-menu-label font-display text-3xl font-medium tracking-tight text-grayscale-12">{navLabels.blog}</span>
      <span class="mobile-menu-dot" aria-hidden="true"></span>
    </a>

    <a
      id="mobile-nav-contact"
      href={`${localePrefix || ""}/contact`}
      data-astro-prefetch="viewport"
      data-mobile-nav-link
      data-cuelume-press="page"
      class="mobile-menu-item group flex items-baseline justify-between py-4 border-b border-grayscale-3/40 dark:border-grayscale-3/20"
      style="--item-i: 2;"
    >
      <span class="mobile-menu-label font-display text-3xl font-medium tracking-tight text-grayscale-12">{navLabels.contact}</span>
      <span class="mobile-menu-dot" aria-hidden="true"></span>
    </a>

    <a
      id="mobile-nav-agency"
      href="https://sorinlabs.dev"
      target="_blank"
      rel="noopener noreferrer"
      data-mobile-nav-link
      data-cuelume-press="scan"
      class="mobile-menu-item group flex items-baseline justify-between py-4"
      style="--item-i: 3;"
    >
      <span id="mobile-nav-agency-label" class="mobile-menu-label font-display text-3xl font-medium tracking-tight text-grayscale-12">{navLabels.agency}</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-grayscale-10 group-active:translate-x-0.5 group-active:-translate-y-0.5 transition-transform duration-200"
        aria-hidden="true"
      >
        <path d="M7 7h10v10"></path><path d="M7 17 17 7"></path>
      </svg>
    </a>
  </nav>
</div>

<script>
  const blogMapping: Record<string, string> = {
    "/blog/digitalizing-a-cultural-identity":
      "/es/blog/digitalizar-una-identidad-cultural",
    "/es/blog/digitalizar-una-identidad-cultural":
      "/blog/digitalizing-a-cultural-identity",
  };

  const navLabelsMap = {
    en: {
      home: "Home",
      projects: "Projects",
      blog: "Blog",
      contact: "Contact",
      agency: "Agency",
    },
    es: {
      home: "Inicio",
      projects: "Proyectos",
      blog: "Blog",
      contact: "Contacto",
      agency: "Agencia",
    },
  };

  const syncNavbarState = () => {
    const rawPath = window.location.pathname;
    const cleanPath = rawPath.replace(/\/$/, "");
    const isEs = cleanPath.startsWith("/es");
    const locale = isEs ? "es" : "en";
    const prefix = isEs ? "/es" : "";

    // 1. Update logo link
    const logoEl = document.getElementById("nav-brand-logo") as HTMLAnchorElement | null;
    if (logoEl) {
      logoEl.href = isEs ? "/es/" : "/";
      logoEl.setAttribute("aria-label", navLabelsMap[locale].home);
    }

    // 2. Update navigation links (href + active state + labels)
    const links = [
      { id: "nav-link-projects", mobileId: "mobile-nav-projects", pathSegment: "/projects", label: navLabelsMap[locale].projects },
      { id: "nav-link-blog", mobileId: "mobile-nav-blog", pathSegment: "/blog", label: navLabelsMap[locale].blog },
      { id: "nav-link-contact", mobileId: "mobile-nav-contact", pathSegment: "/contact", label: navLabelsMap[locale].contact },
    ];

    links.forEach(({ id, mobileId, pathSegment, label }) => {
      const isActive = cleanPath.includes(pathSegment);
      const el = document.getElementById(id) as HTMLAnchorElement | null;
      if (el) {
        el.href = `${prefix}${pathSegment}`;
        el.textContent = label;
        if (isActive) {
          el.classList.add("text-grayscale-12", "font-semibold");
          el.classList.remove("text-grayscale-11");
        } else {
          el.classList.remove("text-grayscale-12", "font-semibold");
          el.classList.add("text-grayscale-11");
        }
      }

      const mobileEl = document.getElementById(mobileId) as HTMLAnchorElement | null;
      if (mobileEl) {
        mobileEl.href = `${prefix}${pathSegment}`;
        const labelEl = mobileEl.querySelector(".mobile-menu-label");
        if (labelEl) labelEl.textContent = label;
        if (isActive) mobileEl.setAttribute("data-active", "true");
        else mobileEl.removeAttribute("data-active");
      }
    });

    // 3. Agency label
    const agencyText = document.getElementById("nav-text-agency");
    if (agencyText) {
      agencyText.textContent = navLabelsMap[locale].agency;
    }
    const mobileAgencyText = document.getElementById("mobile-nav-agency-label");
    if (mobileAgencyText) {
      mobileAgencyText.textContent = navLabelsMap[locale].agency;
    }

    // 4. Compute EN and ES target URLs for the language switcher
    let enTarget = "/";
    let esTarget = "/es/";

    const mapped = blogMapping[cleanPath];
    if (mapped) {
      if (isEs) {
        esTarget = cleanPath;
        enTarget = mapped;
      } else {
        enTarget = cleanPath;
        esTarget = mapped;
      }
    } else if (isEs) {
      const base = cleanPath.replace(/^\/es/, "");
      enTarget = base ? base : "/";
      esTarget = cleanPath;
    } else {
      enTarget = cleanPath ? cleanPath : "/";
      esTarget = cleanPath ? `/es${cleanPath}` : "/es/";
    }

    const enBtn = document.getElementById("lang-btn-en") as HTMLAnchorElement | null;
    const esBtn = document.getElementById("lang-btn-es") as HTMLAnchorElement | null;

    if (enBtn) {
      enBtn.href = enTarget;
      if (!isEs) {
        enBtn.className = "px-1.5 sm:px-2 py-0.5 rounded-md transition-[color,background-color,box-shadow] duration-150 bg-white dark:bg-grayscale-3 text-grayscale-12 font-bold shadow-3xs";
      } else {
        enBtn.className = "px-1.5 sm:px-2 py-0.5 rounded-md transition-[color,background-color,box-shadow] duration-150 hover:text-grayscale-12 text-grayscale-10";
      }
    }

    if (esBtn) {
      esBtn.href = esTarget;
      if (isEs) {
        esBtn.className = "cr-tico-btn px-1.5 sm:px-2 py-0.5 rounded-md transition-[opacity,background-color,box-shadow] duration-200 flex items-center justify-center bg-white dark:bg-grayscale-3 text-grayscale-12 shadow-3xs";
      } else {
        esBtn.className = "cr-tico-btn px-1.5 sm:px-2 py-0.5 rounded-md transition-[opacity,background-color,box-shadow] duration-200 flex items-center justify-center opacity-70 hover:opacity-100";
      }
    }
  };

  const initNavbarInteractions = () => {
    // 1. Theme Toggle Button
    const toggleBtn = document.getElementById("theme-toggle");
    if (toggleBtn && !(toggleBtn as any).__bound) {
      (toggleBtn as any).__bound = true;
      toggleBtn.onclick = (e) => {
        e.preventDefault();

        // Trigger fluid spring spin animation on the icon
        toggleBtn.classList.remove("animate-theme-spin");
        void toggleBtn.offsetWidth;
        toggleBtn.classList.add("animate-theme-spin");
        setTimeout(() => toggleBtn.classList.remove("animate-theme-spin"), 450);

        // Temporarily disable transitions for 100% instant theme switching across all elements
        document.documentElement.classList.add("disable-transitions");

        const isDark = document.documentElement.classList.contains("dark");
        const nextIsDark = !isDark;
        const nextColor = nextIsDark ? "#111113" : "#ffffff";

        document.documentElement.classList.toggle("dark", nextIsDark);
        document.documentElement.style.colorScheme = nextIsDark ? "dark" : "light";
        document.documentElement.style.backgroundColor = nextColor;
        localStorage.setItem("theme", nextIsDark ? "dark" : "light");

        // Force synchronous style recalculation flush
        window.getComputedStyle(document.documentElement).opacity;

        // Re-enable normal transitions after layout paint
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            document.documentElement.classList.remove("disable-transitions");
          });
        });
      };
    }

    // 2. Mobile Hamburger Menu (delegated + AbortController so HMR/persisted DOM always works)
    const setMenuOpen = (open: boolean) => {
      const burgerBtn = document.getElementById("mobile-menu-toggle");
      const drawer = document.getElementById("mobile-menu-drawer");
      if (!burgerBtn || !drawer) return;
      const isEs = window.location.pathname.replace(/\/$/, "").startsWith("/es");
      burgerBtn.setAttribute("aria-expanded", String(open));
      burgerBtn.setAttribute(
        "aria-label",
        open ? (isEs ? "Cerrar menú" : "Close menu") : (isEs ? "Abrir menú" : "Open menu")
      );
      drawer.setAttribute("data-open", String(open));
      drawer.setAttribute("aria-hidden", String(!open));
    };

    const prevMenuAbort = (window as any).__mobileMenuAbort as AbortController | undefined;
    prevMenuAbort?.abort();
    const menuController = new AbortController();
    (window as any).__mobileMenuAbort = menuController;
    const { signal } = menuController;

    document.addEventListener("click", (e) => {
      const target = e.target as Element | null;
      const toggle = target?.closest?.("#mobile-menu-toggle");
      if (toggle) {
        e.preventDefault();
        const drawer = document.getElementById("mobile-menu-drawer");
        const isOpen = drawer?.getAttribute("data-open") === "true";
        setMenuOpen(!isOpen);
        return;
      }
      if (target?.closest?.("[data-mobile-nav-link]")) {
        setMenuOpen(false);
      }
    }, { signal });

    document.addEventListener("keydown", (e) => {
      const drawer = document.getElementById("mobile-menu-drawer");
      if (e.key === "Escape" && drawer?.getAttribute("data-open") === "true") {
        setMenuOpen(false);
        document.getElementById("mobile-menu-toggle")?.focus();
      }
    }, { signal });

    window.matchMedia("(min-width: 640px)").addEventListener("change", (e) => {
      if (e.matches) setMenuOpen(false);
    }, { signal });

    document.addEventListener("astro:before-swap", () => setMenuOpen(false), { signal });

    // 3. Language Switch Scroll Preservation (Keep exact scroll position when toggling ES/EN)
    const langLinks = document.querySelectorAll("[data-lang-switch]");
    langLinks.forEach((link) => {
      if (!(link as any).__bound) {
        (link as any).__bound = true;
        link.addEventListener("click", () => {
          const scrollY = window.scrollY || document.documentElement.scrollTop || 0;
          sessionStorage.setItem("portfolio_lang_scroll", scrollY.toString());
        });
      }
    });
  };

  const restoreLangScroll = () => {
    const savedScroll = sessionStorage.getItem("portfolio_lang_scroll");
    if (savedScroll !== null) {
      const targetY = parseInt(savedScroll, 10);
      window.scrollTo({ top: targetY, behavior: "instant" });
      sessionStorage.removeItem("portfolio_lang_scroll");
    }
  };

  // Run on initial load
  initNavbarInteractions();
  syncNavbarState();
  restoreLangScroll();

  // Run on client router events
  document.addEventListener("astro:page-load", () => {
    initNavbarInteractions();
    syncNavbarState();
    restoreLangScroll();
  });

  document.addEventListener("astro:after-swap", () => {
    syncNavbarState();
  });

  document.addEventListener("astro:before-swap", (e: any) => {
    const savedScroll = sessionStorage.getItem("portfolio_lang_scroll");
    if (savedScroll !== null && e.newDocument) {
      e.newDocument.documentElement.scrollTop = parseInt(savedScroll, 10);
    }
  });
</script>

<style>
  /* Asymmetric 2-line editorial hamburger -> centered X morph */
  .burger-line {
