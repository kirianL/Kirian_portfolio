---
export interface PhotoStamp {
  id: number;
  src?: string;
  alt?: string;
  caption?: string;
}

export interface Props {
  arc?: number;
  spread?: number;
  yOffset?: number;
  duration?: number;
  className?: string;
  photos?: PhotoStamp[];
}

const {
  arc = 16,
  spread = 180,
  yOffset = 20,
  duration = 0.4,
  className = '',
  photos
} = Astro.props;

const defaultStamps: PhotoStamp[] = [
  { id: 0, caption: 'Kenzo', src: '/off-screen/Kenzo.png' },
  { id: 1, caption: 'Puerto Limón', src: '/off-screen/Limon.png' },
  { id: 2, caption: 'Off Screen' },
  { id: 3, caption: 'Costa Rica' },
  { id: 4, caption: 'Everyday Notes' }
];

const stampsList = photos && photos.length > 0 ? photos : defaultStamps;
const count = stampsList.length;
const centerIdx = (count - 1) / 2; // 2 for 5 photos

const stampConfigs = stampsList.map((stamp, i) => {
  const norm = centerIdx > 0 ? (i - centerIdx) / centerIdx : 0; // -1 to +1

  // Desktop fan positions
  const idleRotate = norm * 6;
  const idleX = norm * 36;
  const idleY = Math.abs(norm) * 4;

  const targetRotate = norm * arc;
  const targetX = norm * spread;
  const targetY = Math.abs(norm) * yOffset;

  // Mobile fan positions
  const mobileSpread = 90;
  const mobileRotate = norm * 10;
  const mobileX = norm * mobileSpread;
  const mobileY = Math.abs(norm) * 4;

  const dist = Math.abs(i - centerIdx);

  return {
    ...stamp,
    norm,
    idleRotate,
    idleX,
    idleY,
    targetRotate,
    targetX,
    targetY,
    mobileRotate,
    mobileX,
    mobileY,
    defaultZIndex: Math.round(10 - dist)
  };
});
---

<div
  class={`card-stamp-arc-root relative w-[6.4rem] h-[8.6rem] sm:w-[9.2rem] sm:h-[11.8rem] cursor-pointer flex items-center justify-center select-none touch-manipulation max-w-full overflow-visible ${className}`}
  data-count={count}
>
  {stampConfigs.map((stamp, i) => (
    <div
      class="stamp-card-item absolute inset-0 rounded-lg sm:rounded-xl p-1 pb-1.5 sm:p-1.5 sm:pb-2.5 flex flex-col bg-white text-zinc-800 border border-zinc-200/60 shadow-[0_4px_18px_rgba(0,0,0,0.06)] dark:bg-zinc-900 dark:text-zinc-100 dark:border-zinc-800/60 dark:shadow-[0_4px_22px_rgba(0,0,0,0.35)]"
      style={{
        zIndex: stamp.defaultZIndex,
        transformOrigin: '50% 100%',
        transitionDuration: `${duration}s`,
        '--idle-tr': `${stamp.idleRotate}deg`,
        '--idle-tx': `${stamp.idleX}px`,
        '--idle-ty': `${stamp.idleY}px`,
        '--desktop-tr': `${stamp.targetRotate}deg`,
        '--desktop-tx': `${stamp.targetX}px`,
        '--desktop-ty': `${stamp.targetY}px`,
        '--mobile-tr': `${stamp.mobileRotate}deg`,
        '--mobile-tx': `${stamp.mobileX}px`,
        '--mobile-ty': `${stamp.mobileY}px`,
        '--card-index': i
      }}
      data-card-index={i}
      data-card-id={stamp.id}
    >
      {/* BE UI Tooltip (@beui/tooltip) - Elevated Above Card Frame */}
      {stamp.caption && (
        <div class="stamp-tooltip absolute left-1/2 -top-9 sm:-top-10 pointer-events-none z-50 flex justify-center items-center w-max">
          <span class="block whitespace-nowrap rounded-lg border border-zinc-200/80 bg-white/95 px-2.5 py-1 text-[10px] sm:text-[11px] font-mono tracking-tight text-zinc-900 shadow-md dark:border-zinc-800 dark:bg-zinc-900/95 dark:text-zinc-100 backdrop-blur-md">
            {stamp.caption}
          </span>
        </div>
      )}

      {/* Photo Frame Container (Pixel-perfect clean Polaroid) */}
      <div class="relative w-full h-full rounded bg-zinc-100/90 dark:bg-zinc-800/60 overflow-hidden border border-zinc-200/30 dark:border-zinc-700/30 flex flex-col items-center justify-center pointer-events-none">
        {stamp.src ? (
          <img
            src={stamp.src}
            alt={stamp.alt || stamp.caption || `Photo ${stamp.id + 1}`}
            class="w-full h-full object-cover transition-opacity duration-300"
            loading="lazy"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
          />
        ) : null}
        
        {/* Minimalist Clean Photo Placeholder Canvas */}
        <div 
          class="w-full h-full flex flex-col items-center justify-center p-2 text-center bg-gradient-to-b from-zinc-50 to-zinc-100/80 dark:from-zinc-800/40 dark:to-zinc-800/80"
          style={{ display: stamp.src ? 'none' : 'flex' }}
        >
          <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-zinc-200/60 dark:bg-zinc-700/50 flex items-center justify-center mb-1">
            <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-zinc-400 dark:text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <span class="text-[9px] font-mono font-medium text-zinc-400 dark:text-zinc-500">
            0{stamp.id + 1}
          </span>
        </div>
      </div>
    </div>
  ))}
</div>

<style>
  .card-stamp-arc-root {
    perspective: 1000px;
  }

  .card-stamp-arc-root,
  .stamp-card-item {
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .stamp-card-item {
    backface-visibility: hidden;
    transform-style: preserve-3d;
    will-change: transform;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
                box-shadow 0.3s ease,
                opacity 0.3s ease;
  }

  /* Desktop Fan Arc (>= 640px) */
  @media (min-width: 640px) {
    .stamp-card-item {
      transform: translate3d(var(--idle-tx), var(--idle-ty), 0) rotate(var(--idle-tr));
    }

    .card-stamp-arc-root:hover .stamp-card-item,
    .card-stamp-arc-root.has-active-focus .stamp-card-item,
    .card-stamp-arc-root.is-active .stamp-card-item {
      transform: translate3d(var(--desktop-tx), var(--desktop-ty), 0) rotate(var(--desktop-tr));
    }

    .card-stamp-arc-root:hover .stamp-card-item:hover,
    .stamp-card-item.is-focused-card {
      transform: translate3d(var(--desktop-tx), calc(var(--desktop-ty) - 14px), 30px) rotate(0deg) scale(1.05) !important;
      box-shadow: 0 16px 32px -8px rgba(0, 0, 0, 0.14), 0 4px 12px rgba(0, 0, 0, 0.04) !important;
    }
  }

  /* Mobile Fan Arc (< 640px) */
  @media (max-width: 639px) {
    .stamp-card-item {
      transform: translate3d(var(--mobile-tx), var(--mobile-ty), 0) rotate(var(--mobile-tr));
    }

    .stamp-card-item.is-focused-card {
      transform: translate3d(var(--mobile-tx), calc(var(--mobile-ty) - 12px), 30px) rotate(0deg) scale(1.06) !important;
      box-shadow: 0 14px 28px -6px rgba(0, 0, 0, 0.16), 0 4px 10px rgba(0, 0, 0, 0.05) !important;
    }
  }

  /* BE UI Tooltip (@beui/tooltip): Blur enter/exit & spring spawn */
  .stamp-tooltip {
    opacity: 0;
    filter: blur(4px);
    transform: translate(-50%, 6px) scale(0.92);
    transition: opacity 0.18s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.18s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, filter, opacity;
  }

  @media (hover: hover) {
    .card-stamp-arc-root:hover .stamp-card-item:hover .stamp-tooltip {
      opacity: 1;
      filter: blur(0px);
      transform: translate(-50%, 0px) scale(1);
      transition-delay: 30ms;
    }
  }

  .stamp-card-item.is-focused-card .stamp-tooltip {
    opacity: 1;
    filter: blur(0px);
    transform: translate(-50%, 0px) scale(1);
    transition-delay: 30ms;
  }
</style>

<script>
  import { play } from "cuelume";

  const setupStampArc = () => {
    const roots = document.querySelectorAll('.card-stamp-arc-root');
    roots.forEach((root) => {
      const items = root.querySelectorAll('.stamp-card-item');

      let lockedIdx: number | null = null;
      let hoverIdx: number | null = null;
      let rafId: number | null = null;
      let leaveTimeout: ReturnType<typeof setTimeout> | null = null;
      let lastSoundTime = 0;

      const playSound = (type: "tick" | "toggle" | "chime") => {
        try {
          const now = Date.now();
          if (now - lastSoundTime > 65) {
            play(type);
            lastSoundTime = now;
          }
        } catch {
          // ignore audio context policy restrictions before first gesture
        }
      };

      const setFocusInternal = (targetIdx: number | null) => {
        const total = items.length;
        const centerIdx = (total - 1) / 2;

        if (targetIdx !== null) {
          root.classList.add('has-active-focus');
        } else {
          root.classList.remove('has-active-focus');
        }

        items.forEach((item, i) => {
          const cardEl = item as HTMLElement;
          if (i === targetIdx) {
            cardEl.classList.add('is-focused-card');
          } else {
            cardEl.classList.remove('is-focused-card');
          }

          if (targetIdx !== null) {
            const distFromFocused = Math.abs(i - targetIdx);
            const dynamicZIndex = 50 - distFromFocused * 5;
            cardEl.style.zIndex = `${dynamicZIndex}`;
          } else {
            const defaultZIndex = Math.round(10 - Math.abs(i - centerIdx));
            cardEl.style.zIndex = `${defaultZIndex}`;
          }
        });
      };

      const updateState = (newLocked: number | null, newHover: number | null) => {
        lockedIdx = newLocked;
        hoverIdx = newHover;
        const activeIdx = hoverIdx !== null ? hoverIdx : lockedIdx;

        if (leaveTimeout) {
          clearTimeout(leaveTimeout);
          leaveTimeout = null;
        }

        if (rafId !== null) {
          cancelAnimationFrame(rafId);
        }

        rafId = requestAnimationFrame(() => {
          setFocusInternal(activeIdx);
          rafId = null;
        });
      };

      items.forEach((item, i) => {
        item.addEventListener('click', (e) => {
          e.stopPropagation();
          const isCurrentlyLocked = lockedIdx === i;
          
          if (!isCurrentlyLocked) {
            updateState(i, hoverIdx);
            playSound("toggle");
          } else {
            updateState(null, hoverIdx);
            playSound("tick");
          }
        });

        item.addEventListener('mouseenter', () => {
          if (window.matchMedia('(hover: hover)').matches) {
            if (hoverIdx !== i) {
              updateState(lockedIdx, i);
              playSound("tick");
            }
          }
        });
      });

      root.addEventListener('mouseenter', () => {
        if (window.matchMedia('(hover: hover)').matches) {
          if (leaveTimeout) {
            clearTimeout(leaveTimeout);
            leaveTimeout = null;
          }
        }
      });

      root.addEventListener('mouseleave', () => {
        if (window.matchMedia('(hover: hover)').matches) {
          if (leaveTimeout) clearTimeout(leaveTimeout);
          leaveTimeout = setTimeout(() => {
            updateState(lockedIdx, null);
          }, 120);
        }
      });

      document.addEventListener('click', (e) => {
        if (!root.contains(e.target as Node)) {
          if (lockedIdx !== null) {
            playSound("tick");
          }
          updateState(null, null);
        }
      });
    });
  };

  setupStampArc();
  document.addEventListener('astro:after-swap', setupStampArc);
</script>
