---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
  lang?: "en" | "es";
}

const { headings = [], lang = "en" } = Astro.props;
const backToTopText = lang === "es" ? "↑ volver arriba" : "↑ back to top";
const tocLabel = lang === "es" ? "/ÍNDICE" : "/INDEX";

// Main chapters (h2) for an authoritative, clean editorial index
const tocHeadings = headings.filter((h) => h.depth === 2);
---

<nav id="blog-toc-nav" class="flex flex-col gap-3 select-none w-full" aria-label="Table of contents">
  <div class="text-[10px] font-mono uppercase tracking-widest text-grayscale-10 flex items-center justify-between pb-1">
    <div class="flex items-center gap-1.5">
      <span class="w-1.5 h-1.5 rounded-full bg-accent-9"></span>
      <span>{tocLabel}</span>
    </div>
    <span class="text-[9px] text-grayscale-10">{tocHeadings.length} SECTIONS</span>
  </div>

  {tocHeadings.length > 0 && (
    <div id="toc-list" class="border-s-2 border-grayscale-3 dark:border-grayscale-3/40 flex flex-col">
      {tocHeadings.map((h, index) => {
        const num = String(index + 1).padStart(2, "0");
        return (
          <a
            href={`#${h.slug}`}
            data-toc-target={h.slug}
            class="toc-item-link -ms-[2px] border-s-2 border-transparent ps-3 py-1.5 text-[11px] font-mono uppercase tracking-wider text-grayscale-10 hover:text-grayscale-12 hover:ps-3.5 transition-all leading-snug cursor-pointer flex items-baseline gap-1.5"
          >
            <span class="toc-item-num text-[10px] opacity-40 shrink-0">{num}.</span>
            <span class="toc-item-text truncate">{h.text}</span>
          </a>
        );
      })}
    </div>
  )}

  <!-- Back to Top Link -->
  <button
    id="toc-back-to-top"
    type="button"
    data-cuelume-hover="tick"
    class="text-[11px] font-mono text-grayscale-10 hover:text-accent-9 transition-colors cursor-pointer text-left w-fit flex items-center gap-1.5 group pt-1 mt-1"
  >
    <span class="group-hover:-translate-y-0.5 transition-transform duration-200">{backToTopText}</span>
  </button>
</nav>

<style is:global>
  .toc-item-link {
    transition: color 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                padding 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .toc-item-link.is-passed {
    opacity: 0.45;
  }

  .toc-item-link.is-passed:hover {
    opacity: 0.85;
  }

  /* Active / Currently reading state (Koyeb signature active border) */
  .toc-item-link.is-active {
    border-color: var(--color-accent-9, #eb5e28) !important;
    color: var(--color-grayscale-12, #ffffff) !important;
    font-weight: 600;
    opacity: 1;
    padding-inline-start: 1rem;
  }

  .toc-item-link.is-active .toc-item-num {
    color: var(--color-accent-9, #eb5e28);
    opacity: 1;
    font-weight: 700;
  }
</style>

<script>
  import { play } from "cuelume";

  let abortController: AbortController | null = null;

  const setupTOC = () => {
    if (abortController) {
      abortController.abort();
    }
    abortController = new AbortController();
    const { signal } = abortController;

    const backBtn = document.getElementById("toc-back-to-top");
    if (backBtn) {
      backBtn.onclick = (e) => {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: "smooth" });
      };
    }

    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".toc-item-link"));
    if (links.length === 0) return;

    let retries = 0;
    const maxRetries = 30;

    const findAndBind = () => {
      if (signal.aborted) return;

      const article = document.querySelector("article.prose") || document.querySelector("article");
      const articleHeadings = article ? Array.from(article.querySelectorAll<HTMLElement>("h2")) : [];

      const items: { el: HTMLElement; link: HTMLAnchorElement; passed: boolean }[] = [];

      links.forEach((link, idx) => {
        const slug = link.getAttribute("data-toc-target");
        let el = slug ? document.getElementById(slug) : null;
        if (!el && articleHeadings[idx]) {
          el = articleHeadings[idx];
          if (slug && !el.id) el.id = slug;
        }
        if (el) {
          items.push({ el, link, passed: false });
        }
      });

      if (items.length === 0 && retries < maxRetries) {
        retries++;
        requestAnimationFrame(findAndBind);
        return;
      }

      if (items.length === 0) return;

      // Smooth click handling
      links.forEach((link, idx) => {
        link.onclick = (e) => {
          e.preventDefault();
          const targetSlug = link.getAttribute("data-toc-target");
          const targetEl = (targetSlug ? document.getElementById(targetSlug) : null) || articleHeadings[idx];
          if (targetEl) {
            const y = targetEl.getBoundingClientRect().top + window.scrollY - 90;
            window.scrollTo({ top: y, behavior: "smooth" });
          }
        };
      });

      let lastTick = 0;
      let ticking = false;

      const checkScroll = () => {
        if (signal.aborted) return;
        const scrollY = window.scrollY;
        const triggerY = 120; // 120px threshold from top of viewport
        const docHeight = document.documentElement.scrollHeight;
        const isAtBottom = scrollY + window.innerHeight >= docHeight - 40;
        const now = Date.now();

        items.forEach((item, i) => {
          const rect = item.el.getBoundingClientRect();
          const next = items[i + 1];
          const nextRect = next ? next.el.getBoundingClientRect() : null;

          if (isAtBottom) {
            if (i === items.length - 1) {
              item.link.classList.remove("is-passed");
              item.link.classList.add("is-active");
              item.passed = false;
            } else {
              item.link.classList.add("is-passed");
              item.link.classList.remove("is-active");
              item.passed = true;
            }
          } else if (nextRect && nextRect.top <= triggerY) {
            item.link.classList.add("is-passed");
            item.link.classList.remove("is-active");
            if (!item.passed) {
              item.passed = true;
              if (now - lastTick > 150) {
                lastTick = now;
                try { play("tick"); } catch {}
              }
            }
          } else if (rect.top <= triggerY) {
            item.link.classList.remove("is-passed");
            item.link.classList.add("is-active");
            item.passed = false;
          } else {
            item.link.classList.remove("is-passed", "is-active");
            item.passed = false;
          }
        });
      };

      const onScroll = () => {
        if (!ticking && !signal.aborted) {
          window.requestAnimationFrame(() => {
            checkScroll();
            ticking = false;
          });
          ticking = true;
        }
      };

      window.addEventListener("scroll", onScroll, { passive: true, signal });
      window.addEventListener("resize", onScroll, { passive: true, signal });

      checkScroll();
    };

    findAndBind();
  };

  setupTOC();
  document.addEventListener("astro:page-load", setupTOC);
  document.addEventListener("astro:after-swap", setupTOC);
</script>
