---
interface Props {
  title: string;
  badge: string;
  link?: string;
}

const { title, badge, link } = Astro.props;
const Element = link ? 'a' : 'div';
---

<Element
  href={link}
  target={link ? "_blank" : undefined}
  rel={link ? "noopener noreferrer" : undefined}
  class="resource-row flex items-center w-full justify-between py-2 px-3 -mx-3 rounded-lg transition-all duration-150 group"
>
  <span class="text-primary-text text-sm font-normal group-hover:text-primary transition-colors duration-150 truncate max-w-[75%]">
    {title}
  </span>
  <span 
    class="inline-flex items-center justify-center rounded-full bg-primary text-primary-foreground font-medium text-[11px] px-2.5 py-0.5 leading-none shrink-0"
  >
    {badge}
  </span>
</Element>
