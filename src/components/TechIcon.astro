---
import iconMap from "../data/tech-icon-map.json";

interface Props {
  name: string;
  class?: string;
}

const { name, class: className = "w-4 h-4" } = Astro.props;

// Normalize name to match JSON keys
const key = name.toLowerCase().trim().replace(/[\s\.\-\/]/g, "");

// Check if we have the icon in the map
const iconData = (iconMap as any)[key];
---

<span class="tech-icon inline-flex items-center justify-center leading-none">
{
  iconData ? (
    iconData.type === "single" ? (
      <img
        src={iconData.src}
        alt=""
        class={`${className} object-contain`}
        loading="lazy"
        decoding="async"
        width="20"
        height="20"
      />
    ) : (
      <>
        <img
          src={iconData.light}
          alt=""
          class={`${className} object-contain dark:hidden`}
          loading="lazy"
          decoding="async"
          width="20"
          height="20"
        />
        <img
          src={iconData.dark}
          alt=""
          class={`${className} object-contain hidden dark:inline-block`}
          loading="lazy"
          decoding="async"
          width="20"
          height="20"
        />
      </>
    )
  ) : (
    <span class={`${className} rounded bg-grayscale-3 dark:bg-grayscale-3/40 border border-grayscale-4/30 inline-block shrink-0`}></span>
  )
}
</span>

<style is:global>
  .tech-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .tech-icon img {
    max-width: 100%;
    max-height: 100%;
  }
</style>
