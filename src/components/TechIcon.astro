---
import svglIcons from "../data/svgl-icons.json";

interface Props {
  name: string;
  class?: string;
}

const { name, class: className = "w-4 h-4" } = Astro.props;

// Normalize name to match JSON keys
const key = name.toLowerCase().trim().replace(/[\s\.\-\/]/g, "");

// Check if we have the icon in the cache
const iconData = (svglIcons as any)[key];

// Helper function to dynamically inject sizing class into SVG
const injectClass = (svgCode: string, cls: string) => {
  if (!svgCode) return "";
  if (svgCode.includes('class="')) {
    return svgCode.replace('class="', `class="${cls} `);
  }
  return svgCode.replace('<svg', `<svg class="${cls}"`);
};
---

<span class="tech-icon inline-flex items-center justify-center leading-none">
{
  iconData ? (
    iconData.single ? (
      <Fragment set:html={injectClass(iconData.single, className)} />
    ) : (
      <>
        <span class="dark:hidden inline-flex items-center justify-center">
          <Fragment set:html={injectClass(iconData.light, className)} />
        </span>
        <span class="hidden dark:inline-flex items-center justify-center">
          <Fragment set:html={injectClass(iconData.dark, className)} />
        </span>
      </>
    )
  ) : (
    <span class={`${className} rounded bg-grayscale-3 dark:bg-grayscale-3/40 border border-grayscale-4/30 inline-block shrink-0`}></span>
  )
}
</span>

<style is:global>
  .tech-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .tech-icon svg {
    max-width: 100%;
    max-height: 100%;
  }
</style>
