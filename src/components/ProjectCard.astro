---
import { Image } from 'astro:assets';

interface Props {
  name: string;
  description: string;
  link: string;
  image: ImageMetadata | string;
}

const { name, description, link, image } = Astro.props;
---

<a 
  href={link} 
  target="_blank" 
  rel="noopener noreferrer" 
  class="group project-card flex items-center gap-4 p-2 rounded-xl bg-card-surface border border-border"
>
  <div class="flex items-center justify-center w-14 h-14 rounded-2xl bg-muted-secondary shrink-0 overflow-hidden border border-border/50">
    {typeof image === 'string' ? (
      <img src={image} alt={name} class="w-full h-full object-cover" />
    ) : (
      <Image src={image} alt={name} class="w-full h-full object-cover" width={112} height={112} format="webp" />
    )}
  </div>
  <div class="flex flex-col min-w-0 flex-1">
    <h3 class="text-primary-text font-medium text-sm leading-tight group-hover:text-primary transition-colors">
      {name}
    </h3>
    <p class="text-muted-text text-sm leading-tight mt-0.5">
      {description}
    </p>
  </div>
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    width="24" 
    height="24" 
    viewBox="0 0 24 24" 
    fill="none" 
    stroke="currentColor" 
    stroke-width="2" 
    stroke-linecap="round" 
    stroke-linejoin="round" 
    class="w-4 h-4 text-muted-text shrink-0 group-hover:text-primary-text group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-200"
  >
    <path d="M7 7h10v10"></path>
    <path d="M7 17 17 7"></path>
  </svg>
</a>
