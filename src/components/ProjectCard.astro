---
import { Image } from 'astro:assets';

interface Props {
  name: string;
  description: string;
  link: string;
  image: ImageMetadata | string;
}

const { name, description, link, image } = Astro.props;
---

<a 
  href={link} 
  target="_blank" 
  rel="noopener noreferrer" 
  class="group project-card flex items-center gap-4 p-2.5 rounded-xl bg-white dark:bg-grayscale-2 border border-grayscale-3 dark:border-grayscale-3/40 hover:border-grayscale-4 dark:hover:border-grayscale-4/60 transition-all duration-200 shadow-xs"
>
  <div class="flex items-center justify-center w-14 h-14 rounded-lg bg-grayscale-2 shrink-0 overflow-hidden border border-grayscale-3 dark:border-grayscale-3/60">
    {typeof image === 'string' ? (
      <img src={image} alt={name} class="w-full h-full object-cover" />
    ) : (
      <Image src={image} alt={name} class="w-full h-full object-cover" width={112} height={112} format="webp" />
    )}
  </div>
  <div class="flex flex-col min-w-0 flex-1">
    <h3 class="text-grayscale-12 font-medium text-sm leading-tight group-hover:text-accent-9 transition-colors">
      {name}
    </h3>
    <p class="text-grayscale-11 text-xs leading-normal mt-1">
      {description}
    </p>
  </div>
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    width="24" 
    height="24" 
    viewBox="0 0 24 24" 
    fill="none" 
    stroke="currentColor" 
    stroke-width="2" 
    stroke-linecap="round" 
    stroke-linejoin="round" 
    class="w-3.5 h-3.5 text-grayscale-10 shrink-0 group-hover:text-grayscale-12 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-200"
  >
    <path d="M7 7h10v10"></path>
    <path d="M7 17 17 7"></path>
  </svg>
</a>
