---
interface Props {
  src: string;
  alt: string;
}

const { src, alt } = Astro.props;
---

<div class="relative w-15 h-15 sm:w-16 sm:h-16 shrink-0 select-none overflow-hidden rounded-xl">
  <img 
    src={src} 
    alt={alt}
    class="w-full h-full object-cover"
    loading="eager"
  />
</div>

