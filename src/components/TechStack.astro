---
import TechIcon from "./TechIcon.astro";
import { dictionaries } from "../data/data";

const currentLocale = Astro.currentLocale === "es" ? "ES" : "EN";
const data = dictionaries[currentLocale];

const categories = [
  {
    id: "languages",
    num: "01",
    name: currentLocale === "ES" ? "Lenguajes" : "Languages",
  },
  {
    id: "design",
    num: "02",
    name: currentLocale === "ES" ? "Diseño" : "Design",
  },
  {
    id: "frontend",
    num: "03",
    name: currentLocale === "ES" ? "Frontend" : "Frontend",
  },
  {
    id: "backend",
    num: "04",
    name: currentLocale === "ES" ? "Backend & DB" : "Backend & DB",
  },
];

const skills = data.skills.list || [];
---

<section id="habilidades" class="w-full">
  <div
    id="tech-stack-container"
    class="tech-stack-section flex flex-col w-full view-list"
  >
    <!-- Header Row -->
    <div class="flex items-center justify-between w-full mb-5">
      <h2
        class="font-figgle text-3xl text-grayscale-12 tracking-tight select-none"
      >
        {currentLocale === "ES" ? "tecnologías." : "stack."}
      </h2>

      <!-- View Switcher — smooth pill toggle, quiet & bordered -->
      <div
        class="stack-switcher relative flex items-center bg-grayscale-2 dark:bg-grayscale-2/60 border border-grayscale-3 dark:border-grayscale-3/40 rounded-full p-[2px] select-none"
        role="tablist"
        aria-label={currentLocale === "ES" ? "Cambiar vista de tecnologías" : "Switch tech stack view"}
      >
        <!-- Sliding white indicator -->
        <div
          id="stack-indicator"
          class="absolute top-[2px] left-[2px] h-[calc(100%-4px)] w-[calc(50%-2px)] bg-white dark:bg-grayscale-4 rounded-full border border-grayscale-3/50 dark:border-grayscale-4 shadow-3xs transition-transform duration-300 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] will-change-transform"
        >
        </div>

        <button
          id="list-view-btn"
          type="button"
          role="tab"
          aria-selected="true"
          tabindex="0"
          aria-label={currentLocale === "ES" ? "Vista de lista" : "List view"}
          data-cuelume-toggle
          class="relative z-10 w-8 h-7 rounded-full flex items-center justify-center cursor-pointer text-grayscale-12"
          title={currentLocale === "ES" ? "Vista de lista" : "List view"}
        >
          <svg
            class="w-[13px] h-[13px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <button
          id="grid-view-btn"
          type="button"
          role="tab"
          aria-selected="false"
          tabindex="-1"
          aria-label={currentLocale === "ES" ? "Vista de cuadrícula" : "Grid view"}
          data-cuelume-toggle
          class="relative z-10 w-8 h-7 rounded-full flex items-center justify-center cursor-pointer text-grayscale-10"
          title={currentLocale === "ES" ? "Vista de cuadrícula" : "Grid view"}
        >
          <svg
            class="w-[13px] h-[13px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
            <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
            <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
            <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
          </svg>
        </button>
      </div>
    </div>

    <!-- Categories -->
    <div class="flex flex-col">
      {
        categories.map((cat, idx) => {
          const catSkills = skills.filter(
            (s) => s.category.toLowerCase() === cat.id,
          );
          if (catSkills.length === 0) return null;
          const isLast = idx === categories.length - 1;

          return (
            <div class="stack-category-row">
              <div
                class:list={[
                  "stack-row-inner py-5 gap-x-8 items-center border-t border-grayscale-3 dark:border-grayscale-3/30",
                  isLast &&
                    "border-b border-grayscale-3 dark:border-grayscale-3/30",
                ]}
              >
                <div class="stack-cat-header flex items-center gap-2 select-none">
                  <span class="text-grayscale-11 dark:text-grayscale-11 font-mono text-[11px] leading-none font-medium">
                    {cat.num}
                  </span>
                  <span class="text-grayscale-11 dark:text-grayscale-11 text-[13px] leading-none font-normal">
                    {cat.name}
                  </span>
                </div>
                <div class="stack-items-wrap flex flex-wrap items-center">
                  {catSkills.map((skill) => (
                    <div class="tech-item group/griditem">
                      <TechIcon
                        name={skill.name}
                        class="tech-icon-svg shrink-0"
                      />
                      <span class="tech-label text-[12.5px] font-medium leading-none tracking-tight">
                        {skill.name}
                      </span>
                      <div class="tech-grid-tooltip">
                        {skill.name}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style is:global>
  .tech-stack-section.view-list .stack-row-inner {
    display: block;
  }
  @media (min-width: 640px) {
    .tech-stack-section.view-list .stack-row-inner {
      display: grid;
      grid-template-columns: 10.5rem 1fr;
    }
  }
  .tech-stack-section.view-list .stack-cat-header {
    margin-bottom: 0.75rem;
  }
  @media (min-width: 640px) {
    .tech-stack-section.view-list .stack-cat-header {
      margin-bottom: 0;
    }
  }
  .tech-stack-section.view-list .stack-items-wrap {
    gap: 0.625rem;
  }
  .tech-stack-section.view-list .tech-item {
    padding: 0.375rem 0.75rem;
    border-radius: 9999px;
    background-color: var(--color-grayscale-2, #f4f4f5);
    border: 1px solid var(--color-grayscale-3, #e4e4e7);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: default;
    user-select: none;
    color: var(--color-grayscale-12, #09090b);
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.03);
  }
  :global(.dark) .tech-stack-section.view-list .tech-item {
    background-color: rgba(24, 24, 27, 0.4);
    border-color: rgba(39, 39, 42, 0.5);
  }
  .tech-stack-section.view-list .tech-item:hover {
    background-color: var(--color-grayscale-3, #e4e4e7);
  }
  :global(.dark) .tech-stack-section.view-list .tech-item:hover {
    background-color: rgba(39, 39, 42, 0.7);
  }
  .tech-stack-section.view-list .tech-icon-svg {
    width: 14px;
    height: 14px;
  }
  .tech-stack-section.view-list .tech-grid-tooltip {
    display: none;
  }

  .tech-stack-section.view-grid .stack-row-inner {
    display: block;
  }
  .tech-stack-section.view-grid .stack-cat-header {
    margin-bottom: 1rem;
  }
  .tech-stack-section.view-grid .stack-items-wrap {
    gap: 0.75rem;
  }
  .tech-stack-section.view-grid .tech-label {
    display: none;
  }
  .tech-stack-section.view-grid .tech-icon-svg {
    width: 1.25rem;
    height: 1.25rem;
    transition: transform 0.2s ease;
  }
  .tech-stack-section.view-grid .tech-item:hover .tech-icon-svg {
    transform: scale(1.1);
  }
  .tech-stack-section.view-grid .tech-item {
    position: relative;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.75rem;
    border: 1px solid var(--color-grayscale-3, #e4e4e7);
    background-color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: default;
    user-select: none;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.03);
  }
  :global(.dark) .tech-stack-section.view-grid .tech-item {
    background-color: rgba(24, 24, 27, 0.6);
    border-color: rgba(39, 39, 42, 0.4);
  }
  .tech-stack-section.view-grid .tech-item:hover {
    border-color: var(--color-grayscale-4, #d4d4d8);
  }
  :global(.dark) .tech-stack-section.view-grid .tech-item:hover {
    border-color: rgba(63, 63, 70, 0.6);
  }

  .tech-grid-tooltip {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-bottom: 0.625rem;
    padding: 0.25rem 0.625rem;
    font-size: 10px;
    font-family: monospace;
    letter-spacing: -0.025em;
    background-color: var(--color-grayscale-12, #09090b);
    color: var(--color-grayscale-1, #fafafa);
    border: 1px solid var(--color-grayscale-3, #27272a);
    border-radius: 0.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s cubic-bezier(0, 0, 0.2, 1), transform 0.2s cubic-bezier(0, 0, 0.2, 1);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2);
    z-index: 50;
    white-space: nowrap;
  }
  .group\/griditem:hover .tech-grid-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(-2px);
  }
  .tech-grid-tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: var(--color-grayscale-12, #09090b);
  }

  /* Smooth opacity transitions for hover focus effect */
  .tech-item {
    transition:
      opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.2s cubic-bezier(0.4, 0, 0.2, 1),
      background-color 0.2s ease,
      border-color 0.2s ease;
    will-change: opacity, transform;
  }

  /* Fade out other items only when an active item is hovered */
  .stack-items-wrap:hover .tech-item:not(:hover) {
    opacity: 0.45;
  }

  .tech-item:hover {
    opacity: 1 !important;
    transform: translateY(-1px);
  }
</style>

<script>
  const setupToggle = () => {
    const listBtn = document.getElementById("list-view-btn");
    const gridBtn = document.getElementById("grid-view-btn");
    const container = document.getElementById("tech-stack-container");
    const indicator = document.getElementById("stack-indicator");

    if (!listBtn || !gridBtn || !container || !indicator) return;

    const setView = (view: "list" | "grid") => {
      container.classList.toggle("view-list", view === "list");
      container.classList.toggle("view-grid", view === "grid");

      // Slide indicator smoothly
      if (view === "list") {
        indicator.style.transform = "translateX(0)";
      } else {
        indicator.style.transform = `translateX(${listBtn.offsetWidth}px)`;
      }

      // Grayscale colors for active / inactive state using classes instead of inline style transitions
      listBtn.classList.toggle("text-grayscale-12", view === "list");
      listBtn.classList.toggle("text-grayscale-10", view !== "list");
      gridBtn.classList.toggle("text-grayscale-12", view === "grid");
      gridBtn.classList.toggle("text-grayscale-10", view !== "grid");

      // ARIA
      listBtn.setAttribute("aria-selected", String(view === "list"));
      gridBtn.setAttribute("aria-selected", String(view === "grid"));
      listBtn.setAttribute("tabindex", view === "list" ? "0" : "-1");
      gridBtn.setAttribute("tabindex", view === "grid" ? "0" : "-1");

      localStorage.setItem("tech-stack-view", view);
    };

    const savedView =
      (localStorage.getItem("tech-stack-view") as "list" | "grid") || "list";
    setView(savedView);

    // Add smooth transition only after user interaction
    const enableTransitions = () => {
      listBtn.classList.add("transition-colors", "duration-200");
      gridBtn.classList.add("transition-colors", "duration-200");
    };

    listBtn.addEventListener("click", () => {
      enableTransitions();
      setView("list");
    });
    gridBtn.addEventListener("click", () => {
      enableTransitions();
      setView("grid");
    });
    [listBtn, gridBtn].forEach((btn, index, arr) => {
      btn.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight" || e.key === "ArrowLeft") {
          e.preventDefault();
          const nextBtn = arr[(index + 1) % arr.length];
          enableTransitions();
          setView(nextBtn === listBtn ? "list" : "grid");
          nextBtn.focus();
        }
      });
    });
  };

  setupToggle();
  document.addEventListener("astro:after-swap", setupToggle);
</script>
